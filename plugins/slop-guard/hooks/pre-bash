#!/usr/bin/env bash
# hooks/pre-bash — policy-based gate for bash commands.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
[ -n "${GROK_PLUGIN_ROOT:-}" ] && : "${CLAUDE_PLUGIN_ROOT:=$GROK_PLUGIN_ROOT}"
: "${CLAUDE_PLUGIN_ROOT:=$PLUGIN_ROOT}"
# shellcheck source=../lib/hook.sh
. "${PLUGIN_ROOT}/lib/hook.sh"
# shellcheck source=../lib/shellsplit.sh
. "${PLUGIN_ROOT}/lib/shellsplit.sh"
# shellcheck source=../lib/typosquat.sh
. "${PLUGIN_ROOT}/lib/typosquat.sh"

hook_input
command="$(hook_field .tool_input.command)"
[ -n "$command" ] || exit 0

POLICY_FILE="${PLUGIN_ROOT}/rules/policies/bash.yaml"
PARSER="${PLUGIN_ROOT}/rules/policies/generate_policy.sh"
# The generated text contains only single-quoted strings from the repository-owned policy.
eval "$("$PARSER" "$POLICY_FILE")"

# Wrapper executables that only prefix another command: the policy must judge
# what they run, not the wrapper. `curl … | sudo sh` fed the sink just as
# directly as `curl … | sh`.
_WRAPPER_COMMANDS='sudo|doas|nohup|command|exec|time|xargs|stdbuf|setsid'

_normalize_component() {
    local text="$1" index=0 executable
    local -a words
    read -r -a words <<< "$text"
    [ "${#words[@]}" -gt 0 ] || { printf '%s' "$text"; return; }

    if [ "${words[0]##*/}" = "env" ]; then
        index=1
        while [ "$index" -lt "${#words[@]}" ]; do
            case "${words[$index]}" in -*|[A-Za-z_][A-Za-z0-9_]*=*) index=$((index + 1)) ;; *) break ;; esac
        done
    else
        while [ "$index" -lt "${#words[@]}" ]; do
            case "${words[$index]}" in [A-Za-z_][A-Za-z0-9_]*=*) index=$((index + 1)) ;; *) break ;; esac
        done
    fi
    [ "$index" -lt "${#words[@]}" ] || { printf '%s' "$text"; return; }
    # Step over wrapper executables and their flags until a real command shows up.
    while [ "$index" -lt "${#words[@]}" ] \
        && [[ "${words[$index]##*/}" =~ ^(${_WRAPPER_COMMANDS})$ ]]; do
        index=$((index + 1))
        while [ "$index" -lt "${#words[@]}" ]; do
            case "${words[$index]}" in -*|[A-Za-z_][A-Za-z0-9_]*=*) index=$((index + 1)) ;; *) break ;; esac
        done
    done
    [ "$index" -lt "${#words[@]}" ] || { printf '%s' "$text"; return; }
    executable="${words[$index]##*/}"
    words[$index]="$executable"
    words=("${words[@]:$index}")
    printf '%s' "${words[*]}"
}

_DOWNLOADER_RE='^[[:space:]]*(curl|wget)([[:space:]]|$)'
_INTERPRETER_RE='^[[:space:]]*(sh|bash|zsh|dash|ksh|python[0-9.]*|perl|ruby|node)([[:space:]]|$)'

# Substitution feeding an interpreter — `bash <(curl …)`, `sh -c "$(curl …)"`.
# shellsplit reports the substitution as its own component, so the pipeline
# relation below never sees it; match the raw command instead, requiring the
# interpreter to introduce the substitution so an unrelated `$(curl …)`
# assignment elsewhere in the command is not swept up.
if [[ "$command" =~ (^|[^-[:alnum:]_/])(sh|bash|zsh|dash|ksh|python[0-9.]*|perl|ruby|node)[[:space:]]+(-[^[:space:]]+[[:space:]]+)*[\"\']?[\$\<]\([[:space:]]*(curl|wget)([[:space:]]|$) ]]; then
    hook_deny "Remote script execution. Download, verify checksum, then run explicitly."
    exit 0
fi

components=()
while IFS= read -r component; do
    components[${#components[@]}]="$component"
done < <(shellsplit "$command")
decision=""
reason=""
operator=""
# Set while the current pipeline started with a downloader; any later stage that
# is an interpreter is then fed remote bytes, however many filters sit between
# them (`curl … | tee /tmp/i | sh`).
piped_from_download=0

for component in "${components[@]}"; do
    case "$component" in
        '&&'|'||'|';'|'('|')') operator="$component"; continue ;;
        '|') operator='|'; continue ;;
    esac

    normalized_component="$(_normalize_component "$component")"

    if [ "$operator" = '|' ]; then
        if [ "$piped_from_download" -eq 1 ] \
            && [[ "$normalized_component" =~ $_INTERPRETER_RE ]]; then
            hook_deny "Remote script execution. Download, verify checksum, then run explicitly."
            exit 0
        fi
    else
        # A non-pipe operator ends the pipeline, so the relation resets.
        piped_from_download=0
    fi
    if [[ "$normalized_component" =~ $_DOWNLOADER_RE ]]; then
        piped_from_download=1
    fi

    allowed=0
    for pattern in "${ALLOW_PATTERNS[@]}"; do
        if [[ "$normalized_component" =~ $pattern ]]; then
            allowed=1
            break
        fi
    done

    # Denies always outrank allows; an otherwise-safe install may still carry a
    # forbidden flag such as --ignore-scripts=false.
    for pattern in "${DENY_PATTERNS[@]}"; do
        if [[ "$normalized_component" =~ $pattern ]]; then
            hook_deny "Command component violates security policy: $component"
            exit 0
        fi
    done
    if [ "$allowed" -eq 0 ] && [ -z "$decision" ]; then
        for pattern in "${ASK_PATTERNS[@]}"; do
            if [[ "$normalized_component" =~ $pattern ]]; then
                decision="ask"
                reason="Action requires confirmation: $component$(typosquat_hint "$normalized_component")"
                break
            fi
        done
    fi

    operator=""
done

if [ "$decision" = "ask" ]; then
    hook_ask "$reason"
fi

exit 0
