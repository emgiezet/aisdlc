#!/usr/bin/env bash
# pre-write — gate for Write / Edit / MultiEdit / NotebookEdit tool calls.
set -uo pipefail

# ... [Preamble and input parsing as in previous version] ...
HOOKS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PLUGIN_ROOT="$(cd "${HOOKS_DIR}/.." && pwd)"
. "${PLUGIN_ROOT}/lib/hook.sh"
. "${PLUGIN_ROOT}/lib/state.sh"

hook_input
tool_name="$(hook_field .tool_name)"
file_path="$(hook_field .tool_input.file_path)"
[ -n "$file_path" ] || exit 0

# Extract content
case "$tool_name" in
    Write) new_content="$(hook_field .tool_input.content)"; old_content="$(cat "$file_path" 2>/dev/null || true)" ;;
    Edit|NotebookEdit) new_content="$(hook_field .tool_input.new_string)"; old_content="$(hook_field .tool_input.old_string)" ;;
    *) exit 0 ;;
esac

# 1. Secret Scanning
# ... (as before) ...

# 2. Suppression detection: dynamically load from suppressions.yaml
# We'll use python to parse the yaml and then loop in bash.
SUPPRESSIONS_YAML="${PLUGIN_ROOT}/rules/policies/suppressions.yaml"
# Simplified: use a Python script to iterate through suppressions
# and check if marker and reason are on the same line in new_content.
python3 -c "
import yaml, re, sys
with open('$SUPPRESSIONS_YAML') as f:
    data = yaml.safe_load(f)

new_content = sys.argv[1]
for lang, config in data['suppressions'].items():
    patterns = config['patterns']
    reason_regex = config['reason_grep_E']
    for line in new_content.splitlines():
        for pat in patterns:
            if pat in line and not re.search(reason_regex, line):
                print(f'Suppression {pat} missing reason on same line')
                sys.exit(1)
" "$new_content" || {
    hook_deny "Suppression comment requires a justification (reason: <≥10 chars) on the same line."
    exit 0
}

# 3. Protected files & 4. Test-skip markers
# ... (as before) ...
exit 0
