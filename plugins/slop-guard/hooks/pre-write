#!/usr/bin/env bash
# pre-write — gate for Write / Edit / MultiEdit / NotebookEdit tool calls.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
. "${PLUGIN_ROOT}/lib/hook.sh"
. "${PLUGIN_ROOT}/lib/state.sh"

hook_input
tool_name="$(hook_field .tool_name)"
file_path="$(hook_field .tool_input.file_path)"
[ -n "$file_path" ] || exit 0

case "$tool_name" in
    Write) new_content="$(hook_field .tool_input.content)"; old_content="$(cat "$file_path" 2>/dev/null || true)" ;;
    Edit|NotebookEdit) new_content="$(hook_field .tool_input.new_string)"; old_content="$(hook_field .tool_input.old_string)" ;;
    *) exit 0 ;;
esac

# 1. Secret Scanning (betterleaks/gitleaks)
# Simplified implementation: just check for a secret pattern
if printf '%s' "$new_content" | grep -qE '-----BEGIN (RSA|OPENSSH|EC) PRIVATE KEY-----'; then
    hook_deny "Secret detected. Never embed credentials in source files."
    exit 0
fi

# 2. Suppression detection: just check for patterns from write.yaml
if printf '%s' "$new_content" | grep -qE '(@phpstan-ignore|//nolint|# noqa|eslint-disable|checkov:skip=)'; then
    if ! printf '%s' "$new_content" | grep -qE 'reason:[[:space:]]*.{10,}'; then
        hook_deny "Suppression comment requires a justification (reason: <≥10 chars)."
        exit 0
    fi
fi

# 3. Protected files: just check a few
if [[ "$file_path" =~ (phpstan\.neon|eslint\.config\.js) ]]; then
    hook_ask "Lowering quality gates must be reviewed by a human."
    exit 0
fi

# 4. Test-skip markers
if printf '%s' "$new_content" | grep -qE '(markTestSkipped|t.Skip|it.skip)'; then
    hook_ask "Adding test-skip marker requires confirmation."
    exit 0
fi

exit 0
