#!/usr/bin/env bash
# pre-write — gate for Write / Edit / MultiEdit / NotebookEdit tool calls.
#
# Policy (§7.2, rules/policies/write.yaml):
#   A. Secrets in new content     → deny  (§6.10 betterleaks/gitleaks, fail-open)
#   B. Added suppression comments → deny if no reason; ask if blocker rule (§7.2B)
#   C. Protected file writes      → ask   (§7.2C)
#   D. Added test-skip markers    → ask   (§7.2D)
#   E. First edit of a language   → additionalContext with blocker list (§8.8)
#
# Input:  JSON on stdin (PreToolUse hook contract, §3.2)
# Output: structured JSON decision on stdout (exit 0) or nothing (allow, exit 0)
# Requires: jq
set -uo pipefail

HOOKS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PLUGIN_ROOT="$(cd "${HOOKS_DIR}/.." && pwd)"
: "${CLAUDE_PLUGIN_ROOT:=$PLUGIN_ROOT}"
: "${CLAUDE_PLUGIN_DATA:=${XDG_DATA_HOME:-$HOME/.local/share}/claude/plugins/slop-guard}"

# shellcheck source=../lib/hook.sh
. "${CLAUDE_PLUGIN_ROOT}/lib/hook.sh"
# shellcheck source=../lib/state.sh
. "${CLAUDE_PLUGIN_ROOT}/lib/state.sh"

# ── Read stdin exactly once ──────────────────────────────────────────────────
hook_input

tool_name="$(hook_field .tool_name)"
file_path="$(hook_field .tool_input.file_path)"
session_id="$(hook_field .session_id)"
agent_id="$(hook_field .agent_id)"

# No file_path — pass through (should not happen for Write/Edit).
[ -n "$file_path" ] || exit 0

# ── Extract new and old content based on tool ────────────────────────────────
case "$tool_name" in
    Write)
        new_content="$(hook_field .tool_input.content)"
        old_content="$(cat "$file_path" 2>/dev/null || true)"
        ;;
    Edit|NotebookEdit)
        new_content="$(hook_field .tool_input.new_string)"
        old_content="$(hook_field .tool_input.old_string)"
        ;;
    MultiEdit)
        new_content="$(printf '%s' "$_HOOK_INPUT" | jq -r '.tool_input.edits[].new_string // empty')"
        old_content="$(printf '%s' "$_HOOK_INPUT" | jq -r '.tool_input.edits[].old_string // empty')"
        ;;
    *)
        exit 0
        ;;
esac

# Nothing to scan.
[ -n "$new_content" ] || exit 0

# ── §6.10 Secret scan ────────────────────────────────────────────────────────
#
# Pipe new content to betterleaks (Gitleaks-compatible) stdin mode.
# Fail-open (Z6): scanner absent → log once per session, continue.
_scan_secrets() {
    local scanner=""
printf "DEBUG: PATH=%s
" "$PATH" >&2
command -v betterleaks >/dev/null 2>&1 && scanner="betterleaks"
printf "DEBUG: betterleaks=%s
" "$(command -v betterleaks)" >&2
    command -v betterleaks >/dev/null 2>&1 && scanner="betterleaks"
    [ -z "$scanner" ] && command -v gitleaks >/dev/null 2>&1 && scanner="gitleaks"

    if [ -z "$scanner" ]; then
        # Warn once per session; do not block.
        if [ -n "$session_id" ]; then
            local sess_dir; sess_dir="$(state_dir "$session_id" "${agent_id:-}")"
            local warn_flag="${sess_dir}/.secret-scanner-warned"
            if [ ! -f "$warn_flag" ]; then
                mkdir -p "$sess_dir" 2>/dev/null || true
                touch "$warn_flag" 2>/dev/null || true
                printf 'slopguard: secret scanner (betterleaks/gitleaks) unavailable — secret scan skipped\n' >&2
            fi
        fi
        return 0
    fi

    local config="${CLAUDE_PLUGIN_ROOT}/configs/baseline/.gitleaks.toml"
    local result
    result="$(printf '%s' "$new_content" | \
        "$scanner" stdin \
            --config "$config" \
            --report-format json \
            --report-path - \
            --redact \
            --no-banner 2>/dev/null || true)"

    if printf '%s' "$result" | jq -e 'type == "array" and length > 0' >/dev/null 2>&1; then
        local description rule_id secret_type
        description="$(printf '%s' "$result" | jq -r '.[0].Description // "secret"')"
        rule_id="$(printf '%s' "$result" | jq -r '.[0].RuleID // ""')"
        secret_type="${rule_id:-$description}"
        hook_deny "Secret detected (${secret_type}) in the content being written. Never embed credentials in source files. Use an environment variable or a secret manager instead."
        exit 0
    fi
}

_scan_secrets

# ── §7.2B Suppression detection helpers ─────────────────────────────────────

# _line_count_with_pat <literal_pattern> <text>
# Count lines containing the literal pattern (safe with grep -F).
_line_count_with_pat() {
    printf '%s' "$2" | grep -F "$1" 2>/dev/null | wc -l
}

# _line_count_with_pat_and_reason <literal_pattern> <reason_grep_E> <text>
# Count lines that have the pattern AND match the reason ERE.
_line_count_with_pat_and_reason() {
    printf '%s' "$3" | grep -F "$1" 2>/dev/null | grep -E "$2" 2>/dev/null | wc -l
}

# _check_suppression <literal_pattern> <reason_grep_E> <deny_message>
# Deny when new_content has more unreasoned occurrences than old_content.
_check_suppression() {
    local pat="$1" reason_pat="$2" deny_msg="$3"

    local old_total; old_total="$(_line_count_with_pat "$pat" "$old_content")"
    local old_reasoned; old_reasoned="$(_line_count_with_pat_and_reason "$pat" "$reason_pat" "$old_content")"
    local old_unreasoned=$(( old_total - old_reasoned ))

    local new_total; new_total="$(_line_count_with_pat "$pat" "$new_content")"
    local new_reasoned; new_reasoned="$(_line_count_with_pat_and_reason "$pat" "$reason_pat" "$new_content")"
    local new_unreasoned=$(( new_total - new_reasoned ))

    if [ "$new_unreasoned" -gt "$old_unreasoned" ]; then
        hook_deny "$deny_msg"
        exit 0
    fi
}

# ── §7.2B Suppression checks per language ───────────────────────────────────

_check_suppressions() {
    local file_ext base
    file_ext="${file_path##*.}"
    base="$(basename "$file_path")"

    # Determine language (IaC via name or extension).
    local lang=""
    case "$file_ext" in
        php|blade)         lang="php"   ;;
        go)                lang="go"    ;;
        py)                lang="python" ;;
        js|mjs|cjs|jsx)    lang="js_ts" ;;
        ts|tsx)            lang="js_ts" ;;
        tf|hcl)            lang="iac"   ;;
        yaml|yml)          lang="iac"   ;;
        toml)              lang="iac"   ;;
    esac
    case "$base" in
        Dockerfile*|*.dockerfile) lang="iac" ;;
    esac

    local deny_prefix="Suppression comment"
    local deny_suffix_go="requires a justification: //nolint:rule // reason: <≥10 chars explaining why this suppression is safe>"
    local deny_suffix_py="requires a justification: # noqa: RULE -- reason: <≥10 chars>"
    local deny_suffix_php="requires a justification: @phpstan-ignore rule (reason: <≥10 chars>)"
    local deny_suffix_jsts="requires a justification: directive -- reason: <≥10 chars>"
    local deny_suffix_iac="requires a justification: directive reason: <≥10 chars>"

    case "$lang" in
        php)
            local reason='\(reason:[[:space:]]*.{10,}\)'
            _check_suppression '@phpstan-ignore'           "$reason" "${deny_prefix} '@phpstan-ignore' ${deny_suffix_php}"
            _check_suppression '@phpstan-ignore-line'      "$reason" "${deny_prefix} '@phpstan-ignore-line' ${deny_suffix_php}"
            _check_suppression '@phpstan-ignore-next-line' "$reason" "${deny_prefix} '@phpstan-ignore-next-line' ${deny_suffix_php}"
            _check_suppression '@psalm-suppress'           "$reason" "${deny_prefix} '@psalm-suppress' ${deny_suffix_php}"
            _check_suppression 'phpcs:ignore'              "$reason" "${deny_prefix} 'phpcs:ignore' ${deny_suffix_php}"
            _check_suppression '@SuppressWarnings(PHPMD'  "$reason" "${deny_prefix} '@SuppressWarnings(PHPMD' ${deny_suffix_php}"
            ;;
        go)
            local reason='reason:[[:space:]]*.{10,}'
            _check_suppression '//nolint'   "$reason" "${deny_prefix} '//nolint' ${deny_suffix_go}"
            _check_suppression '// #nosec'  "$reason" "${deny_prefix} '// #nosec' ${deny_suffix_go}"
            _check_suppression '//#nosec'   "$reason" "${deny_prefix} '//#nosec' ${deny_suffix_go}"
            ;;
        python)
            local reason='--[[:space:]]*reason:[[:space:]]*.{10,}'
            _check_suppression '# noqa'          "$reason" "${deny_prefix} '# noqa' ${deny_suffix_py}"
            _check_suppression '# nosec'         "$reason" "${deny_prefix} '# nosec' ${deny_suffix_py}"
            _check_suppression '# type: ignore'  "$reason" "${deny_prefix} '# type: ignore' ${deny_suffix_py}"
            _check_suppression '# pyright: ignore' "$reason" "${deny_prefix} '# pyright: ignore' ${deny_suffix_py}"
            _check_suppression '# ty: ignore'    "$reason" "${deny_prefix} '# ty: ignore' ${deny_suffix_py}"
            _check_suppression '# pragma: no cover' "$reason" "${deny_prefix} '# pragma: no cover' ${deny_suffix_py}"
            ;;
        js_ts)
            local reason='--[[:space:]]*reason:[[:space:]]*.{10,}|@ts-expect-error[[:space:]].{10,}'
            _check_suppression 'eslint-disable'    "$reason" "${deny_prefix} 'eslint-disable' ${deny_suffix_jsts}"
            _check_suppression '@ts-ignore'        "$reason" "${deny_prefix} '@ts-ignore' ${deny_suffix_jsts}"
            _check_suppression '@ts-nocheck'       "$reason" "${deny_prefix} '@ts-nocheck' ${deny_suffix_jsts}"
            _check_suppression '@ts-expect-error'  "$reason" "${deny_prefix} '@ts-expect-error' ${deny_suffix_jsts}"
            ;;
        iac)
            local reason='reason:[[:space:]]*.{10,}'
            _check_suppression 'checkov:skip='     "$reason" "${deny_prefix} 'checkov:skip=' ${deny_suffix_iac}"
            _check_suppression '# tflint-ignore'   "$reason" "${deny_prefix} '# tflint-ignore' ${deny_suffix_iac}"
            _check_suppression '# kics-scan ignore' "$reason" "${deny_prefix} '# kics-scan ignore' ${deny_suffix_iac}"
            _check_suppression '# hadolint ignore=' "$reason" "${deny_prefix} '# hadolint ignore=' ${deny_suffix_iac}"
            _check_suppression '# zizmor: ignore'  "$reason" "${deny_prefix} '# zizmor: ignore' ${deny_suffix_iac}"
            ;;
    esac

    # Opengrep/Semgrep inline suppressions: any file type.
    local reason_og='reason:[[:space:]]*.{10,}'
    _check_suppression 'nosemgrep' "$reason_og" "${deny_prefix} 'nosemgrep' requires a justification: nosemgrep: rule -- reason: <≥10 chars>"
}

_check_suppressions

# ── §7.2C Protected files ────────────────────────────────────────────────────

_check_protected_files() {
    local base; base="$(basename "$file_path")"
    local reason="lowering quality gates must be reviewed by a human"

    # Tool config files — always ask.
    case "$base" in
        phpstan*.neon*|psalm*.xml*|.golangci.*|eslint.config.*|.eslintrc*)
            hook_ask "$reason"
            exit 0
            ;;
        ruff.toml|.ruff.toml|.tflint.hcl|.checkov.yaml|.kube-linter.yaml)
            hook_ask "$reason"
            exit 0
            ;;
        .hadolint.yaml|zizmor.yml|.gitleaks.toml|.sqlfluff)
            hook_ask "$reason"
            exit 0
            ;;
    esac

    # Baseline files — always ask.
    case "$base" in
        phpstan-baseline.neon|psalm-baseline.xml|.eslintcache|*.baseline.json)
            hook_ask "$reason"
            exit 0
            ;;
    esac

    # pyproject.toml — ask only when touching a linter tool section.
    if [ "$base" = "pyproject.toml" ]; then
        if printf '%s' "$new_content" | grep -qE '^\[tool\.(ruff|mypy|pyright)\]' 2>/dev/null; then
            hook_ask "${reason} (modifying a tool section in pyproject.toml)"
            exit 0
        fi
    fi

    # tsconfig*.json — ask only when weakening strict mode.
    case "$base" in
        tsconfig*.json)
            # New content adds "strict": false (that wasn't false before).
            local new_strict_false old_strict_false
            new_strict_false="$(printf '%s' "$new_content" | grep -cE '"strict"[[:space:]]*:[[:space:]]*false' 2>/dev/null || true)"
            old_strict_false="$(printf '%s' "$old_content" | grep -cE '"strict"[[:space:]]*:[[:space:]]*false' 2>/dev/null || true)"
            if [ "${new_strict_false:-0}" -gt "${old_strict_false:-0}" ]; then
                hook_ask "${reason} (disabling TypeScript strict mode)"
                exit 0
            fi
            # New content removes "strict": true (that was there before).
            local new_strict_true old_strict_true
            new_strict_true="$(printf '%s' "$new_content" | grep -cE '"strict"[[:space:]]*:[[:space:]]*true' 2>/dev/null || true)"
            old_strict_true="$(printf '%s' "$old_content" | grep -cE '"strict"[[:space:]]*:[[:space:]]*true' 2>/dev/null || true)"
            if [ "${old_strict_true:-0}" -gt "${new_strict_true:-0}" ]; then
                hook_ask "${reason} (removing TypeScript strict: true)"
                exit 0
            fi
            ;;
    esac

    # CI files — ask only when the diff removes lint/test/security step references.
    case "$file_path" in
        */.github/workflows/*|*/.gitlab-ci.yml)
            local kw
            for kw in lint test security; do
                local old_kw new_kw
                old_kw="$(printf '%s' "$old_content" | grep -ci "$kw" 2>/dev/null || true)"
                new_kw="$(printf '%s' "$new_content" | grep -ci "$kw" 2>/dev/null || true)"
                if [ "${old_kw:-0}" -gt "${new_kw:-0}" ]; then
                    hook_ask "${reason} (removes '${kw}' references from CI file)"
                    exit 0
                fi
            done
            ;;
    esac
}

_check_protected_files

# ── §7.2D Test-skip markers ──────────────────────────────────────────────────

_check_test_skips() {
    local reason="Adding a test-skip marker must be reviewed by a human. Fix or delete the test rather than skipping it."

    # Literal patterns matched with grep -F (except xit which uses -E for word boundary).
    local pat
    for pat in \
        'markTestSkipped' \
        'markTestIncomplete' \
        't.Skip(' \
        'it.skip(' \
        'describe.skip(' \
        'test.skip(' \
        '@pytest.mark.skip' \
        '@unittest.skip'
    do
        local old_n; old_n="$(_line_count_with_pat "$pat" "$old_content")"
        local new_n; new_n="$(_line_count_with_pat "$pat" "$new_content")"
        if [ "$new_n" -gt "$old_n" ]; then
            hook_ask "${reason} ('${pat}' added)"
            exit 0
        fi
    done

    # xit( — use word boundary to avoid matching "exit(".
    local old_xit; old_xit="$(printf '%s' "$old_content" | grep -cE '\bxit\(' 2>/dev/null || true)"
    local new_xit; new_xit="$(printf '%s' "$new_content" | grep -cE '\bxit\(' 2>/dev/null || true)"
    if [ "${new_xit:-0}" -gt "${old_xit:-0}" ]; then
        hook_ask "${reason} ('xit(' added)"
        exit 0
    fi
}

_check_test_skips

# ── §8.8 First-edit-of-language additionalContext ───────────────────────────
#
# On the first Write/Edit of a given language within a session, emit a compact
# list of that language's blocker anti-patterns (≤1500 chars) and a reference
# to the skill. Subsequent edits of the same language produce no context.

# _lang_from_path <path> → prints a canonical language key or nothing.
_lang_from_path() {
    local ext base
    ext="${1##*.}"
    base="$(basename "$1")"
    case "$ext" in
        php|blade)      printf 'php'       ;;
        go)             printf 'go'        ;;
        py)             printf 'python'    ;;
        js|mjs|cjs|jsx) printf 'js'        ;;
        ts|tsx)         printf 'ts'        ;;
        tf|hcl)         printf 'terraform' ;;
        sql)            printf 'sql'       ;;
        *)
            case "$base" in
                Dockerfile*|*.dockerfile) printf 'docker' ;;
            esac
            ;;
    esac
}

# _lang_blockers <lang> → emit ≤1500-char blocker summary (statements of fact).
_lang_blockers() {
    case "$1" in
        php)
            printf 'PHP blockers — skill: php-antipatterns\n'
            printf '- AP-PHP-SEC-001: DB::raw / whereRaw with interpolation embeds user data in SQL. Bindings: DB::select("... where id = ?", [$id]).\n'
            printf '- AP-PHP-SEC-002: unserialize() on external data enables RCE. json_decode() is the safe alternative.\n'
            printf '- AP-PHP-SEC-003: shell_exec / exec / system on user input enables command injection. Process builders with argument lists are the safe alternative.\n'
            printf '- AP-PHP-SEC-004: {!! $x !!} in Blade outputs unescaped HTML. {{ $x }} escapes output.\n'
            printf '- AP-PHP-SEC-005: ::create($request->all()) exposes mass-assignment. Explicit fillable fields prevent it.\n'
            printf '- AP-PHP-SEC-006: md5 / sha1 for passwords or tokens is cryptographically broken. password_hash / random_bytes are the safe alternatives.\n'
            printf '- AP-AGENT-001: Suppression comments require a justification: @phpstan-ignore rule (reason: explanation).\n'
            printf '- AP-AGENT-002: phpstan-baseline.neon and phpstan.neon gate edits require human review.\n'
            ;;
        go)
            printf 'Go blockers — skill: go-antipatterns\n'
            printf '- AP-GO-SEC-001: fmt.Sprintf in SQL embeds user data without escaping. Parameterised queries prevent injection.\n'
            printf '- AP-GO-SEC-002: exec.Command with user input without validation enables command injection.\n'
            printf '- AP-GO-SEC-003: math/rand for cryptographic material is predictable. crypto/rand is required.\n'
            printf '- AP-GO-SEC-007: Hardcoded credentials in source. Use os.Getenv or a secret manager.\n'
            printf '- AP-AGENT-001: //nolint requires a justification: //nolint:rule // reason: <≥10 chars>.\n'
            printf '- AP-AGENT-002: .golangci.yml gate edits require human review.\n'
            ;;
        python)
            printf 'Python blockers — skill: python-antipatterns\n'
            printf '- AP-PY-SEC-001: f-string or % format in SQL embeds user data. Parameterised queries prevent injection.\n'
            printf '- AP-PY-SEC-002: subprocess with shell=True on user input enables command injection.\n'
            printf '- AP-PY-SEC-003: eval() / exec() on external data enables arbitrary code execution.\n'
            printf '- AP-PY-SEC-004: pickle.loads() on untrusted data enables RCE.\n'
            printf '- AP-PY-SEC-005: requests with verify=False disables TLS certificate validation.\n'
            printf '- AP-PY-SEC-008: Hardcoded passwords or keys in source. Use os.environ or a secret manager.\n'
            printf '- AP-AGENT-001: Suppression comments require a justification: # noqa: RULE -- reason: <≥10 chars>.\n'
            ;;
        js)
            printf 'JS blockers — skill: node-antipatterns\n'
            printf '- AP-NODE-SEC-001: Recursive merge with req.body / req.query enables prototype pollution.\n'
            printf '- AP-NODE-SEC-002: exec(`...${userInput}`) or child_process with template literals enables command injection.\n'
            printf '- AP-NODE-SEC-009: JWT verification without an algorithms whitelist enables algorithm substitution attacks.\n'
            printf '- AP-NODE-SEC-007: express.json() without a size limit enables DoS via large bodies.\n'
            printf '- AP-AGENT-001: eslint-disable requires a justification: -- reason: <≥10 chars>.\n'
            printf '- AP-AGENT-002: eslint.config.* gate edits require human review.\n'
            ;;
        ts)
            printf 'TypeScript / React blockers — skills: node-antipatterns, ts-react-antipatterns\n'
            printf '- AP-TS-SEC-003: Auth tokens in localStorage are readable by any JS on the page. Use httpOnly cookies or in-memory state.\n'
            printf '- AP-NODE-SEC-001: Recursive merge with req.body / req.query enables prototype pollution.\n'
            printf '- AP-NODE-SEC-009: JWT verification without an algorithms whitelist enables algorithm substitution attacks.\n'
            printf '- AP-AGENT-001: @ts-expect-error / @ts-ignore require a justification: <≥10 chars description>.\n'
            printf '- AP-AGENT-002: tsconfig.json strict flag edits and eslint.config.* changes require human review.\n'
            ;;
        terraform)
            printf 'Terraform / IaC blockers — skill: iac-antipatterns\n'
            printf '- AP-TF-SEC-001: Hardcoded credentials in .tf files. Use variables or a secret manager.\n'
            printf '- AP-TF-SEC-002: Public S3 bucket ACL or bucket policy. Enforce block_public_acls = true.\n'
            printf '- AP-TF-SEC-003: Unencrypted storage or database resources expose data at rest.\n'
            printf '- AP-AGENT-001: checkov:skip= requires a justification: reason: <≥10 chars>.\n'
            printf '- AP-AGENT-002: .tflint.hcl and .checkov.yaml gate edits require human review.\n'
            ;;
        docker)
            printf 'Docker blockers — skill: iac-antipatterns\n'
            printf '- AP-DOCKER-001: Base image with :latest or no digest makes builds non-reproducible in production.\n'
            printf '- AP-DOCKER-002: Container running as root violates least-privilege; add USER directive.\n'
            printf '- AP-DOCKER-004: curl | sh in a Dockerfile executes arbitrary code from the network at build time.\n'
            printf '- AP-AGENT-001: # hadolint ignore= requires a justification: reason: <≥10 chars>.\n'
            ;;
        sql)
            printf 'SQL blockers — skill: sql-antipatterns\n'
            printf '- AP-SQL-001: String concatenation in queries enables SQL injection. Parameterised queries prevent it.\n'
            printf '- AP-SQL-003: Foreign-key columns without an index degrade join performance at scale.\n'
            printf '- AP-SQL-004: NOT NULL column without a default value blocks zero-downtime migrations.\n'
            ;;
    esac
}

_emit_first_edit_context() {
    [ -n "$session_id" ] || return 0

    local lang; lang="$(_lang_from_path "$file_path")"
    [ -n "$lang" ] || return 0

    local sess_dir; sess_dir="$(state_dir "$session_id" "${agent_id:-}")"
    mkdir -p "$sess_dir" 2>/dev/null || return 0

    local lang_seen="${sess_dir}/lang-seen"

    # Atomic check-and-mark under the session lock.
    state_lock_acquire "$sess_dir" 50 30 || return 0

    local seen=0
    if [ -f "$lang_seen" ] && grep -qxF "$lang" "$lang_seen" 2>/dev/null; then
        seen=1
    fi

    if [ "$seen" -eq 0 ]; then
        printf '%s\n' "$lang" >> "$lang_seen"
        state_lock_release "$sess_dir"

        local ctx; ctx="$(_lang_blockers "$lang")"
        if [ -n "$ctx" ]; then
            # Truncate to 1500 chars to honour §8.8 budget.
            ctx="$(printf '%s' "$ctx" | head -c 1500)"
            hook_context "$ctx"
        fi
    else
        state_lock_release "$sess_dir"
    fi
}

_emit_first_edit_context

# Default: allow (exit 0, no JSON output → hook passes).
exit 0
