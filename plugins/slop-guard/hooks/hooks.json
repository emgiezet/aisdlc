{
  "description": "Slop Guard: prevention, detection and gating",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT:-${GROK_PLUGIN_ROOT}}/bin/slopguard\" session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT:-${GROK_PLUGIN_ROOT}}/bin/slopguard\" pre-bash",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT:-${GROK_PLUGIN_ROOT}}/bin/slopguard\" pre-read",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT:-${GROK_PLUGIN_ROOT}}/bin/slopguard\" pre-write",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
