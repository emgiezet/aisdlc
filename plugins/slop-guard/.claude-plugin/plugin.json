{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "slop-guard",
  "displayName": "Slop Guard",
  "version": "0.1.0",
  "description": "PreToolUse policy enforcement for agent-written code: credential access guards, supply-chain install blocks, linter-suppression gates, and hard-coded secret detection.",
  "license": "MIT",
  "author": { "name": "Maksymilian Małecki" },
  "keywords": ["security", "linting", "anti-patterns", "supply-chain"],
  "userConfig": {
    "enforcement_mode": {
      "type": "string",
      "title": "Enforcement mode",
      "description": "advisory | balanced | strict",
      "default": "balanced"
    },
    "tool_source": {
      "type": "string",
      "title": "Tool source",
      "description": "project-first | plugin-only | project-only",
      "default": "project-first"
    }
  }
}
