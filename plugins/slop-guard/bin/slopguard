#!/usr/bin/env bash
# slopguard — anti-pattern detection and gate for agent-written code.
#
#   slopguard doctor [--install]   report tool status; install with --install
#   slopguard version              print version
#   slopguard help                 this message
#
# Requires: jq (or compatible). Other tool dependencies are installed by doctor.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
MANIFEST="${PLUGIN_ROOT}/.claude-plugin/plugin.json"

# When invoked by the Claude Code runtime, CLAUDE_PLUGIN_ROOT and
# CLAUDE_PLUGIN_DATA are injected. Fall back to derived paths for standalone use.
: "${CLAUDE_PLUGIN_ROOT:=$PLUGIN_ROOT}"
: "${CLAUDE_PLUGIN_DATA:=${XDG_DATA_HOME:-$HOME/.local/share}/claude/plugins/slop-guard}"

# Read identity from the manifest so nothing here hard-codes the plugin name.
manifest_field() {
    sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$MANIFEST" 2>/dev/null | head -1
}
VERSION="$(manifest_field version)"; [ -n "$VERSION" ] || VERSION="unknown"

# --------------------------------------------------------------------------- #
# plumbing
# --------------------------------------------------------------------------- #

die() { printf 'slopguard: %s\n' "$1" >&2; exit "${2:-1}"; }
say() { printf '%s\n' "$1"; }

need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed"; }

# shellcheck source=../lib/tools.sh
. "${CLAUDE_PLUGIN_ROOT}/lib/tools.sh"
# shellcheck source=../lib/hook.sh
. "${CLAUDE_PLUGIN_ROOT}/lib/hook.sh"
# shellcheck source=../lib/state.sh
. "${CLAUDE_PLUGIN_ROOT}/lib/state.sh"
# shellcheck source=../lib/finding.sh
. "${CLAUDE_PLUGIN_ROOT}/lib/finding.sh"

# --------------------------------------------------------------------------- #
# doctor
# --------------------------------------------------------------------------- #

cmd_doctor() {
    local do_install=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --install) do_install=1; shift ;;
            -*)        die "unknown flag for doctor: $1" ;;
            *)         die "unexpected argument: $1" ;;
        esac
    done

    detect_platform >/dev/null || die "unsupported platform"

    # Guard against a missing or malformed lockfile — an empty tool list would
    # produce a false-green "All tools present" and is the exact inverse of §Z6.
    local lock_path; lock_path="$(_tools_lock)" || die "CLAUDE_PLUGIN_ROOT is not set"
    [ -f "$lock_path" ] || die "lockfile missing: $lock_path"

    local tools_list
    tools_list="$(lock_tools)" || die "lockfile unreadable or malformed: $lock_path"
    [ -n "$tools_list" ] || die "lockfile contains no tools: $lock_path"

    say "slopguard doctor — plugin: ${CLAUDE_PLUGIN_ROOT}  data: ${CLAUDE_PLUGIN_DATA}"
    say ""

    local fail_count=0

    while IFS= read -r tool; do
        local expected_version; expected_version="$(lock_version "$tool")"
        local resolved;         resolved="$(resolve_tool "$tool")"
        local config_label="none"
        local fail_this=0

        if [ -z "$resolved" ]; then
            fail_this=1
            say "  ${tool}  source: missing  lockfile: ${expected_version}  [NOT FOUND]  config: ${config_label}"
            # §9.1: log any PATH binary that was found but rejected for version mismatch.
            local path_bin
            if path_bin="$(command -v "$tool" 2>/dev/null)"; then
                local path_ver; path_ver="$( { "$path_bin" --version 2>&1 || true; } | head -1 )"
                say "    PATH: ${path_bin} (${path_ver}) — rejected: version mismatch (want ${expected_version})"
            fi
        else
            local source_label version_label match_label
            # Determine where the resolved binary came from.
            local plugin_pfx="${CLAUDE_PLUGIN_DATA:-__NO_PLUGIN_DATA__}/tools/"
            case "$resolved" in
                "${plugin_pfx}"*)
                    source_label="plugin" ;;
                */vendor/bin/*|*/node_modules/.bin/*|*/.venv/bin/*)
                    source_label="project" ;;
                *)
                    if [ -n "${CLAUDE_PROJECT_DIR:-}" ] && \
                       [ "${resolved#${CLAUDE_PROJECT_DIR}/}" != "$resolved" ]; then
                        source_label="project"
                    else
                        source_label="PATH"
                    fi
                    ;;
            esac

            version_label="$( { "$resolved" --version 2>&1 || true; } | head -1 )"

            if tool_version_matches "$tool" "$resolved"; then
                match_label="ok"
            else
                match_label="version mismatch (want ${expected_version})"
                fail_this=1
            fi

            say "  ${tool}  source: ${source_label}  version: ${version_label}  [${match_label}]  config: ${config_label}"
        fi

        # Install (or reinstall) when the tool is missing or version-mismatched.
        if [ "$fail_this" -eq 1 ]; then
            fail_count=$((fail_count + 1))
            if [ "$do_install" -eq 1 ]; then
                say "    → installing..."
                if install_tool "$tool"; then
                    # Re-resolve: a higher-priority binary (e.g. a project binary at the wrong
                    # version) can still win after install, making the tool effectively absent.
                    # Also: source mode project-only skips the plugin dir entirely, so the
                    # installed binary is unreachable even though no competing binary exists.
                    local re_resolved; re_resolved="$(resolve_tool "$tool")"
                    if [ -n "$re_resolved" ] && tool_version_matches "$tool" "$re_resolved"; then
                        say "    → installed ${tool} ${expected_version}"
                        fail_count=$((fail_count - 1))
                    elif [ -n "$re_resolved" ]; then
                        say "    → installed ${tool} ${expected_version} but a higher-priority binary still wins — see above"
                    else
                        say "    → installed ${tool} ${expected_version} but the binary is not reachable in the current source mode"
                    fi
                else
                    say "    → install FAILED"
                fi
            elif [ -z "$resolved" ]; then
                say "    install:  slopguard doctor --install"
            fi
        fi
    done <<< "$tools_list"

    say ""
    if [ "$fail_count" -eq 0 ]; then
        say "All tools present and version-matched."
    else
        say "Some tools are missing or version-mismatched."
        if [ "$do_install" -eq 0 ]; then
            say "Run:  slopguard doctor --install"
        fi
        return 1
    fi
}

# --------------------------------------------------------------------------- #
# help
# --------------------------------------------------------------------------- #

cmd_help() {
    cat <<USAGE
slopguard ${VERSION} — anti-pattern detection and gate for agent-written code.

  slopguard doctor             report tool status (installs nothing)
  slopguard doctor --install   install or update pinned tools
  slopguard version            print version
  slopguard help               this message

Plugin root: ${CLAUDE_PLUGIN_ROOT}
Plugin data: ${CLAUDE_PLUGIN_DATA}

Tool resolution order (tool_source=project-first):
  1. Project binary  — vendor/bin, node_modules/.bin, .venv/bin, go tool -n
  2. Plugin binary   — \${CLAUDE_PLUGIN_DATA}/tools/<name>/current/<name>
                       accepted only when version equals the lockfile
  3. PATH binary     — only when version equals the lockfile

See tools/tools.lock.json for pinned versions and sha256 hashes.
USAGE
}

# --------------------------------------------------------------------------- #

need jq

case "${1:-help}" in
    session-start)     shift; cmd_session_start "$@" ;;
    pre-bash)          shift; cmd_pre_bash "$@" ;;
    pre-write)         shift; cmd_pre_write "$@" ;;
    pre-read)          shift; cmd_pre_read "$@" ;;
    post-write)        shift; cmd_post_write "$@" ;;
    stop-gate)         shift; cmd_stop_gate "$@" ;;
    scan)              shift; cmd_scan "$@" ;;
    doctor)            shift; cmd_doctor "$@" ;;
    version|--version) say "slopguard ${VERSION}" ;;
    help|--help|-h)    cmd_help ;;
    *)                 die "unknown command '${1:-}' — try: slopguard help" ;;
esac
