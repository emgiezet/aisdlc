#!/usr/bin/env bash
# SessionStart hook — announces the AI SDLC pipeline and the rules it enforces.
set -euo pipefail

MANIFEST="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)/.claude-plugin/plugin.json"
field() { sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$MANIFEST" 2>/dev/null | head -1; }
VERSION="$(field version)"; [ -n "$VERSION" ] || VERSION="unknown"
NAME="$(field name)";       [ -n "$NAME" ] || NAME="sdlc"

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# Grok: SessionStart stdout is ignored (passive hook); exit cleanly.
if [ -n "${GROK_PLUGIN_ROOT:-}" ] && [ -z "${CLAUDE_PLUGIN_ROOT:-}" ]; then
    exit 0
fi

# Unknown runtime: nothing to inject.
if [ -z "${CLAUDE_PLUGIN_ROOT:-}" ]; then
    exit 0
fi

context_raw="AI SDLC harness active (${NAME} v${VERSION}).

The pipeline. A spec is the only approval point; everything after it runs unattended:
  /${NAME}:init             → generate this repo's task router, playbooks, rules, profile, descriptors (run once)
  /${NAME}:spec <TICKET>    → specs/<TICKET>/spec.md with a UC table (starts as status: draft)
  /${NAME}:mockup <TICKET>  → clickable single-file mockup for business validation
  <a human flips status: approved and commits it>
  /${NAME}:implement <TICKET> → no-gate TDD build, one test per UC, full CI matrix
  /${NAME}:qa <TICKET>      → independent verification, UC×test matrix, browser pass for UI UCs, PASS/GAPS
  /${NAME}:ship <TICKET>    → draft PR with the verdict up front, label review, QA report as a comment
  /${NAME}:review <pr#>     → severity-ranked review, APPROVED/CHANGES_REQUESTED, autofix on its own PRs
  aisdlc add <TICKET>       → queue it: worktree per task, implement → qa → ship → review

Before the spec:  /${NAME}:brainstorm, /${NAME}:discover, /${NAME}:synthetic-users, /${NAME}:backlog,
                  /${NAME}:ux-shape, /${NAME}:ux-setup → briefs under specs/briefs/
From an issue:    /${NAME}:issue (file/normalize) · /${NAME}:triage · /${NAME}:root-cause · /${NAME}:fix-issue <n>
                  (a human-labelled bug is the approval; aisdlc add --issue <n> queues the chain)
After the PR:     /${NAME}:continue · /${NAME}:fix-pr · /${NAME}:autopilot · /${NAME}:review-prs ·
                  /${NAME}:merge-buddy · /${NAME}:merge (interactive only) · /${NAME}:followup ·
                  /${NAME}:close-fixed · /${NAME}:changelog
QA surface:       /${NAME}:test-env · /${NAME}:integration-tests · /${NAME}:ux-review
Harness:          /${NAME}:retro — rank what the runs cost, by cause
Architecture:     /${NAME}:arch-review <EPIC|path> — grade a planned architecture against its traffic profile, availability tier and RPO/RTO

Skills (load with the Skill tool):
- spec-authoring      — the UC table format: atomic, observable, stably-numbered criteria
- task-router         — keeping CLAUDE.md small: router table, playbooks, path-scoped rules
- dense-testing       — density floors, UC ids in test names, and what must never be weakened
- harness-eval        — measuring the harness on a cheap model, and fixing instructions not tiers
- pipeline-contracts  — descriptors, operations, chain markers, verdict tokens, claim lock, labels
- code-review         — severity scale, verdict rule, review checklist, spec-review lenses
- architecture-review — availability tiers and what each forces, dependency arithmetic, traffic profile, RPO/RTO
- discovery           — brief format, evidence tags, Definition of Ready

Agents: auto-qa — verifies an implementation against its spec; code-reviewer — reviews a PR spec-first.

Tracker and browser access go through the descriptors named in .claude/sdlc.md — never call gh or a
browser directly from a /${NAME} command.

Enforced by hooks, not by good intentions: force pushes and --no-verify are blocked, and a
session that deletes or skips a test is blocked from finishing. If a test contradicts the
spec, that is a contradiction to report, not a test to remove.

If this repo has no CLAUDE.md task router yet, run /${NAME}:init before anything else."

context_escaped=$(escape_for_json "$context_raw")

# Claude JSON contract (hookSpecificOutput) — honoured by both Claude and Codex.
cat <<EOF
{
  "hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": "${context_escaped}"
  }
}
EOF

exit 0
