#!/usr/bin/env bash
# SessionStart hook — announces the AI SDLC pipeline and the rules it enforces.
set -euo pipefail

MANIFEST="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)/.claude-plugin/plugin.json"
field() { sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$MANIFEST" 2>/dev/null | head -1; }
VERSION="$(field version)"; [ -n "$VERSION" ] || VERSION="unknown"
NAME="$(field name)";       [ -n "$NAME" ] || NAME="sdlc"

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# Grok: SessionStart stdout is ignored (passive hook); exit cleanly.
if [ -n "${GROK_PLUGIN_ROOT:-}" ] && [ -z "${CLAUDE_PLUGIN_ROOT:-}" ]; then
    exit 0
fi

# Unknown runtime: nothing to inject.
if [ -z "${CLAUDE_PLUGIN_ROOT:-}" ]; then
    exit 0
fi

# Codex: sets PLUGIN_ROOT (native) plus CLAUDE_PLUGIN_ROOT (compatibility layer).
# Claude: sets only CLAUDE_PLUGIN_ROOT.
if [ -n "${PLUGIN_ROOT:-}" ]; then
    # Codex — $-prefixed commands
    _init="\$init"
    _spec="\$spec"
    _mockup="\$mockup"
    _implement="\$implement"
    _qa="\$qa"
    _ship="\$ship"
    _queue_note="aisdlc queue is Claude-only — invoke \$implement <TICKET> directly after approval"
else
    # Claude — /sdlc:-prefixed commands
    _init="/${NAME}:init"
    _spec="/${NAME}:spec"
    _mockup="/${NAME}:mockup"
    _implement="/${NAME}:implement"
    _qa="/${NAME}:qa"
    _ship="/${NAME}:ship"
    _queue_note="aisdlc add <TICKET>       → queue it instead: worktree per task, PRs are the review inbox"
fi

context_raw="AI SDLC harness active (${NAME} v${VERSION}).

The pipeline. A spec is the only approval point; everything after it runs unattended:
  ${_init}             → generate this repo's task router, playbooks, and rules (run once)
  ${_spec} <TICKET>    → specs/<TICKET>/spec.md with a UC table (starts as status: draft)
  ${_mockup} <TICKET>  → clickable single-file mockup for business validation
  <a human flips status: approved and commits it>
  ${_implement} <TICKET> → no-gate TDD build, one test per UC, full CI matrix
  ${_qa} <TICKET>      → independent verification, UC×test matrix, PASS/GAPS verdict
  ${_ship} <TICKET>    → draft PR with the verdict up front, QA report as a comment
  ${_queue_note}

Skills (load with the Skill tool):
- spec-authoring — the UC table format: atomic, observable, stably-numbered criteria
- task-router    — keeping CLAUDE.md small: router table, playbooks, path-scoped rules
- dense-testing  — density floors, UC ids in test names, and what must never be weakened
- harness-eval   — measuring the harness on a cheap model, and fixing instructions not tiers

Agent: auto-qa — verifies an implementation against its spec before a human reads it.

Enforced by hooks, not by good intentions: force pushes and --no-verify are blocked, and a
session that deletes or skips a test is blocked from finishing. If a test contradicts the
spec, that is a contradiction to report, not a test to remove.

If this repo has no CLAUDE.md task router yet, run ${_init} before anything else."

context_escaped=$(escape_for_json "$context_raw")

# Claude JSON contract (hookSpecificOutput) — honoured by both Claude and Codex.
cat <<EOF
{
  "hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": "${context_escaped}"
  }
}
EOF

exit 0
