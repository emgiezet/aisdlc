{
  "description": "AI SDLC: task-router session context and guard enforcement",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT:-${GROK_PLUGIN_ROOT}}/hooks/run-hook.cmd\" session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT:-${GROK_PLUGIN_ROOT}}/hooks/run-hook.cmd\" guard pre-bash",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT:-${GROK_PLUGIN_ROOT}}/hooks/run-hook.cmd\" guard stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
