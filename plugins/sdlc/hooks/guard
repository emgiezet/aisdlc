#!/usr/bin/env bash
# guard — enforces the dense-testing non-negotiables and blocks irreversible git commands.
#
# Usage (from hooks.json, via run-hook.cmd):
#   guard pre-bash   — PreToolUse on Bash: deny force pushes, --no-verify, dangerous rm
#   guard stop       — Stop: deny finishing a session that deleted or skipped tests
#                      (advisory warning on Grok — Stop hooks are passive there).
#                      Deletions listed with a reason in .claude/retired-tests are allowed.
#
# Contract:
#   Claude/Codex PreToolUse — exit 0 = allow; exit 2 = block, reason on stderr.
#   Grok PreToolUse         — exit 0 + stdout {"decision":"deny","reason":"..."} = block.
#   Grok Stop               — always exit 0; findings printed to stderr as advisory.
#   Any other failure mode must allow; a broken guard that blocks every session is worse
#   than no guard.
# Ownership boundary: this hook alone owns destructive git/rm commands and test
# weakening. Slop Guard owns secrets, suppressions, dependency and lint policy.
set -uo pipefail

MODE="${1:-}"

# Degrade to allow if we cannot parse the event.
if ! command -v jq >/dev/null 2>&1; then
    echo "guard: jq not found — skipping checks (install jq to enable them)" >&2
    exit 0
fi

INPUT="$(cat 2>/dev/null || true)"
[ -n "$INPUT" ] || exit 0

# Grok runtime detection: GROK_PLUGIN_ROOT set, CLAUDE_PLUGIN_ROOT absent.
IS_GROK=""
[ -n "${GROK_PLUGIN_ROOT:-}" ] && [ -z "${CLAUDE_PLUGIN_ROOT:-}" ] && IS_GROK=1

# deny MSG — emit a blocking decision appropriate to the host and mode.
#   Claude/Codex: write reason to stderr, exit 2.
#   Grok PreToolUse: emit {"decision":"deny","reason":MSG} to stdout, exit 0.
#   Not called from stop_check on Grok; stop_check emits an advisory instead.
deny() {
    if [ -n "$IS_GROK" ]; then
        jq -n --arg r "$1" '{"decision":"deny","reason":$r}'
        exit 0
    fi
    printf '%s\n' "$1" >&2
    exit 2
}

# --------------------------------------------------------------------------- #
# pre-bash — block commands whose damage cannot be reviewed after the fact
# --------------------------------------------------------------------------- #
pre_bash() {
    local cmd input
    input="$INPUT"
    # Normalize Grok camelCase: toolInput → tool_input (only field consumed here)
    if [ -n "$IS_GROK" ]; then
        input="$(printf '%s' "$input" | jq 'if .toolInput != null then .tool_input = .toolInput else . end')"
    fi
    cmd="$(printf '%s' "$input" | jq -r '.tool_input.command // empty')"
    [ -n "$cmd" ] || exit 0

    # Force push: rewrites shared history. --force-with-lease is fine.
    if printf '%s' "$cmd" | grep -Eq 'git[[:space:]]+push([[:space:]]+[^|;&]*)?[[:space:]](--force([[:space:]]|$)|-f([[:space:]]|$))'; then
        deny "guard: force push blocked — it rewrites history others may have pulled.
Use 'git push --force-with-lease' if you must overwrite your own remote branch, or push a new branch."
    fi

    # --no-verify: skips the hooks that catch bad commits.
    if printf '%s' "$cmd" | grep -Eq 'git[[:space:]]+(commit|push)([[:space:]]+[^|;&]*)?[[:space:]](--no-verify([[:space:]]|$)|-n([[:space:]]|$))'; then
        deny "guard: --no-verify blocked — pre-commit hooks exist to catch exactly what this bypasses.
Fix what the hook reports instead of skipping it."
    fi

    # rm -rf against a root, a home dir, or an absolute path outside the working tree.
    if printf '%s' "$cmd" | grep -Eq 'rm[[:space:]]+(-[a-zA-Z]*[rR][a-zA-Z]*[fF][a-zA-Z]*|-[a-zA-Z]*[fF][a-zA-Z]*[rR][a-zA-Z]*)[[:space:]]'; then
        # Inspect whole tokens only — './node_modules' must not match on its '/node_modules'.
        # Globbing off: a literal '*' in the command must not expand against the real cwd.
        local t
        set -f
        for t in $(printf '%s' "$cmd" | tr ';|&' '\n\n\n'); do
            # These patterns match the literal text an agent typed, before any shell
            # expansion — a bare ~ here is a token to compare, not a path to resolve.
            # shellcheck disable=SC2088
            case "$t" in
                -*|rm) continue ;;
                /|"~"|"~/"|'$HOME'|'$HOME/'|/'*')
                    deny "guard: 'rm -rf $t' blocked — that target is not recoverable." ;;
            esac
            # Absolute path outside the current working tree.
            case "$t" in
                "$PWD"|"$PWD"/*) ;;
                "$HOME") deny "guard: 'rm -rf $t' blocked — that target is not recoverable." ;;
                /*) deny "guard: 'rm -rf $t' blocked — it points outside the working tree ($PWD)." ;;
            esac
        done
        set +f
    fi

    exit 0
}

# --------------------------------------------------------------------------- #
# stop — warn or block a session that made the suite green by removing its teeth
# --------------------------------------------------------------------------- #
TEST_PATH_RE='(_test\.(go|py|rb)|test_[^/]*\.py|\.(test|spec)\.(ts|tsx|js|jsx|mjs)$|Test\.php$|/tests?/|/Tests/|/__tests__/|/e2e/)'

# Jasmine/Jest focus and exclude helpers (xit, fit, xdescribe, fdescribe) only as whole
# identifiers — 'SystemExit(' and 'benefit(' are not tests.
SKIP_ADD_RE='(t\.Skip\(|t\.Skipf\(|testing\.Short\(\)|\.skip\(|\.only\(|it\.skip|describe\.skip|(^|[^[:alnum:]_$.])(xit|fit|xdescribe|fdescribe)\(|markTestSkipped|@pytest\.mark\.skip|@unittest\.skip|@Ignore|->skip\(|Skip::)'

# Retired-tests ledger, relative to the repository root. One entry per line:
#   <path-or-glob> <reason>
# '#' starts a comment. An entry without a reason is ignored. Globs use shell case matching,
# so '*' also crosses '/'.
RETIRED_LEDGER='.claude/retired-tests'

# retired_patterns BASE — print the path patterns of ledger entries that carry a reason.
# Headless runs read the ledger as it was at BASE only: an unattended session cannot approve
# its own deletions. Interactive sessions read the working tree, where a human is present.
retired_patterns() {
    local base="$1" src top
    if [ "${AISDLC_HEADLESS:-0}" = "1" ]; then
        [ -n "$base" ] || return 0
        src="$(git show "${base}:${RETIRED_LEDGER}" 2>/dev/null)" || return 0
    else
        top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
        src="$(cat "${top}/${RETIRED_LEDGER}" 2>/dev/null)" || return 0
    fi
    printf '%s\n' "$src" | awk '$1 !~ /^#/ && NF >= 2 {print $1}'
}

# is_retired PATH PATTERNS — true when PATH matches one of the newline-separated PATTERNS.
is_retired() {
    local path="$1" pat
    while IFS= read -r pat; do
        [ -n "$pat" ] || continue
        # shellcheck disable=SC2254 # unquoted on purpose: the ledger entry is a glob
        case "$path" in $pat) return 0 ;; esac
    done <<< "$2"
    return 1
}

stop_check() {
    local input reentered
    input="$INPUT"
    # Normalize Grok camelCase: stopHookActive → stop_hook_active (only field consumed here)
    if [ -n "$IS_GROK" ]; then
        input="$(printf '%s' "$input" | jq 'if .stopHookActive != null then .stop_hook_active = .stopHookActive else . end')"
    fi
    # Already re-entered from a previous block: warn once more, then let it finish.
    # Blocking forever would trap the session in a loop it cannot exit.
    reentered="$(printf '%s' "$input" | jq -r '.stop_hook_active // false')"

    git rev-parse --git-dir >/dev/null 2>&1 || exit 0

    # Diff base: the fork point from the default branch, so committed work in this
    # session counts. Fall back to the working tree alone.
    local base="" ref
    for ref in origin/master origin/main master main; do
        if git rev-parse --verify --quiet "$ref" >/dev/null 2>&1; then
            base="$(git merge-base HEAD "$ref" 2>/dev/null || true)"
            [ -n "$base" ] && break
        fi
    done

    local diff="" names=""
    if [ -n "$base" ] && [ "$base" != "$(git rev-parse HEAD 2>/dev/null)" ]; then
        diff="$(git diff "$base" 2>/dev/null; git diff 2>/dev/null)"
        names="$(git diff --name-status "$base" 2>/dev/null; git diff --name-status 2>/dev/null)"
    else
        diff="$(git diff HEAD 2>/dev/null; git diff 2>/dev/null)"
        names="$(git diff --name-status HEAD 2>/dev/null; git diff --name-status 2>/dev/null)"
    fi
    [ -n "$diff" ] && [ -n "$names" ] || exit 0

    local findings=""

    local deleted retired="" f
    deleted="$(printf '%s\n' "$names" | awk '$1 ~ /^D/ {print $2}' | grep -E "$TEST_PATH_RE" | sort -u || true)"
    if [ -n "$deleted" ]; then
        local patterns kept=""
        patterns="$(retired_patterns "$base")"
        while IFS= read -r f; do
            if [ -n "$patterns" ] && is_retired "$f" "$patterns"; then
                retired="${retired}${f}
"
            else
                kept="${kept}${f}
"
            fi
        done <<< "$deleted"
        deleted="${kept%$'\n'}"
    fi
    if [ -n "$deleted" ]; then
        findings="${findings}Deleted test files:
$(printf '%s\n' "$deleted" | sed 's/^/  - /')
"
    fi

    # Only lines added to test files count: a skip marker in a hook, a regex or a doc is not a
    # skipped test. ENVIRON keeps the regex's backslashes intact (awk -v would eat them).
    local skips
    skips="$(printf '%s\n' "$diff" \
        | TEST_PATH_RE="$TEST_PATH_RE" awk 'BEGIN { re = ENVIRON["TEST_PATH_RE"] }
            /^\+\+\+ / { intest = (substr($0, 7) ~ re); next }
            intest && /^\+/' \
        | grep -E "$SKIP_ADD_RE" | sed 's/^+[[:space:]]*//' | sort -u | head -20 || true)"
    if [ -n "$skips" ]; then
        findings="${findings}Added skipped or focused tests:
$(printf '%s\n' "$skips" | sed 's/^/  + /')
"
    fi

    if [ -z "$findings" ]; then
        # Approved retirements pass, but stay visible so the reviewer sees them.
        [ -n "$retired" ] && printf 'guard: deleted test files retired via %s:\n%s\n' \
            "$RETIRED_LEDGER" "$(printf '%s' "$retired" | sed 's/^/  - /')" >&2
        exit 0
    fi

    local retire_hint
    if [ "${AISDLC_HEADLESS:-0}" = "1" ]; then
        retire_hint="A test that is genuinely obsolete or moved by a refactor is retired by a human: an entry
'<path-or-glob> <reason>' in ${RETIRED_LEDGER}, committed on the default branch before the run.
An unattended session cannot add that entry for itself."
    else
        retire_hint="If a deleted test is genuinely obsolete or was folded into another by a refactor, record it
in ${RETIRED_LEDGER} as '<path-or-glob> <reason>' — the entry is a human decision and shows in
the PR diff. Skipped or focused tests are never retired this way."
    fi

    if [ "$reentered" = "true" ]; then
        printf 'guard: test-weakening findings are still present:\n%s\nRecord them in the PR body or BLOCKED.md — they will not pass review.\n' "$findings" >&2
        exit 0
    fi

    # On Grok, Stop hooks are passive: emit an advisory to stderr and exit 0.
    # Claude/Codex retain the blocking exit-2 behavior via deny().
    if [ -n "$IS_GROK" ]; then
        printf 'guard [advisory]: this session weakened the test suite.\n\n%s\nRestore the tests and make them pass.\n\nIf a test genuinely contradicts the spec, that is a decision for a human — stop and report the\ncontradiction (unattended runs: write specs/<TICKET>/BLOCKED.md and exit non-zero) instead of\nremoving the test.\n\n%s\n' "$findings" "$retire_hint" >&2
        exit 0
    fi

    deny "guard: this session weakened the test suite.

${findings}
The dense-testing non-negotiables: never delete a test, skip a test, or loosen an assertion to
get a green run. Restore them and make them pass.

If a test genuinely contradicts the spec, that is a decision for a human — stop and report the
contradiction (unattended runs: write specs/<TICKET>/BLOCKED.md and exit non-zero) instead of
removing the test.

${retire_hint}"
}

case "$MODE" in
    pre-bash) pre_bash ;;
    stop)     stop_check ;;
    *)        echo "guard: unknown mode '${MODE}' — allowing" >&2; exit 0 ;;
esac

exit 0
