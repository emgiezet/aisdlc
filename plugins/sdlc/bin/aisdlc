#!/usr/bin/env bash
# aisdlc — fire-and-forget queue for the AI SDLC pipeline.
#
# Queues approved specs, runs each one in its own git worktree through
# /sdlc:implement → /sdlc:qa → /sdlc:ship as headless `claude -p` calls, and leaves the
# results as draft PRs so the pull request list is the review inbox.
#
#   aisdlc add ABC-123 [--repo .] [--model sonnet] [--budget 5] [--base origin/main]
#   aisdlc run [--workers 3] [--once]
#   aisdlc status | inbox | logs <id> | retry <id> | cancel <id> | clean
#
# Requires: git >= 2.31, jq, flock, claude. gh is optional (without it, ship falls back to
# writing the PR body to a file).
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
MANIFEST="${PLUGIN_ROOT}/.claude-plugin/plugin.json"

# Read identity from the manifest rather than carrying copies that drift. The plugin name
# is also the command namespace, so nothing here has to know it is called "sdlc".
manifest_field() {
    sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$MANIFEST" 2>/dev/null | head -1
}
VERSION="$(manifest_field version)"; [ -n "$VERSION" ] || VERSION="unknown"
PLUGIN_NAME="$(manifest_field name)";  [ -n "$PLUGIN_NAME" ] || PLUGIN_NAME="sdlc"

ALL_PHASES="implement qa ship"

# Built-in defaults. Precedence: CLI flag > .aisdlc/config.json > environment > these.
BUILTIN_MODEL="sonnet"
BUILTIN_BUDGET="5"
BUILTIN_WORKERS="3"
BUILTIN_LABEL="ai-sdlc"
BUILTIN_SPECS_DIR="specs"

# --------------------------------------------------------------------------- #
# plumbing
# --------------------------------------------------------------------------- #

die() { printf 'aisdlc: %s\n' "$1" >&2; exit "${2:-1}"; }
say() { printf '%s\n' "$1"; }
ts()  { date -u +%Y-%m-%dT%H:%M:%SZ; }

need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed"; }

# jq write-in-place on a JSON file: jset <file> <filter> [args…]
jset() {
    local file="$1"; shift
    local tmp="${file}.tmp.$$"
    jq "$@" "$file" > "$tmp" && mv "$tmp" "$file"
}

resolve_repo() {
    local candidate="${1:-.}"
    [ -d "$candidate" ] || die "no such directory: $candidate"
    git -C "$candidate" rev-parse --show-toplevel 2>/dev/null \
        || die "not a git repository: $candidate"
}

# Default base ref: whichever of these exists first.
detect_base() {
    local repo="$1" ref
    for ref in origin/master origin/main master main; do
        if git -C "$repo" rev-parse --verify --quiet "$ref" >/dev/null 2>&1; then
            printf '%s' "$ref"; return 0
        fi
    done
    die "cannot detect a base ref in $repo — pass --base <ref>"
}

state_dir() { printf '%s/.aisdlc' "$1"; }

# Per-repo defaults, written by /sdlc:init and editable by hand. Reading a key that is
# absent prints nothing, so callers can chain fallbacks. Kept separate from
# .claude/sdlc.md, which is the project profile the *agents* read.
cfg() {
    local repo="$1" key="$2" file
    file="$(state_dir "$repo")/config.json"
    [ -f "$file" ] || return 0
    jq -r --arg k "$key" '.[$k] // empty | tostring' "$file" 2>/dev/null
}

# CLI flag (already in $3 if given) > config.json > environment > built-in.
resolve_default() {
    local repo="$1" key="$2" given="$3" env_value="$4" builtin="$5" value
    [ -n "$given" ] && { printf '%s' "$given"; return 0; }
    value="$(cfg "$repo" "$key")"
    [ -n "$value" ] && { printf '%s' "$value"; return 0; }
    [ -n "$env_value" ] && { printf '%s' "$env_value"; return 0; }
    printf '%s' "$builtin"
}

init_state() {
    local repo="$1" dir
    dir="$(state_dir "$repo")"
    mkdir -p "$dir/tasks"
    [ -f "$dir/queue.jsonl" ] || : > "$dir/queue.jsonl"
    [ -f "$dir/queue.lock" ]  || : > "$dir/queue.lock"

    # Keep the queue out of the repo without touching the project's .gitignore.
    # --git-dir can be relative to $repo, and in a linked worktree it is not where
    # info/exclude lives — resolve the common dir as an absolute path.
    local gitdir exclude
    gitdir="$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
    [ -d "$gitdir" ] || gitdir="$(cd "$repo" && cd "$(git rev-parse --git-common-dir)" && pwd)"
    exclude="$gitdir/info/exclude"
    mkdir -p "$gitdir/info"
    grep -qxF '/.aisdlc/' "$exclude" 2>/dev/null || echo '/.aisdlc/' >> "$exclude"

    # Permissions handed to every headless run.
    #
    # The allow list exists because an unattended phase that stops to ask is a stalled task
    # that looks like a slow one. Editing files and using git is the entire job here, and it
    # happens inside a throwaway worktree, so granting it is bounded rather than reckless.
    # Do not rely on the developer's personal allow list: it varies, and a phase that commits
    # with double quotes where their rule expected single ones fails for no defensible reason.
    #
    # The deny list is the floor and takes precedence over the allow list. The guard hook is
    # the primary defence; this is the belt to its braces.
    #
    # Written once, then yours to edit. If a phase stalls asking to run this project's test
    # command, add it here — e.g. "Bash(make:*)", "Bash(npm:*)", "Bash(go:*)".
    if [ ! -f "$dir/settings.json" ]; then
        cat > "$dir/settings.json" <<'JSON'
{
  "permissions": {
    "allow": [
      "Write",
      "Edit",
      "Bash(git:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git reset --hard origin/*)",
      "Write(.claude/**)",
      "Edit(.claude/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/credentials*)",
      "Read(**/id_rsa*)"
    ]
  }
}
JSON
    fi
}

task_dir()  { printf '%s/tasks/%s' "$(state_dir "$1")" "$2"; }
task_file() { printf '%s/task.json' "$(task_dir "$1" "$2")"; }

task_get() { jq -r "$2 // empty" "$(task_file "$1" "$3")" 2>/dev/null; }

task_set() {
    local repo="$1" id="$2"; shift 2
    jset "$(task_file "$repo" "$id")" "$@"
}

set_status() {
    task_set "$1" "$2" --arg s "$3" --arg t "$(ts)" '.status = $s | .updated = $t'
}

# --------------------------------------------------------------------------- #
# spec gate — the queue refuses anything a human has not approved
# --------------------------------------------------------------------------- #

spec_status() {
    local spec="$1"
    [ -f "$spec" ] || { printf 'missing'; return; }
    # Frontmatter status: read only the leading --- block.
    awk 'NR==1 && $0 != "---" {exit} NR>1 && $0=="---" {exit} /^status:[[:space:]]*/ {
        sub(/^status:[[:space:]]*/, ""); gsub(/[[:space:]"'"'"']/, ""); print; exit }' "$spec"
}

spec_open_questions() {
    # Unchecked boxes anywhere in the spec block execution.
    grep -cE '^[[:space:]]*-[[:space:]]*\[[[:space:]]\]' "$1" 2>/dev/null || true
}

check_spec() {
    local spec="$1" status open
    status="$(spec_status "$spec")"
    case "$status" in
        missing)  printf 'no spec at %s — run /%s:spec first' "$spec" "$PLUGIN_NAME"; return 1 ;;
        approved) ;;
        "")       printf 'spec has no status: field — expected status: approved'; return 1 ;;
        *)        printf 'spec is status: %s — a human must approve it' "$status"; return 1 ;;
    esac
    open="$(spec_open_questions "$spec")"
    if [ "${open:-0}" -gt 0 ]; then
        printf '%s unresolved open question(s) in the spec' "$open"; return 1
    fi
    return 0
}

# --------------------------------------------------------------------------- #
# add
# --------------------------------------------------------------------------- #

cmd_add() {
    # Empty means "not given on the command line" — resolve_default fills these in once the
    # repo is known, since the config file lives inside it.
    local ticket="" repo="." model="" budget="" base="" phases=""
    local no_pr=0 plugin_dir=0 force=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --repo)       repo="$2"; shift 2 ;;
            --model)      model="$2"; shift 2 ;;
            --budget)     budget="$2"; shift 2 ;;
            --base)       base="$2"; shift 2 ;;
            --phase|--phases) phases="$(printf '%s' "$2" | tr ',' ' ')"; shift 2 ;;
            --no-pr)      no_pr=1; shift ;;
            --plugin-dir) plugin_dir=1; shift ;;
            --force)      force=1; shift ;;
            -*)           die "unknown flag for add: $1" ;;
            *)            ticket="$1"; shift ;;
        esac
    done
    [ -n "$ticket" ] || die "usage: aisdlc add <TICKET> [--repo .] [--model sonnet] [--budget 5]"

    repo="$(resolve_repo "$repo")"
    init_state "$repo"

    model="$(resolve_default "$repo" model "$model" "${AISDLC_MODEL:-}" "$BUILTIN_MODEL")"
    budget="$(resolve_default "$repo" budget "$budget" "${AISDLC_BUDGET:-}" "$BUILTIN_BUDGET")"
    base="$(resolve_default "$repo" base "$base" "${AISDLC_BASE:-}" "")"
    [ -n "$base" ] || base="$(detect_base "$repo")"
    [ -n "$phases" ] || phases="$ALL_PHASES"

    local specs_dir
    specs_dir="$(resolve_default "$repo" specs_dir "" "${AISDLC_SPECS_DIR:-}" "$BUILTIN_SPECS_DIR")"

    local spec="$repo/$specs_dir/$ticket/spec.md" reason
    if ! reason="$(check_spec "$spec")"; then
        if [ "$force" -eq 1 ]; then
            say "aisdlc: WARNING — $reason (queued anyway because of --force)"
        else
            die "$reason"
        fi
    fi

    [ "$no_pr" -eq 1 ] && phases="${phases// ship/}"

    local id slug
    slug="$(printf '%s' "$ticket" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/-*$//')"
    id="${slug}-$(date +%Y%m%d-%H%M%S)-${RANDOM}"

    local dir; dir="$(task_dir "$repo" "$id")"
    mkdir -p "$dir"
    jq -n --arg id "$id" --arg ticket "$ticket" --arg repo "$repo" --arg model "$model" \
          --arg base "$base" --arg phases "$phases" --arg t "$(ts)" --arg sd "$specs_dir" \
          --argjson budget "$budget" --argjson no_pr "$no_pr" --argjson plugin_dir "$plugin_dir" \
          '{id:$id, ticket:$ticket, repo:$repo, model:$model, base:$base, specs_dir:$sd,
            phases:($phases|split(" ")|map(select(length>0))), budget:$budget,
            no_pr:($no_pr==1), plugin_dir:($plugin_dir==1), status:"queued",
            attempts:0, cost_usd:0, created:$t, updated:$t,
            branch:null, worktree:null, pr_url:null, error:null}' > "$dir/task.json"

    flock "$(state_dir "$repo")/queue.lock" \
        bash -c "printf '%s\n' \"$id\" >> \"$(state_dir "$repo")/queue.jsonl\""

    say "queued $id  ($ticket → $model, budget \$$budget, phases: $phases)"
    say "run it:  aisdlc run --repo $repo"
}

# --------------------------------------------------------------------------- #
# run
# --------------------------------------------------------------------------- #

# Atomically take the first queued id, or print nothing when the queue is empty.
pop_task() {
    local repo="$1" dir; dir="$(state_dir "$repo")"
    flock "$dir/queue.lock" bash -c '
        q="$1/queue.jsonl"
        [ -s "$q" ] || exit 0
        head -n 1 "$q"
        tail -n +2 "$q" > "$q.tmp" && mv "$q.tmp" "$q"
    ' _ "$dir"
}

# Make sure the worktree has the spec, committing it if the base ref predates it.
seed_spec() {
    local repo="$1" wt="$2" ticket="$3" log="$4" specs_dir="$5"
    [ -f "$wt/$specs_dir/$ticket/spec.md" ] && return 0
    [ -f "$repo/$specs_dir/$ticket/spec.md" ] || return 1
    printf '[%s] spec not in %s — copying it from the working repo and committing it\n' \
        "$(ts)" "$(git -C "$wt" rev-parse --abbrev-ref HEAD)" >> "$log"
    mkdir -p "$wt/$specs_dir"
    cp -R "$repo/$specs_dir/$ticket" "$wt/$specs_dir/"
    git -C "$wt" add "$specs_dir/$ticket" >> "$log" 2>&1
    git -C "$wt" -c user.name="aisdlc" -c user.email="aisdlc@localhost" \
        commit -q -m "docs(spec): add spec for $ticket" >> "$log" 2>&1
}

# One headless invocation. Prints nothing; writes $out and appends to $log.
invoke_claude() {
    local prompt="$1" model="$2" budget="$3" settings="$4" wt="$5" out="$6" log="$7" use_plugin_dir="$8"

    local -a args=(
        -p "$prompt"
        --model "$model"
        --fallback-model sonnet
        --permission-mode bypassPermissions
        --settings "$settings"
        --max-budget-usd "$budget"
        --output-format json
    )
    [ "$use_plugin_dir" = "true" ] && args+=(--plugin-dir "$PLUGIN_ROOT")

    printf '[%s] === claude -p "%s" (model %s, budget $%s)\n' "$(ts)" "$prompt" "$model" "$budget" >> "$log"
    local rc=0
    # stdin from /dev/null is load-bearing: the phase loop feeds itself from a process
    # substitution, and claude reads stdin, so without this it swallows the remaining
    # phases and the task silently ships having run only the first one.
    ( cd "$wt" && claude "${args[@]}" < /dev/null ) > "$out" 2>> "$log" || rc=$?
    return $rc
}

run_phase() {
    local repo="$1" id="$2" phase="$3" wt="$4" ticket="$5"
    local dir; dir="$(task_dir "$repo" "$id")"
    local log="$dir/${phase}.log" out="$dir/${phase}.json"
    local model budget plugin_dir settings
    model="$(task_get "$repo" .model "$id")"
    budget="$(task_get "$repo" .budget "$id")"
    plugin_dir="$(task_get "$repo" .plugin_dir "$id")"
    settings="$(state_dir "$repo")/settings.json"

    # Commands loaded from --plugin-dir are namespaced (/sdlc:qa); an installed plugin also
    # answers to the bare name. Guessing wrong is free to detect — the CLI rejects an unknown
    # command locally, with no tokens spent — so try the likely form, then the other. The
    # namespace comes from the manifest, so renaming the plugin needs no change here.
    local primary alternate
    if [ "$plugin_dir" = "true" ]; then
        primary="/${PLUGIN_NAME}:${phase} ${ticket}"
        alternate="/${phase} ${ticket}"
    else
        primary="/${phase} ${ticket}"
        alternate="/${PLUGIN_NAME}:${phase} ${ticket}"
    fi

    local rc=0
    invoke_claude "$primary" "$model" "$budget" "$settings" "$wt" "$out" "$log" "$plugin_dir" || rc=$?
    if grep -q '"result":"Unknown command' "$out" 2>/dev/null; then
        printf '[%s] %s not registered — retrying as "%s"\n' "$(ts)" "${primary%% *}" "${alternate%% *}" >> "$log"
        rc=0
        invoke_claude "$alternate" "$model" "$budget" "$settings" "$wt" "$out" "$log" "$plugin_dir" || rc=$?
    fi

    # Fold this phase's cost into the task total, whatever the outcome.
    local cost
    cost="$(jq -r '(.total_cost_usd // .cost_usd // 0) | tostring' "$out" 2>/dev/null || echo 0)"
    case "$cost" in ''|*[!0-9.]*) cost=0 ;; esac
    # Round on every accumulation: three phases of float addition otherwise reports $0.19119999999999998.
    task_set "$repo" "$id" --argjson c "${cost:-0}" \
        '.cost_usd = (((((.cost_usd // 0) + $c) * 10000) | round) / 10000)'

    # The transcript is the useful part of the log; keep it readable.
    jq -r '.result // empty' "$out" >> "$log" 2>/dev/null || true

    local is_error turns
    is_error="$(jq -r '.is_error // false' "$out" 2>/dev/null || echo unknown)"
    turns="$(jq -r '.num_turns // 0' "$out" 2>/dev/null || echo 0)"

    # A phase that took no turns did nothing — an unregistered command, a rejected prompt, or
    # an immediate budget stop. The CLI reports that as success, so check it explicitly: a
    # silent no-op that reads as "done" is the worst possible outcome for an unattended queue.
    if [ "${turns:-0}" -eq 0 ]; then
        printf '[%s] %s FAILED — the model never ran (0 turns): %s\n' \
            "$(ts)" "$phase" "$(jq -r '.result // "no result"' "$out" 2>/dev/null)" >> "$log"
        return 1
    fi
    if [ "$rc" -ne 0 ] || [ "$is_error" = "true" ]; then
        printf '[%s] %s FAILED (exit %s, is_error %s)\n' "$(ts)" "$phase" "$rc" "$is_error" >> "$log"
        return 1
    fi
    printf '[%s] %s ok (%s turns)\n' "$(ts)" "$phase" "$turns" >> "$log"
    return 0
}

execute_task() {
    local repo="$1" id="$2"
    local ticket base wt branch dir specs_dir
    dir="$(task_dir "$repo" "$id")"
    ticket="$(task_get "$repo" .ticket "$id")"
    base="$(task_get "$repo" .base "$id")"
    specs_dir="$(task_get "$repo" .specs_dir "$id")"
    [ -n "$specs_dir" ] || specs_dir="$BUILTIN_SPECS_DIR"
    branch="ai/${ticket}-${id##*-}"
    wt="$(dirname "$repo")/.aisdlc-worktrees/$(basename "$repo")-${id}"

    local log="$dir/run.log"
    task_set "$repo" "$id" --arg b "$branch" --arg w "$wt" --arg t "$(ts)" \
        '.branch = $b | .worktree = $w | .started = $t | .attempts = ((.attempts // 0) + 1)'
    set_status "$repo" "$id" running

    printf '[%s] task %s (%s) base=%s branch=%s\n' "$(ts)" "$id" "$ticket" "$base" "$branch" >> "$log"

    if ! git -C "$repo" worktree add -b "$branch" "$wt" "$base" >> "$log" 2>&1; then
        task_set "$repo" "$id" --arg e "worktree creation failed — see run.log" '.error = $e'
        set_status "$repo" "$id" failed
        say "  ✗ $id — could not create worktree"
        return 1
    fi

    if ! seed_spec "$repo" "$wt" "$ticket" "$log" "$specs_dir"; then
        task_set "$repo" "$id" --arg e "no spec for $ticket in the worktree or the repo" '.error = $e'
        set_status "$repo" "$id" failed
        say "  ✗ $id — spec missing"
        return 1
    fi

    # Re-gate inside the worktree: the committed spec is what the agent will actually read.
    local reason
    if ! reason="$(check_spec "$wt/$specs_dir/$ticket/spec.md")"; then
        printf '[%s] refused before invoking the model: %s\n' "$(ts)" "$reason" >> "$log"
        task_set "$repo" "$id" --arg e "$reason" '.error = $e'
        set_status "$repo" "$id" refused
        say "  ⊘ $id — $reason"
        git -C "$repo" worktree remove --force "$wt" >> "$log" 2>&1
        return 1
    fi

    # Read the phase list up front rather than streaming it into the loop: whatever runs
    # inside must not be able to consume the list it is iterating over.
    local phase failed="" phase_list
    phase_list="$(jq -r '.phases[]' "$(task_file "$repo" "$id")")"
    while read -r phase; do
        [ -n "$phase" ] || continue
        say "  → $id: $phase"
        if ! run_phase "$repo" "$id" "$phase" "$wt" "$ticket"; then
            failed="$phase"; break
        fi
    done <<< "$phase_list"

    if [ -n "$failed" ]; then
        local hint=""
        [ -f "$wt/$specs_dir/$ticket/BLOCKED.md" ] && hint=" (BLOCKED.md written)"
        task_set "$repo" "$id" --arg e "phase '$failed' failed$hint" '.error = $e'
        set_status "$repo" "$id" failed
        say "  ✗ $id — $failed failed$hint · worktree kept at $wt"
        say "    aisdlc logs $id"
        return 1
    fi

    # Collect the artifacts a human will want, then release the worktree.
    [ -f "$wt/$specs_dir/$ticket/qa-report.md" ] && cp "$wt/$specs_dir/$ticket/qa-report.md" "$dir/"
    [ -f "$wt/$specs_dir/$ticket/pr-body.md" ]   && cp "$wt/$specs_dir/$ticket/pr-body.md" "$dir/"
    git -C "$wt" diff "$base"...HEAD > "$dir/changes.diff" 2>/dev/null || true

    local pr_url
    pr_url="$(git -C "$wt" log -1 --pretty=%B 2>/dev/null | grep -oE 'https://[^ ]*/pull/[0-9]+' | head -1 || true)"
    [ -z "$pr_url" ] && pr_url="$(grep -ohE 'https://[^ )]*/pull/[0-9]+' "$dir"/ship.log 2>/dev/null | head -1 || true)"
    [ -n "$pr_url" ] && task_set "$repo" "$id" --arg u "$pr_url" '.pr_url = $u'

    set_status "$repo" "$id" "done"
    local cost; cost="$(task_get "$repo" .cost_usd "$id")"
    say "  ✓ $id — done (\$${cost:-?})${pr_url:+ · $pr_url}"

    if [ "$(task_get "$repo" .no_pr "$id")" = "true" ]; then
        say "    --no-pr: diff and QA report in $dir"
        git -C "$repo" worktree remove --force "$wt" >/dev/null 2>&1 || true
    else
        git -C "$repo" worktree remove --force "$wt" >/dev/null 2>&1 \
            || say "    note: worktree still at $wt (uncommitted changes)"
    fi
    return 0
}

cmd_run() {
    local repo="." workers="" once=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --repo)    repo="$2"; shift 2 ;;
            --workers) workers="$2"; shift 2 ;;
            --once)    once=1; workers=1; shift ;;
            -*)        die "unknown flag for run: $1" ;;
            *)         die "run takes no positional arguments" ;;
        esac
    done
    need claude
    repo="$(resolve_repo "$repo")"
    init_state "$repo"
    [ "$once" -eq 1 ] || workers="$(resolve_default "$repo" workers "$workers" "${AISDLC_WORKERS:-}" "$BUILTIN_WORKERS")"

    local pending
    pending="$(wc -l < "$(state_dir "$repo")/queue.jsonl" | tr -d ' ')"
    [ "${pending:-0}" -gt 0 ] || { say "queue is empty"; return 0; }

    say "aisdlc $VERSION — $pending queued, $workers worker(s)$([ "$once" -eq 1 ] && echo ', single task')"

    local -a pids=()
    trap 'say "interrupted — finishing current phases"; kill -TERM "${pids[@]}" 2>/dev/null; wait; exit 130' INT TERM

    for _ in $(seq 1 "$workers"); do
        (
            while :; do
                local id
                id="$(pop_task "$repo")"
                [ -n "$id" ] || break
                execute_task "$repo" "$id" || true
                [ "$once" -eq 1 ] && break
            done
        ) &
        pids+=("$!")
    done
    wait

    say ""
    cmd_status --repo "$repo"
}

# --------------------------------------------------------------------------- #
# reporting
# --------------------------------------------------------------------------- #

each_task() {
    local repo="$1" f
    for f in "$(state_dir "$repo")"/tasks/*/task.json; do
        [ -f "$f" ] || continue
        printf '%s\n' "$f"
    done
}

cmd_status() {
    local repo="."
    while [ $# -gt 0 ]; do
        case "$1" in --repo) repo="$2"; shift 2 ;; *) shift ;; esac
    done
    repo="$(resolve_repo "$repo")"
    [ -d "$(state_dir "$repo")" ] || { say "no queue in $repo"; return 0; }

    local queued; queued="$(wc -l < "$(state_dir "$repo")/queue.jsonl" 2>/dev/null | tr -d ' ')"
    printf '%-34s %-9s %-6s %8s  %s\n' TASK STATUS PHASES COST NOTE
    local f
    while read -r f; do
        [ -n "$f" ] || continue
        # Phases as initials (i·q·s) so the column stays aligned on a narrow terminal.
        jq -r '[.id, .status, (.phases | map(.[0:1]) | join("·")), ((.cost_usd//0)|tostring),
                (.pr_url // .error // "")] | @tsv' "$f" 2>/dev/null \
        | while IFS=$'\t' read -r id st ph cost note; do
            printf '%-34s %-9s %-6s %8s  %s\n' "$id" "$st" "$ph" "\$$cost" "${note:0:56}"
          done
    done < <(each_task "$repo")

    local total
    total="$(each_task "$repo" | xargs -r jq -s \
        '(map(.cost_usd // 0) | add // 0) * 100 | round / 100' 2>/dev/null || echo 0)"
    printf '\n%s still queued · total spend $%s\n' "${queued:-0}" "$total"
}

cmd_inbox() {
    local repo="."
    while [ $# -gt 0 ]; do
        case "$1" in --repo) repo="$2"; shift 2 ;; *) shift ;; esac
    done
    repo="$(resolve_repo "$repo")"

    local label
    label="$(resolve_default "$repo" label "" "${AISDLC_LABEL:-}" "$BUILTIN_LABEL")"

    say "== Ready for review =="
    if command -v gh >/dev/null 2>&1; then
        gh pr list --repo "$(git -C "$repo" remote get-url origin 2>/dev/null || echo '')" \
            --label "$label" --state open \
            --json number,title,url,isDraft,createdAt \
            --template '{{range .}}{{printf "#%v  %s\n    %s\n" .number .title .url}}{{end}}' \
            2>/dev/null || say "  (gh could not list PRs — check auth or the $label label)"
    else
        say "  (gh not installed — see the per-task artifacts below)"
    fi

    say ""
    say "== Needs you =="
    local f found=0
    while read -r f; do
        [ -n "$f" ] || continue
        local st; st="$(jq -r '.status' "$f")"
        case "$st" in
            failed|refused)
                found=1
                jq -r '"  \(.status | ascii_upcase)  \(.id)\n    \(.error // "no reason recorded")\n    logs: aisdlc logs \(.id)"' "$f"
                ;;
        esac
    done < <(each_task "$repo")
    [ "$found" -eq 0 ] && say "  nothing blocked"
}

cmd_logs() {
    local repo="." id=""
    while [ $# -gt 0 ]; do
        case "$1" in --repo) repo="$2"; shift 2 ;; -*) shift ;; *) id="$1"; shift ;; esac
    done
    [ -n "$id" ] || die "usage: aisdlc logs <id>"
    repo="$(resolve_repo "$repo")"
    local dir; dir="$(task_dir "$repo" "$id")"
    [ -d "$dir" ] || die "no such task: $id"

    jq . "$dir/task.json"
    local f
    for f in "$dir"/run.log "$dir"/implement.log "$dir"/qa.log "$dir"/ship.log; do
        [ -f "$f" ] || continue
        printf '\n===== %s =====\n' "$(basename "$f")"
        cat "$f"
    done
    [ -f "$dir/qa-report.md" ] && { printf '\n===== qa-report.md =====\n'; cat "$dir/qa-report.md"; }
    return 0
}

cmd_retry() {
    local repo="." id=""
    while [ $# -gt 0 ]; do
        case "$1" in --repo) repo="$2"; shift 2 ;; -*) shift ;; *) id="$1"; shift ;; esac
    done
    [ -n "$id" ] || die "usage: aisdlc retry <id>"
    repo="$(resolve_repo "$repo")"
    local dir; dir="$(task_dir "$repo" "$id")"
    [ -d "$dir" ] || die "no such task: $id"

    # A retry starts from a clean worktree: the old one is evidence that has been read.
    local wt; wt="$(task_get "$repo" .worktree "$id")"
    if [ -n "$wt" ] && [ -d "$wt" ]; then
        git -C "$repo" worktree remove --force "$wt" >/dev/null 2>&1 \
            || die "could not remove $wt — inspect it, then remove it manually"
    fi
    local branch; branch="$(task_get "$repo" .branch "$id")"
    [ -n "$branch" ] && git -C "$repo" branch -D "$branch" >/dev/null 2>&1

    set_status "$repo" "$id" queued
    task_set "$repo" "$id" '.error = null | .worktree = null | .branch = null'
    flock "$(state_dir "$repo")/queue.lock" \
        bash -c "printf '%s\n' \"$id\" >> \"$(state_dir "$repo")/queue.jsonl\""
    say "re-queued $id"
}

cmd_cancel() {
    local repo="." id=""
    while [ $# -gt 0 ]; do
        case "$1" in --repo) repo="$2"; shift 2 ;; -*) shift ;; *) id="$1"; shift ;; esac
    done
    [ -n "$id" ] || die "usage: aisdlc cancel <id>"
    repo="$(resolve_repo "$repo")"
    local dir; dir="$(state_dir "$repo")"
    [ -d "$(task_dir "$repo" "$id")" ] || die "no such task: $id"

    flock "$dir/queue.lock" bash -c '
        grep -vxF "$2" "$1/queue.jsonl" > "$1/queue.jsonl.tmp" || true
        mv "$1/queue.jsonl.tmp" "$1/queue.jsonl"
    ' _ "$dir" "$id"
    set_status "$repo" "$id" cancelled
    say "cancelled $id (a running phase finishes on its own)"
}

cmd_clean() {
    local repo="." all=0
    while [ $# -gt 0 ]; do
        case "$1" in --repo) repo="$2"; shift 2 ;; --all) all=1; shift ;; *) shift ;; esac
    done
    repo="$(resolve_repo "$repo")"

    local removed=0 f
    while read -r f; do
        [ -n "$f" ] || continue
        local st id; st="$(jq -r '.status' "$f")"; id="$(jq -r '.id' "$f")"
        if [ "$st" = "done" ] || [ "$st" = "cancelled" ] || { [ "$all" -eq 1 ] && [ "$st" != "running" ]; }; then
            local wt; wt="$(jq -r '.worktree // empty' "$f")"
            [ -n "$wt" ] && [ -d "$wt" ] && git -C "$repo" worktree remove --force "$wt" >/dev/null 2>&1
            rm -rf "$(dirname "$f")"
            removed=$((removed + 1))
        fi
    done < <(each_task "$repo")

    git -C "$repo" worktree prune
    say "removed $removed task record(s)$([ "$all" -eq 1 ] && echo ' (--all: including failed ones)')"
    say "kept: running tasks$([ "$all" -eq 0 ] && echo ', and failed ones — they are your evidence')"
}

cmd_help() {
    cat <<USAGE
aisdlc $VERSION — fire-and-forget queue for the AI SDLC pipeline

  aisdlc add <TICKET> [flags]   queue an approved spec
      --repo <path>     target repository (default: .)
      --model <name>    haiku | sonnet | opus (default: $BUILTIN_MODEL)
      --budget <usd>    hard spend cap per phase (default: $BUILTIN_BUDGET)
      --base <ref>      branch off this ref (default: origin/master, then origin/main)
      --phase <list>    subset of implement,qa,ship (default: all three)
      --no-pr           stop after qa; write the diff and QA report to the task dir
      --plugin-dir      load the plugin from this checkout (repos without it installed)
      --force           queue despite a draft spec or open questions (not recommended)

  aisdlc run [flags]            execute the queue
      --workers <n>     concurrent tasks (default: $BUILTIN_WORKERS)
      --once            run a single task, then exit

  aisdlc status                 one line per task, with spend
  aisdlc inbox                  open PRs carrying the queue label, plus what is blocked
  aisdlc logs <id>              task state, phase logs, QA report
  aisdlc retry <id>             discard the worktree and re-queue
  aisdlc cancel <id>            drop a queued task
  aisdlc clean [--all]          remove finished task records and stale worktrees

How it works: one git worktree per task, branched off <base>, then three headless
\`claude -p\` calls (/$PLUGIN_NAME:implement → :qa → :ship) with a fresh context each.
Success leaves a draft PR labelled \`$BUILTIN_LABEL\`. Failure keeps the worktree so you
can read what happened.

The spec gate is not negotiable: status must be \`approved\` with no open questions, checked
both when queueing and again inside the worktree before the model is invoked.

Defaults resolve as: CLI flag > .aisdlc/config.json > environment > built-in. Write the
config with /$PLUGIN_NAME:init, or by hand:

  .aisdlc/config.json   {"model":"haiku","budget":3,"base":"origin/main",
                         "workers":4,"label":"$BUILTIN_LABEL","specs_dir":"$BUILTIN_SPECS_DIR"}

Environment overrides: AISDLC_MODEL, AISDLC_BUDGET, AISDLC_BASE, AISDLC_WORKERS,
AISDLC_LABEL, AISDLC_SPECS_DIR.

.aisdlc/settings.json is the permission set each headless phase runs under: editing files
and using git are allowed because that is the job, force pushes and secrets are denied,
and .claude/** is denied because a queued task has no business rewriting your agent
configuration. Written once, then yours. If a phase stalls asking to run this project's
test command, add it — e.g. "Bash(make:*)".
USAGE
}

# --------------------------------------------------------------------------- #

need git; need jq; need flock

case "${1:-help}" in
    add)            shift; cmd_add "$@" ;;
    run)            shift; cmd_run "$@" ;;
    status|ls)      shift; cmd_status "$@" ;;
    inbox)          shift; cmd_inbox "$@" ;;
    logs|log)       shift; cmd_logs "$@" ;;
    retry)          shift; cmd_retry "$@" ;;
    cancel)         shift; cmd_cancel "$@" ;;
    clean)          shift; cmd_clean "$@" ;;
    version|--version) say "aisdlc $VERSION" ;;
    help|--help|-h) cmd_help ;;
    *)              die "unknown command '$1' — try: aisdlc help" ;;
esac
