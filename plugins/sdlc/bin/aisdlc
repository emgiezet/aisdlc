#!/usr/bin/env bash
# aisdlc — fire-and-forget queue for the AI SDLC pipeline.
#
# Queues approved specs, runs each one in its own git worktree through
# /sdlc:implement → /sdlc:qa → /sdlc:ship as headless `claude -p` calls, and leaves the
# results as draft PRs so the pull request list is the review inbox.
#
#   aisdlc add ABC-123 [--repo .] [--model sonnet] [--budget 5] [--base origin/main]
#   aisdlc run [--workers 3] [--once]
#   aisdlc status | inbox | logs <id> | retry <id> | cancel <id> | clean
#
# Requires: git >= 2.31, jq, flock, claude. gh is optional (without it, ship falls back to
# writing the PR body to a file).
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
MANIFEST="${PLUGIN_ROOT}/.claude-plugin/plugin.json"

# Read identity from the manifest rather than carrying copies that drift. The plugin name
# is also the command namespace, so nothing here has to know it is called "sdlc".
manifest_field() {
    sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$MANIFEST" 2>/dev/null | head -1
}
VERSION="$(manifest_field version)"; [ -n "$VERSION" ] || VERSION="unknown"
PLUGIN_NAME="$(manifest_field name)";  [ -n "$PLUGIN_NAME" ] || PLUGIN_NAME="sdlc"

ALL_PHASES="implement qa scope-check verify ship review"
ISSUE_PHASES="triage root-cause implement qa scope-check verify ship review"

# Built-in defaults. Precedence: CLI flag > .aisdlc/config.json > environment > these.
BUILTIN_MODEL="sonnet"
BUILTIN_BUDGET="5"
BUILTIN_WORKERS="3"
BUILTIN_LABEL="ai-sdlc"
BUILTIN_SPECS_DIR="specs"
BUILTIN_BILLING="api"
BUILTIN_RUNTIME="auto"

# The CLI that runs each phase. claude is `claude -p`; omp is `omp -p --mode json`, which loads
# this plugin through --plugin-dir and expands /<plugin>:<phase> itself. auto is resolved once,
# at add: the first of omp, claude on PATH; the task stores the concrete runtime.
check_runtime() {
    case "$1" in auto|claude|omp) ;; *) die "runtime must be 'auto', 'claude' or 'omp' (got '$1')" ;; esac
}

# Change budget: the review surface one task may add before scope-check says so. Overridable
# per spec (`Change budget:` under ## Scope) and per repo (## Change budget in .claude/sdlc.md).
# Defaults follow the review evidence: defect finding degrades past ~400 reviewed lines
# (SmartBear/Cisco), review attention drops ~8.7% per extra file (arXiv 2609.22610, optimum
# ~10 files), cross-subsystem co-changes are the defect-prone ones (D'Ambros 2009). The ceiling
# is where decomposition stops being advice: past it scope-check refuses to hand the branch on.
BUILTIN_BUDGET_ADDED="400"
BUILTIN_BUDGET_FILES="15"
BUILTIN_BUDGET_MODULES="3"
BUILTIN_BUDGET_CEILING="3000"
BUILTIN_STRUCT_EROSION_MAX="0.05"
BUILTIN_STRUCT_HOTSPOT_MAX="0"

# Map a phase name to its cost role.  Unknown phases → default.
phase_role() {
    case "$1" in
        scope-check|ship|verify) printf 'smol'    ;;
        implement|qa|triage)  printf 'default' ;;
        review|root-cause)    printf 'slow'    ;;
        *)                    printf 'default' ;;
    esac
}

# --------------------------------------------------------------------------- #
# plumbing
# --------------------------------------------------------------------------- #

die() { printf 'aisdlc: %s\n' "$1" >&2; exit "${2:-1}"; }
say() { printf '%s\n' "$1"; }
ts()  { date -u +%Y-%m-%dT%H:%M:%SZ; }

need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed"; }

# jq write-in-place on a JSON file: jset <file> <filter> [args…]
jset() {
    local file="$1"; shift
    local tmp="${file}.tmp.$$"
    jq "$@" "$file" > "$tmp" && mv "$tmp" "$file"
}

resolve_repo() {
    local candidate="${1:-.}"
    [ -d "$candidate" ] || die "no such directory: $candidate"
    git -C "$candidate" rev-parse --show-toplevel 2>/dev/null \
        || die "not a git repository: $candidate"
}

# Default base ref: whichever of these exists first.
detect_base() {
    local repo="$1" ref
    for ref in origin/master origin/main master main; do
        if git -C "$repo" rev-parse --verify --quiet "$ref" >/dev/null 2>&1; then
            printf '%s' "$ref"; return 0
        fi
    done
    die "cannot detect a base ref in $repo — pass --base <ref>"
}

state_dir() { printf '%s/.aisdlc' "$1"; }

# Per-repo defaults, written by /sdlc:init and editable by hand. Reading a key that is
# absent prints nothing, so callers can chain fallbacks. Kept separate from
# .claude/sdlc.md, which is the project profile the *agents* read.
cfg() {
    local repo="$1" key="$2" file
    file="$(state_dir "$repo")/config.json"
    [ -f "$file" ] || return 0
    jq -r --arg k "$key" '.[$k] // empty | tostring' "$file" 2>/dev/null
}

# CLI flag (already in $3 if given) > config.json > environment > built-in.
resolve_default() {
    local repo="$1" key="$2" given="$3" env_value="$4" builtin="$5" value
    [ -n "$given" ] && { printf '%s' "$given"; return 0; }
    value="$(cfg "$repo" "$key")"
    [ -n "$value" ] && { printf '%s' "$value"; return 0; }
    [ -n "$env_value" ] && { printf '%s' "$env_value"; return 0; }
    printf '%s' "$builtin"
}

init_state() {
    local repo="$1" dir
    dir="$(state_dir "$repo")"
    mkdir -p "$dir/tasks"
    [ -f "$dir/queue.jsonl" ] || : > "$dir/queue.jsonl"
    [ -f "$dir/queue.lock" ]  || : > "$dir/queue.lock"

    # Keep the queue out of the repo without touching the project's .gitignore.
    # --git-dir can be relative to $repo, and in a linked worktree it is not where
    # info/exclude lives — resolve the common dir as an absolute path.
    local gitdir exclude
    gitdir="$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
    [ -d "$gitdir" ] || gitdir="$(cd "$repo" && cd "$(git rev-parse --git-common-dir)" && pwd)"
    exclude="$gitdir/info/exclude"
    mkdir -p "$gitdir/info"
    grep -qxF '/.aisdlc/' "$exclude" 2>/dev/null || echo '/.aisdlc/' >> "$exclude"

    # Permissions handed to every headless run.
    #
    # The allow list exists because an unattended phase that stops to ask is a stalled task
    # that looks like a slow one. Editing files and using git is the entire job here, and it
    # happens inside a throwaway worktree, so granting it is bounded rather than reckless.
    # Do not rely on the developer's personal allow list: it varies, and a phase that commits
    # with double quotes where their rule expected single ones fails for no defensible reason.
    #
    # The deny list is the floor and takes precedence over the allow list. The guard hook is
    # the primary defence; this is the belt to its braces.
    #
    # Written once, then yours to edit. If a phase stalls asking to run this project's test
    # command, add it here — e.g. "Bash(make:*)", "Bash(npm:*)", "Bash(go:*)".
    if [ ! -f "$dir/settings.json" ]; then
        cat > "$dir/settings.json" <<'JSON'
{
  "permissions": {
    "allow": [
      "Write",
      "Edit",
      "Bash(git:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git reset --hard origin/*)",
      "Write(.claude/**)",
      "Edit(.claude/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/credentials*)",
      "Read(**/id_rsa*)"
    ]
  }
}
JSON
    fi
}

task_dir()  { printf '%s/tasks/%s' "$(state_dir "$1")" "$2"; }
task_file() { printf '%s/task.json' "$(task_dir "$1" "$2")"; }

task_get() { jq -r "$2 // empty" "$(task_file "$1" "$3")" 2>/dev/null; }

task_set() {
    local repo="$1" id="$2"; shift 2
    jset "$(task_file "$repo" "$id")" "$@"
}

set_status() {
    task_set "$1" "$2" --arg s "$3" --arg t "$(ts)" '.status = $s | .updated = $t'
}

# --------------------------------------------------------------------------- #
# spec gate — the queue refuses anything a human has not approved
# --------------------------------------------------------------------------- #

spec_status() {
    local spec="$1"
    [ -f "$spec" ] || { printf 'missing'; return; }
    # Frontmatter status: read only the leading --- block.
    awk 'NR==1 && $0 != "---" {exit} NR>1 && $0=="---" {exit} /^status:[[:space:]]*/ {
        sub(/^status:[[:space:]]*/, ""); gsub(/[[:space:]"'"'"']/, ""); print; exit }' "$spec"
}

spec_open_questions() {
    # Unchecked boxes anywhere in the spec block execution.
    grep -cE '^[[:space:]]*-[[:space:]]*\[[[:space:]]\]' "$1" 2>/dev/null || true
}

# Extract a single frontmatter field value (supports hyphens in field names).
spec_frontmatter_field() {
    local spec="$1" field="$2"
    awk -v f="${field}:" '
        BEGIN { fm=0 }
        /^---$/ { if (fm<2) fm++; else exit }
        fm==1 && index($0,f)==1 {
            val=substr($0,length(f)+1); gsub(/^[[:space:]]+|[[:space:]]+$/,"",val); print val; exit
        }
    ' "$spec"
}

# GH-53: Check that every token in depends-on: has a PASS verify-report in the base tree.
check_depends_on() {
    local spec="$1" unmet="" first
    local deps_str
    deps_str="$(spec_frontmatter_field "$spec" "depends-on")"
    [ -z "$deps_str" ] && return 0
    local -a deps
    read -r -a deps <<< "$deps_str"
    local specs_root
    specs_root="$(dirname "$(dirname "$spec")")"
    local token
    for token in "${deps[@]}"; do
        local report="$specs_root/$token/verify-report.md"
        if [ ! -f "$report" ]; then
            unmet="${unmet:+$unmet }$token"
            continue
        fi
        first="$(head -1 "$report")"
        if [ "$first" != "PASS" ]; then
            unmet="${unmet:+$unmet }$token"
        fi
    done
    if [ -n "$unmet" ]; then
        printf 'depends-on not met: %s' "$unmet"; return 1
    fi
    return 0
}

check_spec() {
    local spec="$1" repo="${2:-}" status open
    status="$(spec_status "$spec")"
    case "$status" in
        missing)  printf 'no spec at %s — run /%s:spec first' "$spec" "$PLUGIN_NAME"; return 1 ;;
        approved)
            # C6: bugfix specs additionally require the issue to still carry the bug label.
            if [ -n "$repo" ]; then
                local kind_val issue_n approved_by
                kind_val="$(spec_frontmatter_field "$spec" "kind")"
                if [ "$kind_val" = "bugfix" ]; then
                    approved_by="$(spec_frontmatter_field "$spec" "approved-by")"
                    if ! printf '%s' "$approved_by" | grep -qE '^issue #[0-9]+'; then
                        printf 'bugfix requires approved-by: issue #<n>'; return 1
                    fi
                    issue_n="$(printf '%s' "$approved_by" | grep -oE '^issue #[0-9]+' | grep -oE '[0-9]+')"
                    if ! issue_has_label "$repo" "$issue_n" "bug"; then
                        printf 'bugfix approval revoked: issue #%s no longer labelled bug' "$issue_n"
                        return 1
                    fi
                fi
            fi
            ;;
        "")       printf 'spec has no status: field — expected status: approved'; return 1 ;;
        *)        printf 'spec is status: %s — a human must approve it' "$status"; return 1 ;;
    esac
    open="$(spec_open_questions "$spec")"
    if [ "${open:-0}" -gt 0 ]; then
        printf '%s unresolved open question(s) in the spec' "$open"; return 1
    fi
    local dep_reason
    if ! dep_reason="$(check_depends_on "$spec")"; then
        printf '%s' "$dep_reason"; return 1
    fi
    return 0
}

# --------------------------------------------------------------------------- #
# tracker — local (file-backed) and github (gh CLI) implementations
# --------------------------------------------------------------------------- #

# Resolve tracker kind from .claude/sdlc.md; fallback to local or github.
tracker_kind() {
    local repo="$1" kind
    local profile="$repo/.claude/sdlc.md"
    if [ -f "$profile" ]; then
        kind="$(grep -oE '\.claude/trackers/[a-z-]+\.md' "$profile" 2>/dev/null | \
                sed 's|\.claude/trackers/||; s|\.md||' | head -1)"
        [ -n "$kind" ] && { printf '%s' "$kind"; return 0; }
    fi
    if [ -d "$repo/.aisdlc/tracker" ]; then
        printf 'local'
    elif command -v gh >/dev/null 2>&1; then
        printf 'github'
    else
        printf 'local'
    fi
}

# ---------- local tracker ----------

tracker_local_issue_has_label() {
    local repo="$1" n="$2" label="$3"
    local issue_file="$repo/.aisdlc/tracker/issues/$n.md"
    [ -f "$issue_file" ] || return 1
    grep -E "^labels:" "$issue_file" | grep -qw "$label"
}

# Assignees as one login per line, from a `assignees: [a, b]` frontmatter line.
_local_assignees() {
    grep -m1 '^assignees:' "$1" | sed 's/^assignees:[[:space:]]*\[//; s/\].*$//' | tr ',' '\n' | tr -d ' ' | sed '/^$/d'
}

# Epoch of the newest `🤖 … claimed <ISO>` comment by <login> in a comments stream on stdin.
_newest_claim_epoch() {
    local login="$1" iso
    iso="$(grep -F "@${login}:" | grep -F 'claimed' | grep -oE 'claimed [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z' | tail -1 | cut -d' ' -f2)"
    [ -n "$iso" ] && date -u -d "$iso" +%s 2>/dev/null
}

tracker_local_check_claim() {
    local repo="$1" n="$2" identity="${AISDLC_USER:-local-user}"
    local issue_file="$repo/.aisdlc/tracker/issues/$n.md"
    [ -f "$issue_file" ] || { printf 'free'; return 0; }
    grep -qE "^labels:.*\bin-progress\b" "$issue_file" 2>/dev/null || { printf 'free'; return 0; }
    _local_assignees "$issue_file" | grep -qxF "$identity" && { printf 'mine'; return 0; }
    local other epoch_claimed
    other="$(_local_assignees "$issue_file" | head -1)"
    # Stale only for another claimant, measured from their newest claim comment.
    epoch_claimed="$(_newest_claim_epoch "${other:-unknown}" < "$issue_file" || true)"
    if [ -n "$epoch_claimed" ] && [ "$(( $(date -u +%s) - epoch_claimed ))" -gt 3600 ]; then
        printf 'stale:%s' "${other:-unknown}"; return 0
    fi
    printf 'other:%s' "${other:-unknown}"
}

tracker_local_claim() {
    local repo="$1" n="$2" # cmd=$3 unused but accepted for interface uniformity
    local issue_file="$repo/.aisdlc/tracker/issues/$n.md"
    local identity="${AISDLC_USER:-local-user}" iso
    iso="$(ts)"
    local tmp="${issue_file}.tmp.$$"
    mkdir -p "$(dirname "$issue_file")"
    [ -f "$issue_file" ] || return 1
    awk -v identity="$identity" '
        BEGIN { fm=0 }
        /^---$/ { fm++; print; next }
        fm==1 && /^labels:/ {
            if ($0 !~ /in-progress/) {
                if ($0 ~ /\[\]/) sub(/\[\]/, "[in-progress]")
                else sub(/\]$/, ", in-progress]")
            }
            print; next
        }
        fm==1 && /^assignees:/ {
            if ($0 !~ identity) {
                if ($0 ~ /\[\]/) sub(/\[\]/, "[" identity "]")
                else sub(/\]$/, ", " identity "]")
            }
            print; next
        }
        { print }
    ' "$issue_file" > "$tmp"
    grep -q '^## Comments' "$tmp" || printf '## Comments\n' >> "$tmp"
    # 🤖 = UTF-8 \360\237\244\226
    printf -- '- %s @%s: \360\237\244\226 /sdlc:aisdlc claimed %s\n' \
        "$iso" "$identity" "$iso" >> "$tmp"
    mv "$tmp" "$issue_file"
}

tracker_local_release() {
    local repo="$1" n="$2" # cmd=$3 outcome=$4 accepted for interface uniformity
    local outcome="${4:-done}"
    local issue_file="$repo/.aisdlc/tracker/issues/$n.md"
    local iso tmp
    iso="$(ts)"
    tmp="${issue_file}.tmp.$$"
    [ -f "$issue_file" ] || return 0
    awk '
        BEGIN { fm=0 }
        /^---$/ { fm++; print; next }
        fm==1 && /^labels:/ {
            gsub(/, in-progress/, ""); gsub(/in-progress, /, "")
            gsub(/\[in-progress\]/, "[]"); print; next
        }
        { print }
    ' "$issue_file" > "$tmp"
    grep -q '^## Comments' "$tmp" || printf '## Comments\n' >> "$tmp"
    printf -- '- %s: \360\237\244\226 /sdlc:aisdlc completed: %s. Lock released.\n' \
        "$iso" "$outcome" >> "$tmp"
    mv "$tmp" "$issue_file"
}

gh_repo_slug() {
    local repo="$1"
    git -C "$repo" remote get-url origin 2>/dev/null \
        | sed -e 's|git@github\.com:||' \
              -e 's|https://github\.com/||' \
              -e 's|\.git$||'
}

# ---------- github tracker ----------

tracker_github_issue_has_label() {
    local repo="$1" n="$2" label="$3" slug
    slug="$(gh_repo_slug "$repo")"
    gh issue view "$n" --repo "$slug" --json labels --jq ".labels[].name" 2>/dev/null | grep -qxF "$label"
}

tracker_github_check_claim() {
    local repo="$1" n="$2" identity slug json
    slug="$(gh_repo_slug "$repo")"
    identity="$(gh api user --jq '.login' 2>/dev/null || printf 'unknown')"
    json="$(gh issue view "$n" --repo "$slug" --json labels,assignees,comments 2>/dev/null)" || { printf 'free'; return 0; }
    printf '%s' "$json" | jq -e '.labels[].name | select(. == "in-progress")' >/dev/null 2>&1 || { printf 'free'; return 0; }
    printf '%s' "$json" | jq -e --arg me "$identity" '.assignees[] | select(.login == $me)' >/dev/null 2>&1 && { printf 'mine'; return 0; }
    local other epoch_claimed
    other="$(printf '%s' "$json" | jq -r '.assignees[0].login // "unknown"')"
    epoch_claimed="$(printf '%s' "$json" | jq -r --arg o "$other" \
        '[.comments[] | select(.author.login == $o and (.body | test("claimed")))] | last | .createdAt // empty' \
        | xargs -r -I{} date -u -d {} +%s 2>/dev/null)"
    if [ -n "$epoch_claimed" ] && [ "$(( $(date -u +%s) - epoch_claimed ))" -gt 3600 ]; then
        printf 'stale:%s' "$other"; return 0
    fi
    printf 'other:%s' "$other"
}

# Every mutation must succeed, then the three signals are read back — a claim that is not
# observable is not a claim.
tracker_github_claim() {
    local repo="$1" n="$2" identity iso slug
    slug="$(gh_repo_slug "$repo")"
    identity="$(gh api user --jq '.login')" || return 1
    iso="$(ts)"
    gh issue edit "$n" --repo "$slug" --add-label "in-progress" --add-assignee "$identity" >/dev/null || return 1
    gh issue comment "$n" --repo "$slug" --body "$(printf '\360\237\244\226') /sdlc:aisdlc claimed $iso" >/dev/null || return 1
    [ "$(tracker_github_check_claim "$repo" "$n")" = "mine" ]
}

tracker_github_release() {
    local repo="$1" n="$2" outcome="${3:-done}" slug
    slug="$(gh_repo_slug "$repo")"
    gh issue edit "$n" --repo "$slug" --remove-label "in-progress" >/dev/null 2>&1 || true
    gh issue comment "$n" --repo "$slug" --body "$(printf '\360\237\244\226') /sdlc:aisdlc completed: $outcome. Lock released." >/dev/null 2>&1 || true
}

# ---------- PR lifecycle ----------

# The PR record already exists when ship used the local descriptor's create-pr; the claim
# mutates it. A ship that never wrote one (a stub, an older descriptor) gets a full record.
tracker_local_pr_claim() {
    local repo="$1" n="$2" ticket="$3"
    local prs_file="$repo/.aisdlc/tracker/prs.jsonl" comments="$repo/.aisdlc/tracker/prs/$n.comments.md"
    local identity="${AISDLC_USER:-local-user}" tmp iso
    iso="$(ts)"
    mkdir -p "$(dirname "$prs_file")" "$(dirname "$comments")"
    touch "$prs_file"
    tmp="${prs_file}.tmp.$$"
    if jq -e --argjson n "$n" 'select(.number == $n)' "$prs_file" >/dev/null 2>&1; then
        jq -c --argjson n "$n" --arg a "$identity" \
            'if .number == $n then .labels = ((.labels // []) + ["in-progress"] | unique) | .assignees = (((.assignees // []) + [$a]) | unique) else . end' \
            "$prs_file" > "$tmp" && mv "$tmp" "$prs_file"
    else
        jq -cn --argjson n "$n" --arg t "$ticket" --arg u "local#$n" --arg a "$identity" --arg s "$ticket" \
            '{number:$n,branch:null,title:$t,labels:["ai-sdlc","review","in-progress"],assignees:[$a],state:"open",verdict:null,reviews:[],body_path:("specs/"+$s+"/pr-body.md"),url:$u,mergeCommit:null}' \
            >> "$prs_file"
    fi
    printf -- '\n---\n%s @%s\n\360\237\244\226 /sdlc:aisdlc claimed %s\n' "$iso" "$identity" "$iso" >> "$comments"
    jq -e --argjson n "$n" --arg a "$identity" \
        'select(.number == $n and (.labels | index("in-progress")) and (.assignees | index($a)))' "$prs_file" >/dev/null
}

tracker_github_pr_claim() {
    local repo="$1" n="$2" slug identity iso
    slug="$(gh_repo_slug "$repo")"
    identity="$(gh api user --jq '.login')" || return 1
    iso="$(ts)"
    # REST, not `gh pr edit`: that subcommand resolves the PR through a GraphQL query which
    # still selects the retired `projectCards` connection, so every call fails against current
    # GitHub on gh builds that predate its removal. PRs are issues to the REST API, which is
    # also what the shipped github tracker descriptor uses for label-pr.
    gh api -X POST "repos/$slug/issues/$n/labels" -f 'labels[]=in-progress' >/dev/null || return 1
    gh api -X POST "repos/$slug/issues/$n/assignees" -f "assignees[]=$identity" >/dev/null || return 1
    gh pr comment "$n" --repo "$slug" --body "$(printf '\360\237\244\226') /sdlc:aisdlc claimed $iso" >/dev/null || return 1
    gh pr view "$n" --repo "$slug" --json labels,assignees 2>/dev/null \
        | jq -e --arg me "$identity" '(.labels | map(.name) | index("in-progress")) and (.assignees | map(.login) | index($me))' >/dev/null
}

tracker_pr_claim() {
    local repo="$1" n="$2" kind="$3" ticket="$4"
    case "$kind" in
        local)  tracker_local_pr_claim "$repo" "$n" "$ticket" ;;
        github) tracker_github_pr_claim "$repo" "$n" ;;
    esac
}

# <outcome> is the review verdict when the review phase ran, otherwise a plain description.
tracker_local_pr_release() {
    local repo="$1" n="$2" outcome="$3"
    local prs_file="$repo/.aisdlc/tracker/prs.jsonl" comments="$repo/.aisdlc/tracker/prs/$n.comments.md"
    [ -f "$prs_file" ] || return 0
    local tmp="${prs_file}.tmp.$$"
    jq -c --argjson n "$n" --arg v "$outcome" \
        'if .number == $n then .assignees = [] | .labels = (.labels - ["in-progress"]) | (if ($v == "APPROVED" or $v == "CHANGES_REQUESTED") then .reviews += [{by:"aisdlc",verdict:$v}] else . end) else . end' \
        "$prs_file" > "$tmp" && mv "$tmp" "$prs_file"
    mkdir -p "$(dirname "$comments")"
    printf -- '\n---\n%s @aisdlc\n\360\237\244\226 /sdlc:aisdlc completed: %s. Lock released.\n' "$(ts)" "$outcome" >> "$comments"
}

tracker_github_pr_release() {
    local repo="$1" n="$2" outcome="$3" slug
    slug="$(gh_repo_slug "$repo")"
    gh api -X DELETE "repos/$slug/issues/$n/labels/in-progress" >/dev/null 2>&1 || true
    gh pr comment "$n" --repo "$slug" --body "$(printf '\360\237\244\226') /sdlc:aisdlc completed: $outcome. Lock released." >/dev/null 2>&1 || true
}

tracker_pr_release() {
    local repo="$1" n="$2" kind="$3" verdict="$4"
    case "$kind" in
        local)  tracker_local_pr_release "$repo" "$n" "$verdict" ;;
        github) tracker_github_pr_release "$repo" "$n" "$verdict" ;;
    esac
}

# ---------- dispatch ----------

issue_has_label() {
    local repo="$1" n="$2" label="$3"
    local kind
    kind="$(tracker_kind "$repo")"
    case "$kind" in
        local)  tracker_local_issue_has_label "$repo" "$n" "$label" ;;
        github) tracker_github_issue_has_label "$repo" "$n" "$label" ;;
        *)      return 1 ;;
    esac
}

tracker_check_claim() {
    local repo="$1" n="$2" kind="$3"
    case "$kind" in
        local)  tracker_local_check_claim "$repo" "$n" ;;
        github) tracker_github_check_claim "$repo" "$n" ;;
        *)      printf 'free' ;;
    esac
}

tracker_claim() {
    local repo="$1" n="$2" kind="$3" cmd="$4"
    case "$kind" in
        local)  tracker_local_claim "$repo" "$n" "$cmd" ;;
        github) tracker_github_claim "$repo" "$n" ;;
    esac
}

tracker_release() {
    local repo="$1" n="$2" kind="$3" cmd="$4" outcome="$5"
    case "$kind" in
        local)  tracker_local_release "$repo" "$n" "$cmd" "$outcome" ;;
        github) tracker_github_release "$repo" "$n" "$outcome" ;;
    esac
}

# --------------------------------------------------------------------------- #
# readiness
# --------------------------------------------------------------------------- #
#
# Optional add-time quality gate. Disabled when readiness_min is absent or null in
# .aisdlc/config.json. When enabled, invokes the smol model with the spec and a rubric,
# expects JSON {"score":<0-100>,"gaps":[…≤5]}, and fails if score < readiness_min.
#
# Side effects: sets globals READINESS_SCORE READINESS_REASON.
#   READINESS_SCORE  — the model's integer score, or empty when the gate did not run.
#   READINESS_REASON — why a below-threshold or invalid spec was refused.
# Returns 0: feature disabled or score >= threshold.
# Returns 1: below threshold (writes specs/<ticket>/readiness.md), parse failure, or missing rubric.
readiness_check() {
    local repo="$1" spec="$2" model="$3" budget="$4" billing="$5" runtime="$6"
    local specs_dir="$7" ticket="$8"
    READINESS_SCORE=""; READINESS_REASON=""

    # Feature is off when readiness_min is absent or null.
    local cfg rmin
    cfg="$(state_dir "$repo")/config.json"
    rmin="$(jq -r 'if (.readiness_min // null) == null then "" else (.readiness_min | tostring) end' \
        "$cfg" 2>/dev/null)"
    [ -z "$rmin" ] && return 0
    case "$rmin" in
        *[!0-9]*) READINESS_REASON="readiness_min must be an integer 0-100 (got '$rmin')"; return 1 ;;
    esac
    [ "$rmin" -le 100 ] || { READINESS_REASON="readiness_min must be an integer 0-100 (got '$rmin')"; return 1; }
    # Smol model: model_roles.smol when configured, else the task's default model.
    local smol="$model"
    local mr_smol; mr_smol="$(jq -r '.model_roles.smol // empty' "$cfg" 2>/dev/null)"
    [ -n "$mr_smol" ] && smol="$mr_smol"

    # Rubric loaded at runtime so operators can edit without touching the binary.
    local rubric="$PLUGIN_ROOT/prompts/readiness.md"
    if [ ! -f "$rubric" ]; then
        READINESS_REASON="readiness rubric not found: $rubric"; return 1
    fi

    local prompt; prompt="$(cat "$rubric"; printf '\n\n---\n\n## Spec to evaluate\n\n'; cat "$spec")"
    local settings; settings="$(state_dir "$repo")/settings.json"
    # Dedicated cwd avoids project context; temporary sessions and streams stay contained.
    local rdir; rdir="$(mktemp -d)"
    local result="$rdir/result.json" log="$rdir/invoke.log" rc=0

    case "$runtime" in
        claude)
            invoke_claude "$prompt" "$smol" "$budget" "$settings" "$rdir" "$result" "$log" "false" "$billing" "true" || rc=$?
            collapse_result "$result"
            ;;
        omp)
            invoke_omp "$prompt" "$smol" "$budget" "$rdir" "$result" "$log" "$billing" "true" || rc=$?
            ;;
    esac

    # Fail closed: process error or is_error in result envelope.
    if [ "$rc" -ne 0 ] || [ "$(jq -r '.is_error // false' "$result" 2>/dev/null)" = "true" ]; then
        rm -rf "$rdir"
        READINESS_REASON='readiness check: model response is not valid {"score":<0-100>,"gaps":[...<=5]}'
        return 1
    fi

    local raw; raw="$(jq -r '.result // empty' "$result" 2>/dev/null)"
    rm -rf "$rdir"

    # Strict parse: exact integer (no fractional part) 0–100, array of ≤5 strings only.
    local score="" gaps_ok=0
    score="$(printf '%s' "$raw" | \
        jq -re '.score | select(type == "number") | select(. == floor) |
                select(. >= 0 and . <= 100) | tostring' \
        2>/dev/null)" || true
    if [ -n "$score" ]; then
        gaps_ok="$(printf '%s' "$raw" | \
            jq -r 'if (.gaps | type) == "array" and (.gaps | length) <= 5
                      and (.gaps | all(type == "string")) then "1" else "0" end' \
            2>/dev/null)" || gaps_ok=0
    fi

    if [ -z "$score" ] || [ "${gaps_ok:-0}" != "1" ]; then
        READINESS_REASON='readiness check: model response is not valid {"score":<0-100>,"gaps":[...<=5]}'
        return 1
    fi

    READINESS_SCORE="$score"

    if [ "$score" -ge "$rmin" ]; then
        return 0
    fi

    # Below threshold: write readiness.md with gap list for the operator.
    local rmd="$repo/$specs_dir/$ticket/readiness.md"
    { printf '# Readiness report: %s\n\nScore: %s / %s required\n\n## Gaps\n\n' \
          "$ticket" "$score" "$rmin"
      printf '%s' "$raw" | jq -r '.gaps[] | "- " + .' 2>/dev/null; } > "$rmd"
    READINESS_REASON="readiness score $score < $rmin — spec needs improvement (see $rmd)"
    return 1
}


# --------------------------------------------------------------------------- #
# add
# --------------------------------------------------------------------------- #

cmd_add() {
    # Empty means "not given on the command line" — resolve_default fills these in once the
    # repo is known, since the config file lives inside it.
    local ticket="" repo="." model="" budget="" base="" phases="" billing="" runtime=""
    local no_pr=0 plugin_dir=0 force=0 issue_n=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --repo)       repo="$2"; shift 2 ;;
            --model)      model="$2"; shift 2 ;;
            --budget)     budget="$2"; shift 2 ;;
            --base)       base="$2"; shift 2 ;;
            --phase|--phases) phases="$(printf '%s' "$2" | tr ',' ' ')"; shift 2 ;;
            --no-pr)      no_pr=1; shift ;;
            --plugin-dir) plugin_dir=1; shift ;;
            --force)      force=1; shift ;;
            --issue)      issue_n="$2"; shift 2 ;;
            --billing)    billing="$2"; shift 2 ;;
            --runtime)    runtime="$2"; shift 2 ;;
            -*)           die "unknown flag for add: $1" ;;
            *)            ticket="$1"; shift ;;
        esac
    done

    # --issue sets the ticket (GH-<n>) and uses ISSUE_PHASES by default.
    if [ -n "$issue_n" ]; then
        ticket="GH-${issue_n}"
        [ -n "$phases" ] || phases="$ISSUE_PHASES"
    fi

    [ -n "$ticket" ] || die "usage: aisdlc add <TICKET> [--repo .] [--model sonnet] [--budget 5] [--runtime auto|claude|omp]"

    repo="$(resolve_repo "$repo")"
    init_state "$repo"

    model="$(resolve_default "$repo" model "$model" "${AISDLC_MODEL:-}" "$BUILTIN_MODEL")"
    budget="$(resolve_default "$repo" budget "$budget" "${AISDLC_BUDGET:-}" "$BUILTIN_BUDGET")"
    billing="$(resolve_default "$repo" billing "$billing" "${AISDLC_BILLING:-}" "$BUILTIN_BILLING")"
    [ "$billing" = "api" ] || [ "$billing" = "subscription" ] \
        || die "billing must be 'api' or 'subscription' (got '$billing')"
    base="$(resolve_default "$repo" base "$base" "${AISDLC_BASE:-}" "")"
    [ -n "$base" ] || base="$(detect_base "$repo")"
    [ -n "$phases" ] || phases="$ALL_PHASES"
    runtime="$(resolve_default "$repo" runtime "$runtime" "${AISDLC_RUNTIME:-}" "$BUILTIN_RUNTIME")"
    check_runtime "$runtime"
    local runtime_note=""
    if [ "$runtime" = "auto" ]; then
        runtime=""
        local rt
        for rt in omp claude; do
            command -v "$rt" >/dev/null 2>&1 && { runtime="$rt"; break; }
        done
        [ -n "$runtime" ] || die "runtime auto: neither omp nor claude is installed — install one, or pass --runtime"
        runtime_note=" (auto-detected)"
    fi

    local specs_dir
    specs_dir="$(resolve_default "$repo" specs_dir "" "${AISDLC_SPECS_DIR:-}" "$BUILTIN_SPECS_DIR")"

    READINESS_SCORE=""   # set by readiness_check; cleared here so --issue tasks start clean

    if [ -n "$issue_n" ]; then
        # --issue: check and claim the issue; triage will write the spec in-worktree.
        local kind claim_status
        kind="$(tracker_kind "$repo")"
        claim_status="$(tracker_check_claim "$repo" "$issue_n" "$kind")"
        case "$claim_status" in
            free|stale:*) ;;
            mine)   die "issue $issue_n already claimed by ${AISDLC_USER:-local-user}" ;;
            other:*) die "issue $issue_n already claimed by ${claim_status#other:}" ;;
        esac
        tracker_claim "$repo" "$issue_n" "$kind" "aisdlc" \
            || die "could not claim issue $issue_n"
    else
        # Normal spec gate — skip for --issue (triage writes the spec in-worktree).
        local spec="$repo/$specs_dir/$ticket/spec.md" reason spec_passed=0
        if ! reason="$(check_spec "$spec" "$repo")"; then
            if [ "$force" -eq 1 ]; then
                say "aisdlc: WARNING — $reason (queued anyway because of --force)"
            else
                die "$reason"
            fi
        else
            spec_passed=1
        fi
        # Readiness gate — only when check_spec passed cleanly; --force bypass of check_spec
        # skips readiness per spec (scoring a known-flawed spec adds noise, not signal).
        READINESS_SCORE=""; READINESS_REASON=""
        if [ "$spec_passed" -eq 1 ]; then
            if ! readiness_check "$repo" "$spec" "$model" "$budget" "$billing" "$runtime" \
                    "$specs_dir" "$ticket"; then
                if [ "$force" -eq 1 ]; then
                    say "aisdlc: WARNING — $READINESS_REASON (queued anyway because of --force)"
                else
                    die "$READINESS_REASON"
                fi
            fi
        fi
    fi

    # --no-pr removes both ship and review.
    if [ "$no_pr" -eq 1 ]; then
        local p="" ph
        for ph in $phases; do
            case "$ph" in ship|review) ;; *) p="${p:+$p }$ph" ;; esac
        done
        phases="$p"
    fi

    local id slug is_issue_flag
    is_issue_flag=0; [ -n "$issue_n" ] && is_issue_flag=1
    slug="$(printf '%s' "$ticket" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/-*$//')"
    id="${slug}-$(date +%Y%m%d-%H%M%S)-${RANDOM}"

    local dir; dir="$(task_dir "$repo" "$id")"
    mkdir -p "$dir"
    local cost_init; cost_init="$( [ "$billing" = "subscription" ] && printf 'null' || printf '0' )"

    # Snapshot per-phase models when model_roles is configured. Absent key → no models entry.
    local models_arg="null"
    local _mr_cfg; _mr_cfg="$(state_dir "$repo")/config.json"
    if [ -f "$_mr_cfg" ] && jq -e 'has("model_roles")' "$_mr_cfg" >/dev/null 2>&1; then
        local _mr_json _mr_ph _mr_role _mr_model
        _mr_json="$(jq -c '.model_roles' "$_mr_cfg")"
        models_arg="{}"
        for _mr_ph in $phases; do
            _mr_role="$(phase_role "$_mr_ph")"
            _mr_model="$(printf '%s' "$_mr_json" | jq -r --arg r "$_mr_role" --arg fb "$model" '.[$r] // $fb')"
            models_arg="$(printf '%s' "$models_arg" | jq --arg ph "$_mr_ph" --arg m "$_mr_model" '. + {($ph): $m}')"
        done
    fi

    jq -n --arg id "$id" --arg ticket "$ticket" --arg repo "$repo" --arg model "$model" \
          --arg base "$base" --arg phases "$phases" --arg t "$(ts)" --arg sd "$specs_dir" \
          --arg billing "$billing" --arg runtime "$runtime" \
          --argjson budget "$budget" --argjson no_pr "$no_pr" --argjson plugin_dir "$plugin_dir" \
          --argjson is_issue "$is_issue_flag" --argjson cost_init "$cost_init" \
          --argjson models_obj "$models_arg" \
          --argjson rs_score "${READINESS_SCORE:-null}" \
          '({id:$id, ticket:$ticket, repo:$repo, model:$model, base:$base, specs_dir:$sd,
            billing:$billing, runtime:$runtime,
            phases:($phases|split(" ")|map(select(length>0))), budget:$budget,
            no_pr:($no_pr==1), plugin_dir:($plugin_dir==1), is_issue:($is_issue==1),
            status:"queued", attempts:0, cost_usd:$cost_init, created:$t, updated:$t,
            branch:null, worktree:null, pr_url:null, error:null}
           | if $models_obj != null then . + {models: $models_obj} else . end
           | if $rs_score != null then . + {readiness_score: $rs_score} else . end)' > "$dir/task.json"

    flock "$(state_dir "$repo")/queue.lock" \
        bash -c "printf '%s\n' \"$id\" >> \"$(state_dir "$repo")/queue.jsonl\""

    say "queued $id  ($ticket → $model on $runtime$runtime_note, budget \$$budget, phases: $phases)"
    say "run it:  aisdlc run --repo $repo"
}

# --------------------------------------------------------------------------- #
# pull / loop — the tracker as the work queue
# --------------------------------------------------------------------------- #
#
# `add --issue <n>` needs a human to pick the number. `pull` picks it: the oldest open issue
# carrying the approval label (`bug` — the label *is* the approval, see check_spec) that nobody
# holds and this repo has not already built. `loop` is pull + run --once on a timer, for a
# session or a scheduler. Selection stays label-first and in code; the model never chooses.

BUILTIN_PULL_LABEL="bug"
BUILTIN_LOOP_INTERVAL="900"

# Open issue numbers carrying <label>, oldest first, one per line. Local reads the tracker files;
# github asks `gh issue list`. Assigned or in-progress issues are someone's and are left alone.
tracker_list_open() {
    local repo="$1" kind="$2" label="$3"
    case "$kind" in
        local)
            local f
            for f in "$repo"/.aisdlc/tracker/issues/*.md; do
                [ -f "$f" ] || continue
                grep -qE '^state:[[:space:]]*open' "$f" || continue
                grep -E '^labels:' "$f" | grep -qw "$label" || continue
                grep -qE '^labels:.*\bin-progress\b' "$f" && continue
                [ -z "$(_local_assignees "$f")" ] || continue
                grep -m1 '^number:' "$f" | tr -dc '0-9'; printf '\n'
            done | sed '/^$/d' | sort -n
            ;;
        github)
            gh issue list --repo "$(gh_repo_slug "$repo")" --state open --label "$label" \
                --limit 100 --json number,labels,assignees 2>/dev/null \
            | jq -r 'map(select((.assignees | length) == 0
                              and ((.labels | map(.name) | index("in-progress")) | not)))
                     | sort_by(.number) | .[].number'
            ;;
    esac
}

# An issue this repo already turned into a task — any status, failed included — or that has a
# branch is not pulled again: a second task would open a second PR for the same bug. A failed
# one is `aisdlc retry`'s business, deliberately.
issue_already_built() {
    local repo="$1" n="$2" f
    for f in "$(state_dir "$repo")"/tasks/*/task.json; do
        [ -f "$f" ] || continue
        [ "$(jq -r '.ticket' "$f" 2>/dev/null)" = "GH-$n" ] && return 0
    done
    [ -n "$(git -C "$repo" branch --all --list "ai/GH-$n-*" --list "*/ai/GH-$n-*" 2>/dev/null)" ]
}

# Candidates after the local exclusions, oldest first.
pull_candidates() {
    local repo="$1" kind="$2" label="$3" n
    while read -r n; do
        [ -n "$n" ] || continue
        issue_already_built "$repo" "$n" || printf '%s\n' "$n"
    done < <(tracker_list_open "$repo" "$kind" "$label")
}

cmd_pull() {
    local repo="." want="" label="" dry=0
    local -a pass=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --repo)    repo="$2"; shift 2 ;;
            --label)   label="$2"; shift 2 ;;
            --dry-run) dry=1; shift ;;
            --no-pr|--plugin-dir|--force) pass+=("$1"); shift ;;
            --model|--budget|--base|--phase|--phases|--billing|--runtime) pass+=("$1" "$2"); shift 2 ;;
            -*)        die "unknown flag for pull: $1" ;;
            *)         want="$1"; shift ;;
        esac
    done
    repo="$(resolve_repo "$repo")"
    init_state "$repo"
    label="$(resolve_default "$repo" pull_label "$label" "${AISDLC_PULL_LABEL:-}" "$BUILTIN_PULL_LABEL")"
    local kind; kind="$(tracker_kind "$repo")"
    case "$kind" in local|github) ;; *) die "pull needs a local or github tracker (got '$kind')" ;; esac

    local -a candidates=()
    if [ -n "$want" ]; then
        candidates=("$want")
    else
        mapfile -t candidates < <(pull_candidates "$repo" "$kind" "$label")
    fi
    if [ "${#candidates[@]}" -eq 0 ]; then
        say "nothing to pull: no open, unclaimed, unbuilt issue labelled '$label'"
        return 1
    fi
    if [ "$dry" -eq 1 ]; then
        say "would pull #${candidates[0]} (candidates: ${candidates[*]})"
        return 0
    fi

    # add dies on a lost claim; the next candidate is the answer to that, not a failed pull.
    local n
    for n in "${candidates[@]}"; do
        if ( cmd_add --issue "$n" --repo "$repo" "${pass[@]}" ); then
            return 0
        fi
        say "pull: #$n not taken — trying the next candidate"
    done
    say "nothing pulled: every candidate was claimed before this run could take it"
    return 1
}

cmd_loop() {
    local repo="." interval="" once=0 dry=0
    local -a pull_args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --repo)     repo="$2"; shift 2 ;;
            --interval) interval="$2"; shift 2 ;;
            --once)     once=1; shift ;;
            --dry-run)  dry=1; shift ;;
            --no-pr|--plugin-dir|--force) pull_args+=("$1"); shift ;;
            --label|--model|--budget|--base|--phase|--phases|--billing|--runtime) pull_args+=("$1" "$2"); shift 2 ;;
            -*)         die "unknown flag for loop: $1" ;;
            *)          die "loop takes no positional arguments" ;;
        esac
    done
    repo="$(resolve_repo "$repo")"
    init_state "$repo"
    interval="$(resolve_default "$repo" loop_interval "$interval" "${AISDLC_LOOP_INTERVAL:-}" "$BUILTIN_LOOP_INTERVAL")"
    case "$interval" in ''|*[!0-9]*) die "interval must be a number of seconds (got '$interval')" ;; esac

    local -a dryf=(); [ "$dry" -eq 1 ] && dryf=(--dry-run)
    local tick=0
    while :; do
        tick=$((tick + 1))
        say "── tick $tick $(ts)"
        # Each step in its own subshell: die ends the step, not the loop. run goes regardless
        # of what pull found — a task queued by hand or by an earlier tick is still work.
        ( cmd_pull --repo "$repo" "${dryf[@]}" "${pull_args[@]}" ) || true
        [ "$dry" -eq 1 ] || ( cmd_run --repo "$repo" --once ) || true
        [ "$once" -eq 1 ] && break
        say "── sleeping ${interval}s"
        sleep "$interval"
    done
}

# --------------------------------------------------------------------------- #
# run
# --------------------------------------------------------------------------- #

# Atomically take the first queued id, or print nothing when the queue is empty.
pop_task() {
    local repo="$1" dir; dir="$(state_dir "$repo")"
    flock "$dir/queue.lock" bash -c '
        q="$1/queue.jsonl"
        [ -s "$q" ] || exit 0
        head -n 1 "$q"
        tail -n +2 "$q" > "$q.tmp" && mv "$q.tmp" "$q"
    ' _ "$dir"
}

# Make sure the worktree has the spec, committing it if the base ref predates it.
seed_spec() {
    local repo="$1" wt="$2" ticket="$3" log="$4" specs_dir="$5"
    [ -f "$wt/$specs_dir/$ticket/spec.md" ] && return 0
    [ -f "$repo/$specs_dir/$ticket/spec.md" ] || return 1
    printf '[%s] spec not in %s — copying it from the working repo and committing it\n' \
        "$(ts)" "$(git -C "$wt" rev-parse --abbrev-ref HEAD)" >> "$log"
    mkdir -p "$wt/$specs_dir"
    cp -R "$repo/$specs_dir/$ticket" "$wt/$specs_dir/"
    git -C "$wt" add "$specs_dir/$ticket" >> "$log" 2>&1
    git -C "$wt" -c user.name="aisdlc" -c user.email="aisdlc@localhost" \
        commit -q -m "docs(spec): add spec for $ticket" >> "$log" 2>&1
}

# The directories a phase loads the pipeline from. One marketplace, two plugins: --plugin-dir
# names a single directory, so without the sibling a queued phase runs the pipeline with none of
# the Slop Guard hooks. The sibling is optional, so a checkout without it still runs.
plugin_dirs() {
    printf '%s\n' "$PLUGIN_ROOT"
    local sibling="$PLUGIN_ROOT/../slop-guard"
    [ -d "$sibling" ] && (cd "$sibling" && pwd)
    return 0
}

# A fingerprint of the worktree's policy layer. `.claude/` is gitignored, so git cannot see an
# edit there; claude is denied Write(.claude/**) by settings.json, omp has no path-scoped deny,
# so for omp the runner compares this before and after the phase instead.
policy_fingerprint() {
    local wt="$1"
    [ -d "$wt/.claude" ] || { printf 'absent'; return 0; }
    (cd "$wt" && find .claude -type f -print0 | sort -z | xargs -0 sha256sum 2>/dev/null) | sha256sum | cut -c1-16
}

# Fold an `omp --mode json` event stream into the result object the runner already reads from
# claude: result, num_turns, is_error, total_cost_usd. Lines that are not JSON are skipped.
#
# `expanded` is the evidence that omp ran the plugin's command: an unknown /name is not an error
# in omp, it reaches the model as plain text, so a first user message that still starts with "/"
# means the model improvised a phase instead of running one. That is a failure, never a success.
omp_result() {
    jq -R -s '
        def text(m): (m.content // []) | if type == "string" then . else map(select(.type == "text") | .text) | join("") end;
        split("\n") | map(fromjson? // empty) as $ev
        | [$ev[] | select(.type == "turn_end")] as $turns
        | ([$ev[] | select(.type == "agent_end" and .isTerminal != false)] | last) as $end
        | (($end.messages // []) | map(select(.role == "user")) | first) as $asked
        | (($end.messages // []) | map(select(.role == "assistant")) | last) as $last
        | (if $asked == null then "" else text($asked) end) as $prompt
        | ($prompt | startswith("/") | not) as $expanded
        | {type: "result", runtime: "omp",
           num_turns: ($turns | length),
           total_cost_usd: ([$turns[] | .message.usage.cost.total // 0] | add // 0),
           expanded: $expanded,
           stop_reason: ($last.stopReason // null),
           result: (if $expanded then (if $last == null then "" else text($last) end)
                    else "Unknown command: \($prompt | split(" ") | first) — omp sent it to the model as plain text" end),
           is_error: ($end == null or $expanded == false
                      or (($last.stopReason // "") | IN("error", "aborted")))}'
}

# One headless omp invocation, normalised to the claude result shape in $out. The raw event
# stream stays beside it as $out.stream.jsonl, and the session in the task's sessions/ dir.
#
# The plugin is always loaded through --plugin-dir: that is what makes /<plugin>:<phase> resolve
# to this checkout's command, and it also loads the plugin's omp extension — the guard hooks.
# `--approval-mode yolo` because nobody is there to answer a prompt; the guard is the floor, as
# it is for claude under bypassPermissions.
invoke_omp() {
    local prompt="$1" model="$2" budget="$3" wt="$4" out="$5" log="$6" billing="${7:-api}" data_only="$8"
    local sessions; sessions="$(dirname "$out")/sessions"

    local -a args=(-p --mode json --no-title --approval-mode yolo --session-dir "$sessions" --model "$model")
    if [ "$data_only" = "true" ]; then
        # Data-only: disable all tools and load no extension-provided tools.
        args+=(--no-tools --no-extensions)
    else
        local d
        while read -r d; do args+=(--plugin-dir "$d"); done < <(plugin_dirs)
    fi

    # omp has no spend cap, so none is claimed. Under api billing the cost is still recorded.
    if [ "$billing" = "subscription" ]; then
        printf '[%s] === omp -p "%s" (model %s, billing subscription — no cost data)\n' \
            "$(ts)" "$prompt" "$model" >> "$log"
    else
        printf '[%s] === omp -p "%s" (model %s, no spend cap — omp cannot enforce $%s; cost recorded)\n' \
            "$(ts)" "$prompt" "$model" "$budget" >> "$log"
    fi

    local rc=0 before after
    before="$(policy_fingerprint "$wt")"
    # Same two load-bearing details as invoke_claude: stdin from /dev/null, and AISDLC_HEADLESS
    # so the guard turns every `ask` into a `deny`.
    ( cd "$wt" && AISDLC_HEADLESS=1 omp "${args[@]}" "$prompt" < /dev/null ) > "$out.stream.jsonl" 2>> "$log" || rc=$?
    omp_result < "$out.stream.jsonl" > "$out"
    after="$(policy_fingerprint "$wt")"

    if [ "$before" != "$after" ]; then
        printf '[%s] the phase edited .claude/ — the policy layer is the runner'"'"'s, not the model'"'"'s\n' "$(ts)" >> "$log"
        jset "$out" '.is_error = true | .result = "the phase modified .claude/"'
        [ "$rc" -ne 0 ] || rc=1
    fi
    return $rc
}

# One headless invocation. Prints nothing; writes $out and appends to $log.
invoke_claude() {
    local prompt="$1" model="$2" budget="$3" settings="$4" wt="$5" out="$6" log="$7" use_plugin_dir="$8" billing="${9:-api}" data_only="${10}"

    local -a args=(
        -p "$prompt"
        --model "$model"
        --fallback-model sonnet
        --permission-mode bypassPermissions
        --settings "$settings"
        --output-format json
    )
    # Subscription billing: omit --max-budget-usd — a spend cap that cannot be enforced
    # reads as a guarantee and is worse than silence.
    [ "$billing" != "subscription" ] && args+=(--max-budget-usd "$budget")
    # Data-only mode: disable all tools so the model cannot perform side effects.
    [ "$data_only" = "true" ] && args+=(--tools "" --strict-mcp-config --mcp-config '{"mcpServers":{}}')
    if [ "$use_plugin_dir" = "true" ]; then
        local d
        while read -r d; do args+=(--plugin-dir "$d"); done < <(plugin_dirs)
    fi

    if [ "$billing" = "subscription" ]; then
        printf '[%s] === claude -p "%s" (model %s, billing subscription — no cost data)\n' \
            "$(ts)" "$prompt" "$model" >> "$log"
    else
        printf '[%s] === claude -p "%s" (model %s, budget $%s)\n' "$(ts)" "$prompt" "$model" "$budget" >> "$log"
    fi
    local rc=0
    # stdin from /dev/null is load-bearing: the phase loop feeds itself from a process
    # substitution, and claude reads stdin, so without this it swallows the remaining
    # phases and the task silently ships having run only the first one.
    ( cd "$wt" && AISDLC_HEADLESS=1 claude "${args[@]}" < /dev/null ) > "$out" 2>> "$log" || rc=$?
    return $rc
}

# --output-format json answers with the single result object on some CLI versions and with
# the whole message array on others. Collapse the array to its result element so every
# reader — cost, transcript, is_error and num_turns — sees one shape. Reading an array as an object yields
# 0 turns, which then reads as "the model never ran" for a call that in fact succeeded.
collapse_result() {
    local out="$1"
    if [ "$(jq -r 'type' "$out" 2>/dev/null)" = "array" ]; then
        if jq -e '[.[] | select(.type == "result")] | last' "$out" > "$out.result" 2>/dev/null; then
            mv "$out.result" "$out"
        else
            rm -f "$out.result"
        fi
    fi
}

# claude's command resolution, split out so run_phase reads as one path per runtime. Uses the
# caller's locals (dynamic scope): repo id phase wt ticket model budget settings plugin_dir
# billing out log.
run_claude_phase() {
    # Commands loaded from --plugin-dir are namespaced (/sdlc:qa); an installed plugin also
    # answers to the bare name. Guessing wrong is free to detect — the CLI rejects an unknown
    # command locally, with no tokens spent — so try the likely form, then the other. The
    # namespace comes from the manifest, so renaming the plugin needs no change here.
    local primary alternate rc=0
    if [ "$phase" = "review" ]; then
        # Review uses the PR number extracted after ship, not the ticket name.
        local pr_url pr_num=""
        pr_url="$(task_get "$repo" .pr_url "$id")"
        if [ -n "$pr_url" ]; then
            pr_num="$(printf '%s' "$pr_url" | grep -oE '/pull/[0-9]+' | grep -oE '[0-9]+' | head -1)"
            [ -z "$pr_num" ] && pr_num="$(printf '%s' "$pr_url" | grep -oE '#[0-9]+' | grep -oE '[0-9]+' | head -1)"
        fi
        if [ -z "$pr_num" ]; then
            printf '[%s] review FAILED — no PR number after ship\n' "$(ts)" >> "$log"
            printf '{"type":"result","is_error":true,"num_turns":0,"result":"error: no PR number after ship","total_cost_usd":0}\n' > "$out"
            return 1
        fi
        if [ "$plugin_dir" = "true" ]; then
            primary="/${PLUGIN_NAME}:review ${pr_num} --autofix"
            alternate="/review ${pr_num} --autofix"
        else
            primary="/review ${pr_num} --autofix"
            alternate="/${PLUGIN_NAME}:review ${pr_num} --autofix"
        fi
    elif [ "$plugin_dir" = "true" ]; then
        primary="/${PLUGIN_NAME}:${phase} ${ticket}"
        alternate="/${phase} ${ticket}"
    else
        primary="/${phase} ${ticket}"
        alternate="/${PLUGIN_NAME}:${phase} ${ticket}"
    fi

    invoke_claude "$primary" "$model" "$budget" "$settings" "$wt" "$out" "$log" "$plugin_dir" "$billing" "" || rc=$?
    if grep -q '"result":"Unknown command' "$out" 2>/dev/null; then
        printf '[%s] %s not registered — retrying as "%s"\n' "$(ts)" "${primary%% *}" "${alternate%% *}" >> "$log"
        rc=0
        invoke_claude "$alternate" "$model" "$budget" "$settings" "$wt" "$out" "$log" "$plugin_dir" "$billing" "" || rc=$?
    fi
    return $rc
}

run_phase() {
    local repo="$1" id="$2" phase="$3" wt="$4" ticket="$5"
    local dir; dir="$(task_dir "$repo" "$id")"
    local log="$dir/${phase}.log" out="$dir/${phase}.json"
    local model budget plugin_dir settings billing runtime
    model="$(jq -r --arg ph "$phase" '.models[$ph] // .model // empty' "$(task_file "$repo" "$id")" 2>/dev/null)"
    budget="$(task_get "$repo" .budget "$id")"
    plugin_dir="$(task_get "$repo" .plugin_dir "$id")"
    billing="$(task_get "$repo" .billing "$id")"
    billing="${billing:-api}"
    settings="$(state_dir "$repo")/settings.json"
    runtime="$(task_get "$repo" .runtime "$id")"; runtime="${runtime:-claude}"
    local phase_started ended session_id="" transcript=""
    if [ "$(task_get "$repo" .runtime_version "$id")" = "" ]; then
        task_set "$repo" "$id" --arg v "$("$runtime" --version 2>/dev/null | head -1 || true)" '.runtime_version = $v'
    fi
    phase_started="$(ts)"

    local rc=0
    if [ "$runtime" = "omp" ]; then
        # omp does not reject an unknown command, it forwards it to the model as text. So check
        # before spending anything that the command exists, and never guess a second form.
        if [ ! -f "$PLUGIN_ROOT/commands/${phase}.md" ]; then
            printf '[%s] %s FAILED — no command %s/commands/%s.md for omp to run\n' \
                "$(ts)" "$phase" "$PLUGIN_ROOT" "$phase" >> "$log"
            return 1
        fi
        invoke_omp "/${PLUGIN_NAME}:${phase} ${ticket}" "$model" "$budget" "$wt" "$out" "$log" "$billing" "" || rc=$?
    else
        run_claude_phase || rc=$?
    fi

    collapse_result "$out"

    ended="$(ts)"
    if [ "$runtime" = "omp" ]; then
        local jf; jf="$(ls -t "$dir/sessions/"*.jsonl 2>/dev/null | head -1 || true)"
        [ -n "$jf" ] && { session_id="$(basename "$jf" .jsonl | sed 's/^[^_]*_//')"; transcript="$jf"; }
    else
        session_id="$(jq -r '.session_id // empty' "$out" 2>/dev/null || true)"
        [ -n "$session_id" ] && transcript="$HOME/.claude/projects/$(printf '%s' "$wt" | tr '/.' '-')/${session_id}.jsonl"
    fi
    task_set "$repo" "$id" --arg ph "$phase" --arg rt "$runtime" --arg sid "$session_id" \
        --arg tr "$transcript" --arg s "$phase_started" --arg e "$ended" \
        '.sessions += [{phase:$ph,runtime:$rt,session_id:(if $sid=="" then null else $sid end),transcript:(if $tr=="" then null else $tr end),started:$s,ended:$e}]'

    # Fold this phase's cost into the task total, whatever the outcome.
    if [ "$billing" = "subscription" ]; then
        # Subscription billing carries no per-token cost data; cost_usd stays null throughout.
        : # task.json was initialised with cost_usd:null; nothing to accumulate
    else
        local cost
        cost="$(jq -r '(.total_cost_usd // .cost_usd // 0) | tostring' "$out" 2>/dev/null || echo 0)"
        case "$cost" in ''|*[!0-9.]*) cost=0 ;; esac
        # Round on every accumulation: three phases of float addition otherwise reports $0.19119999999999998.
        task_set "$repo" "$id" --argjson c "${cost:-0}" \
            '.cost_usd = (((((.cost_usd // 0) + $c) * 10000) | round) / 10000)'
    fi

    # The transcript is the useful part of the log; keep it readable.
    jq -r '.result // empty' "$out" >> "$log" 2>/dev/null || true

    local is_error turns
    is_error="$(jq -r '.is_error // false' "$out" 2>/dev/null || echo unknown)"
    turns="$(jq -r '.num_turns // 0' "$out" 2>/dev/null || echo 0)"

    # A phase that took no turns did nothing — an unregistered command, a rejected prompt, or
    # an immediate budget stop. The CLI reports that as success, so check it explicitly: a
    # silent no-op that reads as "done" is the worst possible outcome for an unattended queue.
    if [ "${turns:-0}" -eq 0 ]; then
        printf '[%s] %s FAILED — the model never ran (0 turns): %s\n' \
            "$(ts)" "$phase" "$(jq -r '.result // "no result"' "$out" 2>/dev/null)" >> "$log"
        return 1
    fi
    if [ "$rc" -ne 0 ] || [ "$is_error" = "true" ]; then
        printf '[%s] %s FAILED (exit %s, is_error %s)\n' "$(ts)" "$phase" "$rc" "$is_error" >> "$log"
        return 1
    fi

    # Review-specific outcome: CHANGES_REQUESTED means the task failed; worktree is kept.
    if [ "$phase" = "review" ]; then
        local review_result
        review_result="$(jq -r '.result // empty' "$out" 2>/dev/null || true)"
        if printf '%s' "$review_result" | grep -q 'Verdict: CHANGES_REQUESTED'; then
            printf '[%s] review FAILED — Verdict: CHANGES_REQUESTED (blockers remain)\n' "$(ts)" >> "$log"
            return 1
        fi
    fi

    printf '[%s] %s ok (%s turns)\n' "$(ts)" "$phase" "$turns" >> "$log"
    return 0
}

# --------------------------------------------------------------------------- #
# scope-check — classify changed files against the spec's declared scope
# --------------------------------------------------------------------------- #

# Extract bullet lines from a named sub-section within ## Scope in a markdown file.
# $1 = file, $2 = label (e.g. "In" or "Out") — matched as "${label}:" at line start.
_scope_bullets() {
    local file="$1" label="${2}:"
    awk -v lbl="$label" '
        BEGIN { in_scope=0; in_label=0 }
        /^## Scope[[:space:]]*$/ { in_scope=1; next }
        in_scope && /^## /       { in_scope=0; in_label=0; next }
        in_scope && $0 ~ ("^" lbl "[[:space:]]*$") { in_label=1; next }
        in_scope && in_label && /^[A-Z][a-z]*:[[:space:]]*$/ { in_label=0; next }
        in_scope && in_label && /^[-*] / { print }
    ' "$file"
}

# Extract all lines from the ## Context section.
_context_lines() {
    local file="$1"
    awk '
        BEGIN { in_ctx=0 }
        /^## Context/ { in_ctx=1; next }
        in_ctx && /^## / { in_ctx=0; next }
        in_ctx { print }
    ' "$file"
}

# Extract bullet lines from ## Repo-wide out of bounds in sdlc.md (HTML comments skipped).
_oob_bullets() {
    local file="$1"
    awk '
        BEGIN { in_oob=0 }
        /^## Repo-wide out of bounds/ { in_oob=1; next }
        in_oob && /^## /              { in_oob=0; next }
        in_oob && /^[-*] / && !/<!--/ { print }
    ' "$file"
}

# From text, extract backtick-quoted path-like tokens (one per line).
# Conservative: only tokens containing / . or glob chars; tokens containing : (command
# references like /sdlc:ship) and plain identifiers are filtered. Line-number suffixes
# like :28 or :643-740 are stripped before the colon test.
_path_tokens() {
    local text="$1"
    [ -z "$text" ] && return 0
    printf '%s\n' "$text" | grep -oE '`[^`]+`' | tr -d '`' | while IFS= read -r tok; do
        tok="$(printf '%s' "$tok" | sed 's/:[0-9][0-9-]*$//')"
        case "$tok" in *:*) continue ;; esac
        tok="$(printf '%s' "$tok" | sed 's/<[^>]*>/*/g')"
        case "$tok" in
            */*|*.*|\**|*\*) printf '%s\n' "$tok" ;;
        esac
    done
}

# Returns 0 if file $1 matches path-glob pattern $2.
# Handles: exact, directory prefix (trailing /), single-level *, multi-level **.
_glob_match() {
    local file="$1" pat="$2"
    file="${file#./}"; pat="${pat#./}"
    [ "$file" = "$pat" ] && return 0
    # Directory prefix: pattern ends with /
    if [ "${pat%/}" != "$pat" ]; then
        case "$file" in "${pat%/}"|"${pat%/}"/*)  return 0 ;; esac
        return 1
    fi
    # ** pattern: require the prefix before ** to match
    if printf '%s' "$pat" | grep -qF '**'; then
        local pre="${pat%%\*\**}"
        if [ -n "$pre" ]; then
            case "$file" in "${pre}"*) return 0 ;; esac
        else
            return 0  # bare ** matches everything
        fi
        return 1
    fi
    # Standard single-level glob (unquoted intentional for glob expansion)
    # shellcheck disable=SC2254
    case "$file" in $pat) return 0 ;; esac
    return 1
}

# Write scope-report.md.
# oob lines are pipe-delimited "reason|filepath" pairs.
_write_scope_report() {
    local out="$1" ticket="$2" base="$3" in_files="$4" undeclared="$5" oob="$6" verdict="$7"
    {
        printf '# Scope report — %s\n\n' "$ticket"
        [ "$verdict" = "GAPS" ] && \
            printf '> **GAPS** — Some changed files were not declared in the spec scope.\n\n'
        [ "$verdict" = "BLOCKED" ] && \
            printf '> **BLOCKED** — Changed files violate out-of-bounds rules.\n\n'
        printf 'Base: `%s`  \nChecked: %s\n\n' "$base" "$(ts)"
        printf '## File classification\n\n'
        printf '| File | Classification |\n|------|----------------|\n'
        if [ -n "$in_files" ]; then
            while IFS= read -r f; do
                [ -n "$f" ] && printf '| `%s` | in scope |\n' "$f"
            done <<< "$in_files"
        fi
        if [ -n "$undeclared" ]; then
            while IFS= read -r f; do
                [ -n "$f" ] && printf '| `%s` | **undeclared** |\n' "$f"
            done <<< "$undeclared"
        fi
        if [ -n "$oob" ]; then
            while IFS= read -r line; do
                [ -n "$line" ] || continue
                local reason="${line%%|*}" f="${line#*|}"
                printf '| `%s` | **out of bounds** (%s) |\n' "$f" "$reason"
            done <<< "$oob"
        fi
        local ni=0 nu=0 nb=0
        [ -n "$in_files" ]   && ni="$(printf '%s\n' "$in_files"   | grep -c .)" || true
        [ -n "$undeclared" ] && nu="$(printf '%s\n' "$undeclared" | grep -c .)" || true
        [ -n "$oob" ]        && nb="$(printf '%s\n' "$oob"        | grep -c .)" || true
        printf '\n## Verdict\n\nVerdict: %s\n\n%d in scope · %d undeclared · %d out of bounds\n' \
            "$verdict" "$ni" "$nu" "$nb"
    } > "$out"
}

# Paths that never count against a change budget: generated output, vendored trees, lock
# files and the pipeline's own artefacts. Growth there is not review surface.
# Backslashes are doubled: the pattern travels through awk -v, which unescapes once.
_SIZE_EXCLUDE='(^|/)(vendor|node_modules|dist|build|target|__generated__|__snapshots__)/|(^|/)(package-lock\\.json|yarn\\.lock|pnpm-lock\\.yaml|composer\\.lock|Cargo\\.lock|go\\.sum|poetry\\.lock|Gemfile\\.lock|uv\\.lock)$|\\.(snap|pb\\.go|pb2\\.py)$|\\.generated\\.[a-z]+$'

# Measure the review surface of a branch: added lines, files touched, modules touched.
# Deleted lines never count — a change that removes code is not a big change to review.
# A module is the first two path segments (or the first, for a top-level file); that is the
# unit a reviewer holds in their head, and the unit shotgun surgery scatters across.
# Prints: "<added> <files> <modules> <comma-separated module list>".
_size_stats() {
    local wt="$1" base="$2" specs_dir="$3"
    git -C "$wt" diff --numstat "${base}...HEAD" 2>/dev/null | awk \
        -v specs="$specs_dir" -v excl="$_SIZE_EXCLUDE" '
        $1 == "-" { next }                                   # binary blob
        {
            path = $3
            sub(/.*=> /, "", path); sub(/}$/, "", path)      # rename: {a => b}
            if (specs != "" && index(path, specs "/") == 1) next
            if (path ~ excl) next
            added += $1; files++
            n = split(path, seg, "/")
            mod = (n >= 2) ? seg[1] "/" seg[2] : seg[1]
            if (!(mod in seen)) {
                seen[mod] = 1; mods++
                modlist = modlist (modlist == "" ? "" : ",") mod
            }
        }
        END { printf "%d %d %d %s\n", added + 0, files + 0, mods + 0, modlist }'
}

# Read one budget number. Spec wins over profile, profile over the built-in default.
# Spec form (inside ## Scope):  Change budget: 400 added lines, 15 files, 3 modules
# Profile form (## Change budget): - **Added lines:** 400
_budget_spec() {
    local file="$1" unit="$2"
    [ -f "$file" ] || return 0
    sed -n 's/^Change budget:[[:space:]]*//p' "$file" | head -1 | \
        grep -oE "[0-9]+[[:space:]]+(added[[:space:]]+lines|files|modules)" | \
        awk -v u="$unit" '$0 ~ u { print $1; exit }'
}
_budget_profile() {
    local file="$1" label="$2"
    [ -f "$file" ] || return 0
    awk -v lbl="$label" '
        /^## Change budget/ { in_b = 1; next }
        in_b && /^## /      { in_b = 0 }
        in_b && $0 ~ ("\\*\\*" lbl ":\\*\\*") {
            if (match($0, /[0-9]+/)) { print substr($0, RSTART, RLENGTH); exit }
        }' "$file"
}
budget_value() {
    local spec="$1" profile="$2" unit="$3" label="$4" fallback="$5" v
    v="$(_budget_spec "$spec" "$unit")"
    [ -n "$v" ] || v="$(_budget_profile "$profile" "$label")"
    [ -n "$v" ] || v="$fallback"
    printf '%s' "$v"
}

# Judge a measured branch against its budget. Prints one finding per line.
# Returns 0 clean, 1 over budget (GAPS), 2 past the hard ceiling (BLOCKED).
# Finding text stays ASCII: it travels through read loops into the report and into review
# findings, and a mangled byte there is a mangled byte in the pull request.
_size_eval() {
    local added="$1" n_files="$2" n_mods="$3" modlist="$4" \
          b_added="$5" b_files="$6" b_mods="$7" ceiling="$8" tolerance="$9"
    local out="" rc=0 per_file=0 lim_added lim_files lim_mods lbl
    lim_added=$((b_added + b_added * tolerance / 100))
    lim_files=$((b_files + b_files * tolerance / 100))
    lim_mods=$((b_mods + b_mods * tolerance / 100))
    [ "$n_files" -gt 0 ] && per_file=$((added / n_files))
    if [ "$added" -gt "$lim_added" ]; then
        [ "$tolerance" -gt 0 ] && lbl="$lim_added ($b_added + $tolerance% tolerance)" || lbl="$b_added"
        out="${out}over budget: $added added lines > $lbl. One spec is one PR: split it (spec-authoring, Sizing)"$'\n'
        rc=1
    fi
    if [ "$n_files" -gt "$lim_files" ]; then
        [ "$tolerance" -gt 0 ] && lbl="$lim_files ($b_files + $tolerance% tolerance)" || lbl="$b_files"
        out="${out}over budget: $n_files files touched > $lbl"$'\n'
        rc=1
    fi
    if [ "$n_mods" -gt "$lim_mods" ]; then
        [ "$tolerance" -gt 0 ] && lbl="$lim_mods ($b_mods + $tolerance% tolerance)" || lbl="$b_mods"
        out="${out}over budget: $n_mods modules touched > $lbl ($modlist)"$'\n'
        rc=1
    fi
    # Shotgun surgery: many modules, thin edits in each. One behaviour smeared across the
    # tree; the fix is a seam of its own, in its own slice, not a wider pull request.
    if [ "$n_mods" -gt "$lim_mods" ] && [ "$per_file" -lt 10 ]; then
        out="${out}shotgun surgery: $n_mods modules, ~$per_file added lines per file. Extract the shared seam as its own slice, then move one caller group per slice"$'\n'
        rc=1
    fi
    if [ "$added" -gt "$ceiling" ]; then
        out="${out}hard ceiling: $added added lines > $ceiling. Nobody reviews this: run /sdlc:decompose before ship"$'\n'
        rc=2
    fi
    printf '%s' "$out"
    return "$rc"
}

# Append the size section to a scope report. ${10} is the newline-separated findings list.
_write_size_section() {
    local out="$1" added="$2" files="$3" mods="$4" modlist="$5" \
          b_added="$6" b_files="$7" b_mods="$8" ceiling="$9" findings="${10}" tolerance="${11}"
    local sfx=""
    [ "$tolerance" -gt 0 ] && sfx=" +$tolerance%"
    {
        printf '\n## Size\n\n'
        printf '| Measure | This branch | Budget |\n|---|---|---|\n'
        printf '| Added lines | %s | %s%s (hard ceiling %s) |\n' "$added" "$b_added" "$sfx" "$ceiling"
        printf '| Files touched | %s | %s%s |\n' "$files" "$b_files" "$sfx"
        printf '| Modules touched | %s | %s%s |\n' "$mods" "$b_mods" "$sfx"
        printf '\nModules: %s\n' "${modlist:-none}"
        printf '\nGenerated output, vendored trees, lock files and the specs directory are\n'
        printf 'excluded; deleted lines never count against the budget.\n'
        if [ -n "$findings" ]; then
            printf '\n### Findings\n\n'
            while IFS= read -r f; do
                [ -n "$f" ] && printf -- '- %s\n' "$f"
            done <<< "$findings"
        fi
    } >> "$out"
}

# --------------------------------------------------------------------------- #
# structure check — SlopCodeBench erosion (arXiv 2603.24755 v2 §2.3)
# --------------------------------------------------------------------------- #

# Like _budget_profile but handles floating-point values (e.g. "0.05").
# Uses literal index() matching to avoid regex metachar issues with **.
_budget_profile_float() {
    local file="$1" label="$2"
    [ -f "$file" ] || return 0
    awk -v lbl="$label" '
        /^## Change budget/ { in_b = 1; next }
        in_b && /^## /      { in_b = 0; next }
        in_b {
            marker = "**" lbl ":**"
            pos = index($0, marker)
            if (pos > 0) {
                val = substr($0, pos + length(marker))
                gsub(/^[[:space:]]+/, "", val)
                gsub(/[[:space:]].*/, "", val)
                if (val ~ /^[0-9]/) { print val; exit }
            }
        }' "$file"
}

# Get changed code files (Added/Modified/Renamed, filtered by extension and exclusion rules).
# Prints "<status> <after-path>" per line; status is A, M, or R.
# Bash/shell files are excluded (lizard has no shell parser).
_struct_code_files() {
    local wt="$1" base="$2" specs_dir="$3"
    git -C "$wt" diff --diff-filter=AMR --name-status "${base}...HEAD" 2>/dev/null | awk \
        -v specs="$specs_dir" -v excl="$_SIZE_EXCLUDE" '
        {
            status = substr($1, 1, 1)
            path = $NF
            if (specs != "" && index(path, specs "/") == 1) next
            if (path ~ excl) next
            n = split(path, seg, ".")
            ext = seg[n]
            if (ext !~ /^(py|js|jsx|mjs|cjs|ts|tsx|mts|cts|go|php|java|kt|kts|cs|rb|rs)$/) next
            print status " " path
        }'
}

# Analyze before/after lizard CSV data; paths may carry a prefix that is stripped.
# Prints structured pipe-separated records (one per line):
#   erosion_before|<val>
#   erosion_after|<val>
#   new_hotspot|<name>|<cc_before>|<cc_after>|<sloc>    (zero or more)
#   hotspot25|<name>|<cc_before>|<cc_after>|<sloc>      (zero or more)
#   largest_increase|<name>|<cc_before>|<cc_after>|<sloc>   (at most one)
# mass(f) = CC(f) * sqrt(SLOC(f)); erosion = sum(mass, CC>10) / sum(mass); 0 when sum=0.
_struct_analyze() {
    local before_csv="$1" after_csv="$2" bpfx="${3:-}" apfx="${4:-}"
    {
        printf '%s\n' "$before_csv"
        printf '%s\n' "---AFTER---"
        printf '%s\n' "$after_csv"
    } | awk -F, -v bpfx="$bpfx" -v apfx="$apfx" '
    BEGIN { pass = "before" }
    /^---AFTER---$/ { pass = "after"; next }
    /^NLOC,/        { next }   # header line
    NF < 9          { next }   # malformed
    {
        nloc = $1+0; cc = $2+0
        file = $7; long_name = $9
        gsub(/^[[:space:]"]+|[[:space:]"]+$/, "", file)
        gsub(/^[[:space:]"]+|[[:space:]"]+$/, "", long_name)
        pfx = (pass == "before") ? bpfx : apfx
        if (pfx != "" && index(file, pfx) == 1) file = substr(file, length(pfx)+1)
        sub(/^\//, "", file)
        key = file "|" long_name
        m = cc * sqrt(nloc)
        if (pass == "before") {
            b_nloc[key] = nloc; b_cc[key] = cc
            b_total += m
            if (cc > 10) b_hot += m
        } else {
            a_nloc[key] = nloc; a_cc[key] = cc
            a_total += m
            if (cc > 10) a_hot += m
        }
    }
    END {
        b_ero = (b_total > 0) ? b_hot/b_total : 0
        a_ero = (a_total > 0) ? a_hot/a_total : 0
        printf "erosion_before|%.4f\n", b_ero
        printf "erosion_after|%.4f\n",  a_ero
        max_inc = -1; max_name = ""; max_cb = 0; max_ca = 0; max_sl = 0
        for (key in a_cc) {
            cc_a = a_cc[key]; nl_a = a_nloc[key]
            cc_b = (key in b_cc) ? b_cc[key] : 0
            if (cc_a > 10 && cc_b <= 10) {
                split(key, kp, "|"); printf "new_hotspot|%s|%d|%d|%d\n", kp[2], cc_b, cc_a, nl_a
            }
            if (cc_a > 25 && cc_b <= 25) {
                split(key, kp, "|"); printf "hotspot25|%s|%d|%d|%d\n", kp[2], cc_b, cc_a, nl_a
            }
            inc = cc_a - cc_b
            if (inc > max_inc) {
                max_inc = inc; split(key, kp, "|")
                max_name = kp[2]; max_cb = cc_b; max_ca = cc_a; max_sl = nl_a
            }
        }
        if (max_name != "") printf "largest_increase|%s|%d|%d|%d\n", max_name, max_cb, max_ca, max_sl
    }'
}

# Build the body of the ## Structure section from analysis records and thresholds.
# Prints the section body (erosion line, table, largest-increase line, findings).
# Structure findings NEVER block (they promote PASS→GAPS only).
_struct_text() {
    local records="$1" erosion_max="${2:-$BUILTIN_STRUCT_EROSION_MAX}" hotspot_max="${3:-$BUILTIN_STRUCT_HOTSPOT_MAX}"
    local b_ero a_ero nh_count h25_count li_line
    b_ero="$(printf '%s\n' "$records" | awk -F'|' '/^erosion_before\|/{print $2; exit}')"
    a_ero="$(printf '%s\n' "$records" | awk -F'|' '/^erosion_after\|/{print $2; exit}')"
    nh_count="$(printf '%s\n' "$records" | awk '/^new_hotspot\|/{n++} END{print n+0}')"
    h25_count="$(printf '%s\n' "$records" | awk '/^hotspot25\|/{n++} END{print n+0}')"
    li_line="$(printf '%s\n' "$records" | grep '^largest_increase|' || true)"

    printf 'Erosion: %s -> %s\n\n' \
        "$(awk -v v="${b_ero:-0}" 'BEGIN{printf "%.2f",v+0}')" \
        "$(awk -v v="${a_ero:-0}" 'BEGIN{printf "%.2f",v+0}')"

    # Table of newly-crossing functions (all new_hotspot entries)
    if [ "${nh_count:-0}" -gt 0 ]; then
        printf '| Function | CC | SLOC |\n|----------|----|------|\n'
        while IFS='|' read -r _t name cc_b cc_a sloc; do
            printf '| %s | %s -> %s | %s |\n' "$name" "$cc_b" "$cc_a" "$sloc"
        done < <(printf '%s\n' "$records" | grep '^new_hotspot|')
        printf '\n'
    fi

    # Largest CC increase line
    if [ -n "$li_line" ]; then
        local _t li_name li_cb li_ca li_sl
        IFS='|' read -r _t li_name li_cb li_ca li_sl <<< "$li_line"
        printf 'Largest CC increase: %s %s -> %s (SLOC %s)\n' "$li_name" "$li_cb" "$li_ca" "$li_sl"
    fi

    # Findings section (structure never causes BLOCKED)
    local has_finding=0

    # Erosion finding: delta > max
    local delta
    delta="$(awk -v b="${b_ero:-0}" -v a="${a_ero:-0}" 'BEGIN{printf "%.4f", (a+0)-(b+0)}')"
    if awk -v d="$delta" -v m="${erosion_max}" 'BEGIN{exit (d+0 > m+0) ? 0 : 1}'; then
        [ "$has_finding" -eq 0 ] && { printf '\n### Findings\n\n'; has_finding=1; }
        printf -- '- erosion: %s -> %s (delta %s, max %s)\n' \
            "$(awk -v v="${b_ero:-0}" 'BEGIN{printf "%.2f",v+0}')" \
            "$(awk -v v="${a_ero:-0}" 'BEGIN{printf "%.2f",v+0}')" \
            "$(awk -v v="$delta"      'BEGIN{printf "%.2f",v+0}')" \
            "$erosion_max"
    fi

    # New hotspot findings: count > max
    if [ "${nh_count:-0}" -gt "${hotspot_max:-0}" ]; then
        while IFS='|' read -r _t name cc_b cc_a sloc; do
            [ "$has_finding" -eq 0 ] && { printf '\n### Findings\n\n'; has_finding=1; }
            printf -- '- new hotspot: %s CC %s -> %s SLOC %s\n' "$name" "$cc_b" "$cc_a" "$sloc"
        done < <(printf '%s\n' "$records" | grep '^new_hotspot|')
    fi

    # Hotspot over 25 findings: always, regardless of max
    if [ "${h25_count:-0}" -gt 0 ]; then
        while IFS='|' read -r _t name cc_b cc_a sloc; do
            [ "$has_finding" -eq 0 ] && { printf '\n### Findings\n\n'; has_finding=1; }
            printf -- '- hotspot over 25: %s CC %s -> %s SLOC %s\n' "$name" "$cc_b" "$cc_a" "$sloc"
        done < <(printf '%s\n' "$records" | grep '^hotspot25|')
    fi
}

# Append the ## Structure section to a scope report.
# $1=report-file, $2=section-body-text (empty string → skip)
_write_structure_section() {
    local out="$1" body="$2"
    { printf '\n## Structure\n\n'; printf '%s\n' "$body"; } >> "$out"
}

# Run lizard before/after and return analysis records, or a skip:<reason> string.
# $1=wt $2=base $3=specs_dir
# Prints records (for _struct_text) or "skip:<reason>" on stdout; always returns 0.
_struct_run_lizard() {
    local wt="$1" base="$2" specs_dir="$3"

    local code_files_raw
    code_files_raw="$(_struct_code_files "$wt" "$base" "$specs_dir")"
    [ -n "$code_files_raw" ] || { printf 'skip:nofiles'; return 0; }

    command -v lizard >/dev/null 2>&1 || { printf 'skip:skipped: lizard not installed'; return 0; }

    # Prepare temp dir for before-versions of Modified files
    local tmp; tmp="$(mktemp -d)"
    local before_files=() after_files=()

    while IFS=' ' read -r status path; do
        after_files+=("$wt/$path")
        if [ "$status" = "M" ]; then
            local bdir; bdir="$(dirname "$tmp/$path")"
            mkdir -p "$bdir"
            if git -C "$wt" show "${base}:${path}" > "$tmp/$path" 2>/dev/null; then
                before_files+=("$tmp/$path")
            fi
        fi
    done <<< "$code_files_raw"

    # Before pass (Modified files only — Added/Renamed count as new, no before)
    local before_csv="" _ec
    if [ ${#before_files[@]} -gt 0 ]; then
        before_csv="$(_AISDLC_STRUCT_PASS=before lizard --csv "${before_files[@]}" 2>/dev/null)"; _ec=$?
        if [ "$_ec" -ne 0 ]; then
            rm -rf "$tmp"
            printf 'skip:skipped: lizard failed (%d)' "$_ec"
            return 0
        fi
        # Valid CSV: empty output (no functions found), or every non-empty line either is a
        # tolerated header or starts with five integers then a double-quoted field (lizard 1.24.x)
        if printf '%s\n' "$before_csv" | grep -qEv '^[[:space:]]*$|^NLOC,|^[0-9]+,[0-9]+,[0-9]+,[0-9]+,[0-9]+,"'; then
            rm -rf "$tmp"
            printf 'skip:skipped: lizard failed (unparseable output)'
            return 0
        fi
    fi

    # After pass (all code files at HEAD)
    local after_csv
    after_csv="$(lizard --csv "${after_files[@]}" 2>/dev/null)"; _ec=$?
    if [ "$_ec" -ne 0 ]; then
        rm -rf "$tmp"
        printf 'skip:skipped: lizard failed (%d)' "$_ec"
        return 0
    fi
    # Valid CSV: empty output (no functions found), or every non-empty line either is a
    # tolerated header or starts with five integers then a double-quoted field (lizard 1.24.x)
    if printf '%s\n' "$after_csv" | grep -qEv '^[[:space:]]*$|^NLOC,|^[0-9]+,[0-9]+,[0-9]+,[0-9]+,[0-9]+,"'; then
        rm -rf "$tmp"
        printf 'skip:skipped: lizard failed (unparseable output)'
        return 0
    fi

    local bpfx="${tmp}/" apfx="${wt}/"
    _struct_analyze "$before_csv" "$after_csv" "$bpfx" "$apfx"
    rm -rf "$tmp"
}


# _branch_changes <wt> <base> <task-specdir-relative> [git-diff-options...]
# Stdout: files changed on the branch (git diff --name-only "${base}...HEAD"), with the
# task's own spec directory, AGENTS.md, CLAUDE.md, and the .claude/ subtree excluded.
# The task-specdir-relative arg is matched as a literal path prefix (e.g. specs/SBX-1).
# Optional trailing arguments are passed verbatim to git diff (e.g. --diff-filter=AMR).
# Only the named task's spec directory is excluded; sibling tickets remain visible.
_branch_changes() {
    local wt="$1" base="$2" task_specdir="$3"; shift 3
    git -C "$wt" diff --name-only "$@" "${base}...HEAD" 2>/dev/null \
        | awk -v dir="${task_specdir}" '
            index($0, dir "/") == 1  { next }
            $0 == "AGENTS.md"        { next }
            $0 == "CLAUDE.md"        { next }
            index($0, ".claude/") == 1 { next }
            { print }
        ' \
        || true
}


# Native scope-check phase: classify the branch's changed files against the spec's
# declared scope (In:/Out:/Context) and the project's repo-wide out-of-bounds list.
# Writes specs/<TICKET>/scope-report.md and commits it. Records scope_verdict in
# task.json. Returns 1 on BLOCKED (stops the pipeline); 0 on PASS or GAPS.
run_scope_check() {
    local repo="$1" id="$2" wt="$3" ticket="$4" specs_dir="$5" base="$6"
    local dir; dir="$(task_dir "$repo" "$id")"
    local log="$dir/scope-check.log"
    local spec_file="$wt/$specs_dir/$ticket/spec.md"
    local profile="$wt/.claude/sdlc.md"
    local report_wt="$wt/$specs_dir/$ticket/scope-report.md"

    printf '[%s] scope-check begin (base %s)\n' "$(ts)" "$base" >> "$log"

    local changed
    changed="$(_branch_changes "$wt" "$base" "$specs_dir/$ticket")"

    if [ -z "$changed" ] && git -C "$wt" diff --quiet "${base}...HEAD" 2>/dev/null; then
        printf '[%s] scope-check: no changed files — PASS\n' "$(ts)" >> "$log"
        mkdir -p "$wt/$specs_dir/$ticket"
        _write_scope_report "$report_wt" "$ticket" "$base" "" "" "" "PASS"
        git -C "$wt" add "$specs_dir/$ticket/scope-report.md" >> "$log" 2>&1
        git -C "$wt" -c user.name=aisdlc -c user.email=aisdlc@localhost \
            commit -q -m "docs(scope): scope report for $ticket [PASS]" >> "$log" 2>&1
        cp "$report_wt" "$dir/scope-report.md"
        task_set "$repo" "$id" --arg v "PASS" '.scope_verdict = $v'
        return 0
    fi

    local in_pats="" out_pats="" prohibited_pats="" in_verbatim=""
    if [ -f "$spec_file" ]; then
        local in_bullets out_bullets ctx
        in_bullets="$(_scope_bullets "$spec_file" "In")"
        out_bullets="$(_scope_bullets "$spec_file" "Out")"
        ctx="$(_context_lines "$spec_file")"
        in_pats="$(_path_tokens "${in_bullets}"$'\n'"${ctx}")"
        out_pats="$(_path_tokens "$out_bullets")"
        # Verbatim In: paths only — exclude globs (* ? [) and directory patterns (trailing /).
        # A file matching one of these exact paths is exempt from spec-Out matching (step 1)
        # but not from repo-wide prohibited paths (step 2). GH-54.
        in_verbatim="$(_path_tokens "$in_bullets" | grep -Ev '[*?[]|/$' || true)"
    fi
    if [ -f "$profile" ]; then
        local oob_b
        oob_b="$(_oob_bullets "$profile")"
        prohibited_pats="$(_path_tokens "$oob_b")"
    fi

    printf '[%s] in-pats: %s\n'          "$(ts)" "${in_pats//$'\n'/ | }"          >> "$log"
    printf '[%s] out-pats: %s\n'         "$(ts)" "${out_pats//$'\n'/ | }"         >> "$log"
    printf '[%s] prohibited-pats: %s\n'  "$(ts)" "${prohibited_pats//$'\n'/ | }"  >> "$log"

    local in_files="" undeclared="" oob=""
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        local classified=0 skip_spec_out=0 vp
        # 1. Spec Out: — explicit out-of-bounds.  Skip for verbatim In: files (GH-54).
        if [ -n "$in_verbatim" ]; then
            while IFS= read -r vp; do
                [ -n "$vp" ] || continue
                [ "${f#./}" = "${vp#./}" ] && { skip_spec_out=1; break; }
            done <<< "$in_verbatim"
        fi
        if [ "$skip_spec_out" -eq 0 ] && [ -n "$out_pats" ]; then
            while IFS= read -r pat; do
                [ -n "$pat" ] || continue
                _glob_match "$f" "$pat" && {
                    oob="${oob:+$oob$'\n'}spec-out|$f"; classified=1; break
                }
            done <<< "$out_pats"
        fi
        [ "$classified" -eq 1 ] && continue
        # 2. Repo-wide prohibitions from .claude/sdlc.md
        if [ -n "$prohibited_pats" ]; then
            while IFS= read -r pat; do
                [ -n "$pat" ] || continue
                _glob_match "$f" "$pat" && {
                    oob="${oob:+$oob$'\n'}prohibited|$f"; classified=1; break
                }
            done <<< "$prohibited_pats"
        fi
        [ "$classified" -eq 1 ] && continue
        # 3. In scope (spec In: + Context)
        if [ -n "$in_pats" ]; then
            while IFS= read -r pat; do
                [ -n "$pat" ] || continue
                _glob_match "$f" "$pat" && {
                    in_files="${in_files:+$in_files$'\n'}$f"; classified=1; break
                }
            done <<< "$in_pats"
        fi
        [ "$classified" -eq 1 ] && continue
        # 5. Undeclared — conservative default
        undeclared="${undeclared:+$undeclared$'\n'}$f"
    done <<< "$changed"

    local verdict="PASS"
    [ -n "$oob" ] && verdict="BLOCKED"
    [ -n "$undeclared" ] && [ "$verdict" = "PASS" ] && verdict="GAPS"

    # Size budget. Deleted lines and generated paths are excluded upstream, so these three
    # numbers are the review surface a human actually has to hold.
    local stats added n_files n_mods modlist
    stats="$(_size_stats "$wt" "$base" "$specs_dir")"
    added="$(printf '%s' "$stats" | awk '{print $1}')"
    n_files="$(printf '%s' "$stats" | awk '{print $2}')"
    n_mods="$(printf '%s' "$stats" | awk '{print $3}')"
    modlist="$(printf '%s' "$stats" | awk '{print $4}')"

    local b_added b_files b_mods ceiling tolerance
    b_added="$(budget_value  "$spec_file" "$profile" 'added lines' 'Added lines'  "$BUILTIN_BUDGET_ADDED")"
    b_files="$(budget_value  "$spec_file" "$profile" 'files'       'Files'        "$BUILTIN_BUDGET_FILES")"
    b_mods="$(budget_value   "$spec_file" "$profile" 'modules'     'Modules'      "$BUILTIN_BUDGET_MODULES")"
    ceiling="$(_budget_profile "$profile" 'Hard ceiling')"
    [ -n "$ceiling" ] || ceiling="$BUILTIN_BUDGET_CEILING"
    tolerance="$(_budget_profile "$profile" 'Tolerance')"
    [ -n "$tolerance" ] || tolerance=0

    local size_findings="" size_rc=0
    size_findings="$(_size_eval "$added" "$n_files" "$n_mods" "$modlist" \
        "$b_added" "$b_files" "$b_mods" "$ceiling" "$tolerance")"; size_rc=$?
    if [ "$size_rc" -eq 2 ]; then
        verdict="BLOCKED"
    elif [ "$size_rc" -eq 1 ] && [ "$verdict" = "PASS" ]; then
        verdict="GAPS"
    fi

    mkdir -p "$wt/$specs_dir/$ticket"
    _write_scope_report "$report_wt" "$ticket" "$base" "$in_files" "$undeclared" "$oob" "$verdict"
    _write_size_section "$report_wt" "$added" "$n_files" "$n_mods" "$modlist" \
        "$b_added" "$b_files" "$b_mods" "$ceiling" "$size_findings" "$tolerance"

    # Structure check — SlopCodeBench erosion; never causes BLOCKED.
    local erosion_max hotspot_max struct_result struct_body
    erosion_max="$(_budget_profile_float "$profile" 'Erosion delta max')"
    [ -n "$erosion_max" ] || erosion_max="$BUILTIN_STRUCT_EROSION_MAX"
    hotspot_max="$(_budget_profile "$profile" 'New hotspots max')"
    [ -n "$hotspot_max" ] || hotspot_max="$BUILTIN_STRUCT_HOTSPOT_MAX"

    struct_result="$(_struct_run_lizard "$wt" "$base" "$specs_dir")"
    case "$struct_result" in
        skip:nofiles)
            # No code files changed — omit the ## Structure section entirely
            printf '[%s] scope-check: structure skipped (no code files)\n' "$(ts)" >> "$log"
            struct_body=""
            ;;
        skip:*)
            struct_body="${struct_result#skip:}"
            printf '[%s] scope-check: structure %s\n' "$(ts)" "$struct_body" >> "$log"
            _write_structure_section "$report_wt" "$struct_body"
            struct_body=""  # already written, mark as handled
            ;;
        *)
            struct_body="$(_struct_text "$struct_result" "$erosion_max" "$hotspot_max")"
            _write_structure_section "$report_wt" "$struct_body"
            if printf '%s' "$struct_body" | grep -q '^### Findings'; then
                [ "$verdict" = "PASS" ] && verdict="GAPS"
            fi
            struct_body=""  # already written
            ;;
    esac

    git -C "$wt" add "$specs_dir/$ticket/scope-report.md" >> "$log" 2>&1
    git -C "$wt" -c user.name=aisdlc -c user.email=aisdlc@localhost \
        commit -q -m "docs(scope): scope report for $ticket [$verdict]" >> "$log" 2>&1
    cp "$report_wt" "$dir/scope-report.md"
    task_set "$repo" "$id" --arg v "$verdict" '.scope_verdict = $v'
    printf '[%s] scope-check: %s\n' "$(ts)" "$verdict" >> "$log"

    [ "$verdict" = "BLOCKED" ] && return 1
    return 0
}

# Manual re-run for an existing worktree: aisdlc scope-check <id> [--repo .]
cmd_scope_check() {
    local repo="." id=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --repo) repo="$2"; shift 2 ;;
            -*)     die "unknown flag for scope-check: $1" ;;
            *)      id="$1"; shift ;;
        esac
    done
    [ -n "$id" ] || die "usage: aisdlc scope-check <id> [--repo .]"
    repo="$(resolve_repo "$repo")"
    local wt ticket specs_dir base
    wt="$(task_get "$repo" .worktree "$id")"
    ticket="$(task_get "$repo" .ticket "$id")"
    specs_dir="$(task_get "$repo" .specs_dir "$id")"
    base="$(task_get "$repo" .base "$id")"
    [ -n "$specs_dir" ] || specs_dir="$BUILTIN_SPECS_DIR"
    [ -d "$wt" ] || die "no worktree for task $id — run it first"
    run_scope_check "$repo" "$id" "$wt" "$ticket" "$specs_dir" "$base"
}

# --------------------------------------------------------------------------- #
# verify — the repository's own answer, on the final commit, before anything is pushed
# --------------------------------------------------------------------------- #
#
# Everything before this is either a model's report or a classification of paths. This runs the
# commands a human would run before opening the PR, and reads from git what no report can hide:
#   1. .aisdlc/config.json `verify` — a list of shell commands, run in the worktree in order.
#      None configured is a FAIL, not a skip: a gate that silently passes when unconfigured is
#      how a pipeline ships untested code while every report says PASS.
#   2. every UC-<n> in the spec's acceptance table appears in at least one test file this branch
#      added or changed — the traceability dense-testing asks for, checked rather than claimed.
#   3. no test file deleted, and no .skip/.only/xit/t.Skip-style switch added to a test file.
#      A deletion listed with a reason in .claude/retired-tests as it stands at the merge base
#      is a human's retirement, not a weakening — the same ledger, read the same way, as the
#      guard's Stop hook in a headless run. An entry the branch added itself does not count.

# A path that is a test file, by the conventions of the stacks this plugin supports.
# Bash: *_test.sh, test_*.sh, *.bats, and a harness's selftest.sh outside any tests/ directory.
_is_test_path() {
    printf '%s' "$1" | grep -qE '(^|/)(tests?|__tests__|e2e)/|[._-](test|spec)\.[a-z0-9]+$|_test\.(go|py|sh)$|(^|/)test_[^/]*\.(py|sh)$|\.bats$|(^|/)selftest\.sh$'
}

# _retired_patterns WT REV — path patterns of the retired-tests ledger entries that carry a reason, as of REV.
# Format as the guard reads it: `<path-or-glob> <reason>` per line, `#` comments.
_retired_patterns() {
    git -C "$1" show "$2:.claude/retired-tests" 2>/dev/null | awk '$1 !~ /^#/ && NF >= 2 {print $1}'
}

# Writes <specs>/<TICKET>/verify-report.md, commits it, records .verify_verdict.
# Returns 1 on FAIL (the pipeline stops before ship); 0 on PASS.
run_verify() {
    local repo="$1" id="$2" wt="$3" ticket="$4" specs_dir="$5" base="$6"
    local dir; dir="$(task_dir "$repo" "$id")"
    local log="$dir/verify.log" spec_file="$wt/$specs_dir/$ticket/spec.md"
    local report_wt="$wt/$specs_dir/$ticket/verify-report.md"
    local -a rows=() failures=()

    printf '[%s] verify begin (base %s)\n' "$(ts)" "$base" >> "$log"

    # 0. The commands below run in the worktree, so they see the working tree, not the commit that
    #    will be pushed. A phase that fixed the code but committed only the test leaves a branch
    #    whose tests fail and a working tree whose tests pass — seen live, with a QA PASS on top.
    #    Anything uncommitted and not ignored means the checks would judge something the PR
    #    does not contain.
    local dirty
    dirty="$(git -C "$wt" status --porcelain --untracked-files=all 2>/dev/null | cut -c4- \
        | grep -vE '^(\.claude/|\.aisdlc-)' | head -10 || true)"
    if [ -n "$dirty" ]; then
        rows+=("| committed | **FAIL** | uncommitted: $(printf '%s' "$dirty" | tr '\n' ' ' | cut -c1-200)|")
        failures+=("uncommitted changes the PR would not contain: $(printf '%s' "$dirty" | tr '\n' ' ' | cut -c1-120)")
    else
        rows+=("| committed | PASS | the working tree is the commit being shipped |")
    fi

    # 1. The repository's verification commands.
    local cmds n=0 c rc
    cmds="$(jq -r '.verify // [] | .[]' "$(state_dir "$repo")/config.json" 2>/dev/null || true)"
    if [ -z "$cmds" ]; then
        failures+=("no verify commands configured — set \"verify\": [...] in .aisdlc/config.json")
        rows+=("| commands | **FAIL** | none configured |")
    else
        while IFS= read -r c; do
            [ -n "$c" ] || continue
            n=$((n + 1)); rc=0
            printf '[%s] $ %s\n' "$(ts)" "$c" >> "$log"
            ( cd "$wt" && AISDLC_HEADLESS=1 bash -c "$c" < /dev/null ) >> "$log" 2>&1 || rc=$?
            if [ "$rc" -eq 0 ]; then
                rows+=("| \`$c\` | PASS | exit 0 |")
            else
                rows+=("| \`$c\` | **FAIL** | exit $rc — see verify.log |")
                failures+=("\`$c\` exited $rc")
            fi
        done <<< "$cmds"
    fi

    # Files this branch touched, excluding the harness's own bookkeeping (via _branch_changes).
    local changed deleted tests=""
    changed="$(_branch_changes "$wt" "$base" "$specs_dir/$ticket" --diff-filter=AMR)"
    local f
    while IFS= read -r f; do
        [ -n "$f" ] && _is_test_path "$f" && tests="${tests:+$tests$'\n'}$f"
    done <<< "$changed"

    # 2. Every UC in the acceptance table has a test that names it.
    local ucs uc missing=""
    ucs="$(grep -E '^\|[[:space:]]*UC-[0-9]+' "$spec_file" 2>/dev/null | grep -oE 'UC-[0-9]+' | sort -u || true)"
    if [ -z "$ucs" ]; then
        if [ -z "$tests" ]; then
            rows+=("| tests | **FAIL** | the spec has no UC table and the branch changed no test |")
            failures+=("no test added or changed")
        else
            rows+=("| UC coverage | n/a | the spec has no UC table; $(printf '%s\n' "$tests" | wc -l | tr -d ' ') test file(s) changed |")
        fi
    else
        # The id as dense-testing writes it in each stack: `UC-3:` in a test title, `_UC1_` in a Go
        # test function, `test_uc2_` in pytest. Case-insensitive, separator optional, not a prefix
        # of a longer number.
        for uc in $ucs; do
            if [ -z "$tests" ] || ! (cd "$wt" && printf '%s\n' "$tests" \
                    | xargs grep -liqE "(^|[^a-z])uc[-_]?${uc#UC-}([^0-9]|\$)" 2>/dev/null); then
                missing="${missing:+$missing, }$uc"
            fi
        done
        if [ -n "$missing" ]; then
            rows+=("| UC coverage | **FAIL** | no changed test names $missing |")
            failures+=("untested: $missing")
        else
            rows+=("| UC coverage | PASS | $(printf '%s' "$ucs" | wc -w | tr -d ' ') UC(s), each named by a changed test |")
        fi
    fi

    # 3. Nothing weakened: no deleted test file, no newly skipped or focused test.
    deleted="$(git -C "$wt" diff --name-only --diff-filter=D "${base}...HEAD" 2>/dev/null || true)"
    local removed="" retired="" patterns="" pat fork
    fork="$(git -C "$wt" merge-base "$base" HEAD 2>/dev/null || true)"
    [ -z "$fork" ] || patterns="$(_retired_patterns "$wt" "$fork")"
    while IFS= read -r f; do
        if [ -z "$f" ] || ! _is_test_path "$f"; then continue; fi
        while IFS= read -r pat; do
            [ -n "$pat" ] || continue
            # shellcheck disable=SC2254 # unquoted on purpose: the ledger entry is a glob
            case "$f" in $pat) retired="${retired:+$retired, }$f"; continue 2 ;; esac
        done <<< "$patterns"
        removed="${removed:+$removed, }$f"
    done <<< "$deleted"
    local switched=""
    if [ -n "$tests" ]; then
        switched="$(cd "$wt" && printf '%s\n' "$tests" | xargs git diff "${base}...HEAD" -U0 -- 2>/dev/null \
            | grep -E '^\+[^+]' \
            | grep -E '\b(it|test|describe)\.(skip|only|todo)\(|\b(xit|xdescribe|fit|fdescribe)\(|t\.Skip(Now)?\(|@(Disabled|Ignore)\b|pytest\.mark\.skip|@unittest\.skip' \
            | head -5 || true)"
    fi
    if [ -n "$removed" ] || [ -n "$switched" ]; then
        rows+=("| tests not weakened | **FAIL** | ${removed:+deleted: $removed }${switched:+switched off: $(printf '%s' "$switched" | tr '\n' ' ' | cut -c1-160)} |")
        failures+=("a test was deleted or switched off")
    else
        rows+=("| tests not weakened | PASS | no test deleted, skipped or focused${retired:+; retired via .claude/retired-tests: $retired} |")
    fi

    local verdict="PASS"
    [ "${#failures[@]}" -eq 0 ] || verdict="FAIL"
    mkdir -p "$wt/$specs_dir/$ticket"
    {
        printf '%s\n\n# Verify — %s\n\n' "$verdict" "$ticket"
        printf 'Base: `%s`  \nHead: `%s`  \nChecked: %s\n\n' "$base" "$(git -C "$wt" rev-parse --short HEAD)" "$(ts)"
        printf '| check | result | detail |\n|---|---|---|\n'
        printf '%s\n' "${rows[@]}"
    } > "$report_wt"
    git -C "$wt" add "$specs_dir/$ticket/verify-report.md" >> "$log" 2>&1
    git -C "$wt" -c user.name=aisdlc -c user.email=aisdlc@localhost \
        commit -q -m "docs(verify): verify report for $ticket [$verdict]" >> "$log" 2>&1
    cp "$report_wt" "$dir/verify-report.md"
    local joined=""
    [ "${#failures[@]}" -eq 0 ] || joined="$(printf '%s; ' "${failures[@]}")"
    task_set "$repo" "$id" --arg v "$verdict" --arg f "${joined%; }" '.verify_verdict = $v | .verify_failures = $f'
    printf '[%s] verify: %s%s\n' "$(ts)" "$verdict" "${joined:+ — ${joined%; }}" >> "$log"
    [ "$verdict" = "PASS" ]
}

# --------------------------------------------------------------------------- #
# archive — write task artefacts to a local, redacted store on terminal status
# --------------------------------------------------------------------------- #

# Merge two JSON {rule:count} objects by adding values for matching keys.
_arc_merge() {
    jq -n --argjson a "${1:-{\}}" --argjson b "${2:-{\}}" \
        '[$a,$b] | map(to_entries[]) | group_by(.key) |
         map({key:.[0].key,value:([.[].value]|add)}) | from_entries'
}

# Copy src to dst with built-in secrets redacted; print JSON {rule:count} to stdout.
# Optional 3rd arg: path to run.log for betterleaks scanner diagnostics.
_arc_redact() (
    local src="$1" dst="$2" logfile="${3:-}" scratch t n counts='{}'
    umask 077
    scratch="$(mktemp -d "${dst}.redact.XXXXXX")" || return 1
    trap 'rm -rf -- "$scratch"' EXIT
    t="$scratch/content"
    cp "$src" "$t" 2>/dev/null || return 1
    # --- betterleaks v2 scanner: PATH first, then slop-guard managed resolver ---
    local bl_cmd=""
    # 1. PATH: check directly; verify major version is 2 before using.
    if command -v betterleaks >/dev/null 2>&1; then
        local _bl_path_bin; _bl_path_bin="$(command -v betterleaks)"
        local _bl_path_ver
        _bl_path_ver="$("$_bl_path_bin" --version 2>/dev/null | grep -oE '[0-9]+' | head -1)"
        [ "${_bl_path_ver:-0}" -ge 2 ] && bl_cmd="$_bl_path_bin"
    fi
    # 2. Managed: source slop-guard's resolver (CLAUDE_PLUGIN_DATA/GROK_PLUGIN_DATA normalization).
    if [ -z "$bl_cmd" ]; then
        local _sg_lib="${PLUGIN_ROOT}/../slop-guard/lib/tools.sh"
        if [ -f "$_sg_lib" ]; then
            local _sg_managed
            _sg_managed="$(
                local _sgpdata="${CLAUDE_PLUGIN_DATA:-}"
                [ -z "$_sgpdata" ] && _sgpdata="${GROK_PLUGIN_DATA:-}"
                [ -z "$_sgpdata" ] && \
                    _sgpdata="${XDG_DATA_HOME:-$HOME/.local/share}/claude/plugins/slop-guard"
                CLAUDE_PLUGIN_ROOT="$(cd "${_sg_lib%/lib/tools.sh}" && pwd 2>/dev/null || true)"
                export CLAUDE_PLUGIN_ROOT
                export CLAUDE_PLUGIN_DATA="$_sgpdata"
                # shellcheck source=/dev/null
                . "$_sg_lib" 2>/dev/null && resolve_tool betterleaks 2>/dev/null || true
            )" || true
            if [ -n "$_sg_managed" ] && [ -x "$_sg_managed" ]; then
                local _sg_ver
                _sg_ver="$("$_sg_managed" --version 2>/dev/null | grep -oE '[0-9]+' | head -1)"
                [ "${_sg_ver:-0}" -ge 2 ] && bl_cmd="$_sg_managed"
            fi
        fi
    fi
    if [ -n "$bl_cmd" ]; then
        local bl_out bl_rc bl_scan_ok=0 bl_abort=0
        bl_out="$scratch/bl.jsonl"
        # --analyze=false --validate=false override BETTERLEAKS_VALIDATE/BETTERLEAKS_ANALYZE env vars.
        BETTERLEAKS_VALIDATE=false BETTERLEAKS_ANALYZE=false \
            "$bl_cmd" "$t" --jsonl --analyze=false --validate=false > "$bl_out" 2>/dev/null
        bl_rc=$?
        if [ "$bl_rc" -gt 1 ]; then
            printf '[%s] archive scanner error: betterleaks rc=%s on %s\n' \
                "$(ts)" "$bl_rc" "$(basename "$dst")" >> "${logfile:-/dev/null}" 2>/dev/null || true
            return 1
        fi
        # Parse JSONL for both rc=0 (completeness/compatibility gate) and rc=1 (findings + gate).
        # schema_version:"1" is required on every envelope; incompatible output aborts.
        local _bl_line _bl_rid _bl_val _bl_n
        while IFS= read -r _bl_line; do
            [ -n "$_bl_line" ] || continue
            # Scan metadata envelope: {schema_version:"1",scan:{state:…}}
            if printf '%s' "$_bl_line" | \
                jq -e '(.schema_version == "1") and has("scan")' >/dev/null 2>&1; then
                bl_scan_ok=1
                local _bl_state
                _bl_state="$(printf '%s' "$_bl_line" | jq -r '.scan.state // empty' 2>/dev/null)"
                if [ "${_bl_state:-}" != "complete" ]; then
                    printf '[%s] archive scanner incomplete: state=%s\n' \
                        "$(ts)" "${_bl_state:-unknown}" >> "${logfile:-/dev/null}" 2>/dev/null || true
                    bl_abort=1
                fi
                continue
            fi
            # Finding envelopes processed only for rc=1.
            [ "$bl_rc" -eq 1 ] || continue
            printf '%s' "$_bl_line" | \
                jq -e '(.schema_version == "1") and has("finding")' >/dev/null 2>&1 || continue
            # Decoded findings (non-empty encodings array or decode_depth>0): abort archive.
            # Empty [] encodings array is NOT a decoded finding.
            if printf '%s' "$_bl_line" | jq -e '
                ((.finding.encodings // [] | length) > 0) or
                ((.finding.decode_depth // 0) > 0)
            ' >/dev/null 2>&1; then
                _bl_rid="$(printf '%s' "$_bl_line" | \
                    jq -r '.finding.rule_id // "unknown"' 2>/dev/null)"
                printf '[%s] archive scanner gap: decoded finding (rule: %s)\n' \
                    "$(ts)" "$_bl_rid" >> "${logfile:-/dev/null}" 2>/dev/null || true
                bl_abort=1; continue
            fi
            # Replace literal match.value using jq --rawfile (handles multiline; fail-closed).
            _bl_rid="$(printf '%s' "$_bl_line" | jq -r '.finding.rule_id // empty' 2>/dev/null)"
            _bl_val="$(printf '%s' "$_bl_line" | jq -r '.finding.match.value // empty' 2>/dev/null)"
            if [ -n "$_bl_val" ] && [ -n "$_bl_rid" ]; then
                printf '%s' "$_bl_val" > "$scratch/bl_val"
                # Count occurrences via split (handles embedded newlines; NUL-free path).
                _bl_n="$(jq -Rs --rawfile from "$scratch/bl_val" \
                    'if ($from | length) == 0 then 0 else (split($from) | length - 1) end' \
                    "$t" 2>/dev/null)" || return 1
                if [ "${_bl_n:-0}" -gt 0 ]; then
                    local _bl_key="betterleaks:${_bl_rid}" _bl_to
                    _bl_to="[REDACTED:betterleaks:${_bl_rid}]"
                    # Literal substitution: split on value, join with redaction marker.
                    jq -Rs --rawfile from "$scratch/bl_val" --arg to "$_bl_to" \
                        'split($from) | join($to)' "$t" > "$scratch/bl_next" \
                        && mv "$scratch/bl_next" "$t" || return 1
                    counts="$(jq -n --argjson c "$counts" --argjson n "$_bl_n" \
                        --arg k "$_bl_key" \
                        '$c + {($k): (($c[$k] // 0) + $n)}' 2>/dev/null)" || return 1
                fi
            fi
        done < "$bl_out"
        # Completeness gate: no valid scan metadata record = incompatible or truncated output.
        if [ "$bl_scan_ok" -eq 0 ]; then
            printf '[%s] archive scanner incomplete: no scan metadata record\n' \
                "$(ts)" >> "${logfile:-/dev/null}" 2>/dev/null || true
            return 1
        fi
        [ "$bl_abort" -eq 1 ] && return 1
    fi
    # --- end betterleaks ---
    # grep -oE with a real exit check: a read error aborts, only "no match" (rc 1) continues.
    _arc_count() {
        grep -oE "$1" "$2" > "$scratch/grep.matches" || [ "$?" -le 1 ] || return 1
        wc -l < "$scratch/grep.matches" | tr -d ' '
    }
    # A grep exit of 1 means no match; read/transform errors must not publish a file.
    n="$(_arc_count 'sk-ant-[A-Za-z0-9_-]{20,}' "$t")" || return 1
    if [ "${n:-0}" -gt 0 ]; then
        sed -i -E 's/sk-ant-[A-Za-z0-9_-]{20,}/[REDACTED:anthropic-key]/g' "$t" || return 1
        counts="$(jq -n --argjson c "$counts" --argjson n "$n" '$c+{"anthropic-key":$n}')" || return 1
    fi
    n="$(_arc_count 'sk-[A-Za-z0-9_-]{20,}' "$t")" || return 1
    if [ "${n:-0}" -gt 0 ]; then
        sed -i -E 's/sk-[A-Za-z0-9_-]{20,}/[REDACTED:openai-key]/g' "$t" || return 1
        counts="$(jq -n --argjson c "$counts" --argjson n "$n" '$c+{"openai-key":$n}')" || return 1
    fi
    n="$(_arc_count '(ghp_|gho_|ghs_|github_pat_)[A-Za-z0-9_]{10,}' "$t")" || return 1
    if [ "${n:-0}" -gt 0 ]; then
        sed -i -E 's/(ghp_|gho_|ghs_|github_pat_)[A-Za-z0-9_]{10,}/[REDACTED:github-token]/g' "$t" || return 1
        counts="$(jq -n --argjson c "$counts" --argjson n "$n" '$c+{"github-token":$n}')" || return 1
    fi
    n="$(_arc_count 'AKIA[A-Z0-9]{16}' "$t")" || return 1
    if [ "${n:-0}" -gt 0 ]; then
        sed -i -E 's/AKIA[A-Z0-9]{16}/[REDACTED:aws-key-id]/g' "$t" || return 1
        counts="$(jq -n --argjson c "$counts" --argjson n "$n" '$c+{"aws-key-id":$n}')" || return 1
    fi
    n="$(_arc_count 'Bearer [A-Za-z0-9._~+/=-]{8,}' "$t")" || return 1
    if [ "${n:-0}" -gt 0 ]; then
        sed -i -E 's/Bearer [A-Za-z0-9._~+\/=-]{8,}/[REDACTED:bearer-token]/g' "$t" || return 1
        counts="$(jq -n --argjson c "$counts" --argjson n "$n" '$c+{"bearer-token":$n}')" || return 1
    fi
    n="$(grep -cE -- '-----BEGIN ([A-Z]+ )*PRIVATE KEY-----' "$t")" || [ "$?" -eq 1 ] || return 1
    if [ "${n:-0}" -gt 0 ]; then
        awk '/-----BEGIN ([A-Z]+ )*PRIVATE KEY-----/{p=1;print "[REDACTED:pem-private-key]";next}
             p && /-----END ([A-Z]+ )*PRIVATE KEY-----/{p=0;next}
             p{next}{print}' "$t" > "$scratch/next" || return 1
        mv "$scratch/next" "$t" || return 1
        counts="$(jq -n --argjson c "$counts" --argjson n "$n" '$c+{"pem-private-key":$n}')" || return 1
    fi
    n="$(grep -cE '^([A-Za-z_][A-Za-z0-9_]*)?(TOKEN|SECRET|PASSWORD|API_KEY|PRIVATE)[A-Za-z0-9_]*[[:space:]]*=.' \
             "$t")" || [ "$?" -eq 1 ] || return 1
    if [ "${n:-0}" -gt 0 ]; then
        sed -i -E \
            's/^(([A-Za-z_][A-Za-z0-9_]*)?(TOKEN|SECRET|PASSWORD|API_KEY|PRIVATE)[A-Za-z0-9_]*[[:space:]]*=).*/\1[REDACTED:env-secret]/' \
            "$t" || return 1
        counts="$(jq -n --argjson c "$counts" --argjson n "$n" '$c+{"env-secret":$n}')" || return 1
    fi
    mv "$t" "$dst" || return 1
    printf '%s' "$counts"
)

# Archive a task when it reaches a terminal status (done/failed/refused/cancelled).
# Must be called BEFORE any worktree removal so BLOCKED.md is still readable.
# Non-fatal: on any write failure, logs "archive failed: <reason>" and returns 0.
archive_task() (
    local repo="$1" id="$2"
    [ "${AISDLC_ARCHIVE:-}" = "off" ] && return 0
    # Profile Archive: off — checked second (AISDLC_ARCHIVE=off above is always first).
    local _arc_profile_val=""
    if [ -f "$repo/.claude/sdlc.md" ]; then
        _arc_profile_val="$(grep -oE '\*\*Archive:\*\*[[:space:]]+[^[:space:]]+' \
            "$repo/.claude/sdlc.md" 2>/dev/null | \
            sed 's/.*\*\*Archive:\*\*[[:space:]]*//; s/^`\(.*\)`$/\1/' | head -1)"
    fi
    [ "${_arc_profile_val:-on}" = "off" ] && return 0

    # archive_transcripts: config key > env > default (on).
    local _arc_tr_setting
    _arc_tr_setting="$(resolve_default "$repo" archive_transcripts "" "${AISDLC_ARCHIVE_TRANSCRIPTS:-}" "on")"

    umask 077
    local root="${AISDLC_ARCHIVE:-${XDG_DATA_HOME:-$HOME/.local/share}/aisdlc/archive}"

    # repo slug: <basename>-<first 8 hex of sha256 of absolute path>
    local abs_path sha8 repo_slug
    abs_path="$(cd "$repo" && pwd)"
    sha8="$(printf '%s' "$abs_path" | sha256sum | cut -c1-8)"
    repo_slug="$(basename "$abs_path")-${sha8}"

    local dir tf log
    dir="$(task_dir "$repo" "$id")"
    tf="$(task_file "$repo" "$id")"
    log="$dir/run.log"

    local ticket specs_dir wt status attempts
    ticket="$(jq -r '.ticket // empty' "$tf" 2>/dev/null)"
    specs_dir="$(jq -r '.specs_dir // empty' "$tf" 2>/dev/null)"
    [ -n "$specs_dir" ] || specs_dir="$BUILTIN_SPECS_DIR"
    wt="$(jq -r '.worktree // empty' "$tf" 2>/dev/null)"
    status="$(jq -r '.status // empty' "$tf" 2>/dev/null)"
    attempts="$(jq -r '.attempts // 1' "$tf" 2>/dev/null)"

    # Archive dir: <root>/<slug>/<YYYY-MM>/<id>/ or <id>.<attempts>/ for retries.
    local ym arc_name arc_dir
    ym="$(date -u +%Y-%m)"
    arc_name="$id"
    if [ "${attempts:-1}" -gt 1 ] || [ -e "${root}/${repo_slug}/${ym}/${id}" ]; then
        arc_name="${id}.${attempts}"
    fi
    arc_dir="${root}/${repo_slug}/${ym}/${arc_name}"

    if ! mkdir -p "${root}/${repo_slug}/${ym}" 2>/dev/null || ! mkdir "$arc_dir" 2>/dev/null; then
        printf '[%s] archive failed: could not create %s\n' "$(ts)" "$arc_dir" >> "$log" 2>/dev/null || true
        return 0
    fi
    local _arc_complete=0 _arc_failed=0
    trap 'if [ "$_arc_complete" -eq 0 ]; then
        rm -rf -- "$arc_dir"
        printf "[%s] archive failed: copy, redaction or publication failed\n" "$(ts)" >> "$log" 2>/dev/null || true
    fi' EXIT
    mkdir "$arc_dir/phases" "$arc_dir/spec" || return 0

    # Inner helper: copy one file with redaction; updates all_counts and files_json via dynamic scope.
    _arc_file() {
        local _as="$1" _ar="$2" _ac _ah _adst
        [ -f "$_as" ] || return 0
        _adst="${arc_dir}/${_ar}"
        [ "$_arc_failed" -eq 0 ] || return 1
        if ! mkdir -p "$(dirname "$_adst")" 2>/dev/null \
            || ! _ac="$(_arc_redact "$_as" "$_adst" "$log")" \
            || ! all_counts="$(_arc_merge "$all_counts" "$_ac")" \
            || ! _ah="$(sha256sum "$_adst" | cut -c1-64)" \
            || ! files_json="$(printf '%s' "$files_json" | jq --arg p "$_ar" --arg h "$_ah" '. + {($p): $h}')"; then
            _arc_failed=1
            return 1
        fi
    }

    local all_counts='{}' files_json='{}'

    # task.json
    _arc_file "$tf" "task.json"

    # Phase logs and json files from task dir (all *.log and *.json except task/manifest)
    local _f _bn
    for _f in "$dir"/*.log "$dir"/*.json; do
        [ -f "$_f" ] || continue
        _bn="$(basename "$_f")"
        case "$_bn" in task.json|manifest.json) continue ;; esac
        _arc_file "$_f" "phases/$_bn"
    done

    # spec.md: worktree copy first (may have agent edits), then repo fallback
    local _ss=""
    [ -n "$wt" ] && [ -f "$wt/$specs_dir/$ticket/spec.md" ] && _ss="$wt/$specs_dir/$ticket/spec.md"
    [ -z "$_ss" ] && [ -f "$repo/$specs_dir/$ticket/spec.md" ] && _ss="$repo/$specs_dir/$ticket/spec.md"
    [ -n "$_ss" ] && _arc_file "$_ss" "spec/spec.md"

    # Report files: task dir first (already copied there on success/scope/verify), then worktree
    local _n _src
    for _n in qa-report.md scope-report.md verify-report.md pr-body.md; do
        _src=""
        [ -f "$dir/$_n" ] && _src="$dir/$_n"
        [ -z "$_src" ] && [ -n "$wt" ] && [ -f "$wt/$specs_dir/$ticket/$_n" ] && _src="$wt/$specs_dir/$ticket/$_n"
        [ -n "$_src" ] && _arc_file "$_src" "spec/$_n"
    done

    # BLOCKED.md: worktree only — not copied to task dir, must be read before worktree removal
    [ -n "$wt" ] && [ -f "$wt/$specs_dir/$ticket/BLOCKED.md" ] \
        && _arc_file "$wt/$specs_dir/$ticket/BLOCKED.md" "spec/BLOCKED.md"

    # --- Transcript copies (GH-43-c) ---
    local arc_transcripts
    if [ "$_arc_tr_setting" = "off" ]; then
        arc_transcripts='"disabled"'
    else
        arc_transcripts='[]'
        local _tr_rt _tr_phase _tr_sid _tr_src _tr_dst_rel _tr_copied _tr_reason _tr_rec
        local _tr_adst _tr_ac _tr_ah
        _tr_rt="$(jq -r '.runtime // "claude"' "$tf" 2>/dev/null)"

        if [ "$_tr_rt" = "claude" ]; then
            while IFS= read -r _tr_json; do
                [ -n "$_tr_json" ] || continue
                _tr_phase="$(printf '%s' "$_tr_json" | jq -r '.phase // empty' 2>/dev/null)"
                _tr_sid="$(printf '%s' "$_tr_json" | jq -r '.session_id // empty' 2>/dev/null)"
                _tr_src="$(printf '%s' "$_tr_json" | jq -r '.transcript // empty' 2>/dev/null)"
                [ -n "$_tr_src" ] || continue
                _tr_dst_rel="sessions/${_tr_phase}-${_tr_sid}.jsonl"
                _tr_copied="false"; _tr_reason=""
                # B4: reject path-traversal in phase/session_id components; fail-closed.
                if printf '%s' "${_tr_phase}${_tr_sid}" | grep -qE '[/\\]'; then
                    _arc_failed=1; break
                fi
                if [ ! -f "$_tr_src" ]; then
                    _tr_reason="not found"
                elif [ ! -r "$_tr_src" ]; then
                    _tr_reason="unreadable"
                else
                    _tr_adst="${arc_dir}/${_tr_dst_rel}"
                    local _tr_real; _tr_real="$(realpath -m "$_tr_adst" 2>/dev/null)"
                    local _arc_real; _arc_real="$(realpath -m "$arc_dir" 2>/dev/null)"
                    if [ -z "$_tr_real" ] || [ -z "$_arc_real" ] || \
                       [ "${_tr_real#${_arc_real}/}" = "$_tr_real" ]; then
                        _arc_failed=1; break
                    fi
                    if mkdir -p "$(dirname "$_tr_adst")" 2>/dev/null \
                        && _tr_ac="$(_arc_redact "$_tr_src" "$_tr_adst" "$log")" \
                        && all_counts="$(_arc_merge "$all_counts" "$_tr_ac")" \
                        && _tr_ah="$(sha256sum "$_tr_adst" | cut -c1-64)" \
                        && files_json="$(printf '%s' "$files_json" | \
                            jq --arg p "$_tr_dst_rel" --arg h "$_tr_ah" '. + {($p): $h}')"; then
                        _tr_copied="true"
                    else
                        _arc_failed=1
                    fi
                fi
                _tr_rec="$(jq -cn \
                    --arg ph "$_tr_phase" --arg sid "$_tr_sid" --arg src "$_tr_src" \
                    --arg dst "$_tr_dst_rel" --argjson c "$_tr_copied" --arg r "$_tr_reason" \
                    '{phase:$ph,session_id:(if $sid=="" then null else $sid end),src:$src,dst_rel:$dst,copied:$c,reason:$r}')"
                arc_transcripts="$(printf '%s' "$arc_transcripts" | \
                    jq --argjson e "$_tr_rec" '. + [$e]' 2>/dev/null)" || true
                [ "$_arc_failed" -eq 0 ] || break
            done < <(jq -c '.sessions[]? | select(.runtime == "claude" or .runtime == null)' "$tf" 2>/dev/null)
        elif [ "$_tr_rt" = "omp" ]; then
            local _sf _obn
            for _sf in "$dir/sessions"/*.jsonl; do
                [ -f "$_sf" ] || continue
                _obn="$(basename "$_sf")"
                _tr_sid="$(printf '%s' "$_obn" | sed 's/^[^_]*_//; s/\.jsonl$//')"
                _tr_dst_rel="sessions/omp-${_obn}"
                _tr_copied="false"; _tr_reason=""
                # B4: containment check for omp entries too.
                _tr_adst="${arc_dir}/${_tr_dst_rel}"
                local _tr_oreal; _tr_oreal="$(realpath -m "$_tr_adst" 2>/dev/null)"
                local _arc_oreal; _arc_oreal="$(realpath -m "$arc_dir" 2>/dev/null)"
                if [ -z "$_tr_oreal" ] || [ -z "$_arc_oreal" ] || \
                   [ "${_tr_oreal#${_arc_oreal}/}" = "$_tr_oreal" ]; then
                    _arc_failed=1; break
                fi
                if [ ! -r "$_sf" ]; then
                    _tr_reason="unreadable"
                else
                    if mkdir -p "$(dirname "$_tr_adst")" 2>/dev/null \
                        && _tr_ac="$(_arc_redact "$_sf" "$_tr_adst" "$log")" \
                        && all_counts="$(_arc_merge "$all_counts" "$_tr_ac")" \
                        && _tr_ah="$(sha256sum "$_tr_adst" | cut -c1-64)" \
                        && files_json="$(printf '%s' "$files_json" | \
                            jq --arg p "$_tr_dst_rel" --arg h "$_tr_ah" '. + {($p): $h}')"; then
                        _tr_copied="true"
                    else
                        _arc_failed=1
                    fi
                fi
                _tr_rec="$(jq -cn \
                    --arg sid "$_tr_sid" --arg src "$_sf" \
                    --arg dst "$_tr_dst_rel" --argjson c "$_tr_copied" --arg r "$_tr_reason" \
                    '{phase:null,session_id:(if $sid=="" then null else $sid end),src:$src,dst_rel:$dst,copied:$c,reason:$r}')"
                arc_transcripts="$(printf '%s' "$arc_transcripts" | \
                    jq --argjson e "$_tr_rec" '. + [$e]' 2>/dev/null)" || true
                [ "$_arc_failed" -eq 0 ] || break
            done
        fi
    fi
    # B1: Redact transcript metadata before embedding in manifest (src paths may carry secrets).
    if [ "$arc_transcripts" != '"disabled"' ] && [ "$_arc_failed" -eq 0 ]; then
        local _tr_meta_raw="$arc_dir/.transcripts.raw"
        local _tr_meta_clean="$arc_dir/.transcripts.clean"
        printf '%s\n' "$arc_transcripts" > "$_tr_meta_raw"
        local _tr_meta_mc
        if _tr_meta_mc="$(_arc_redact "$_tr_meta_raw" "$_tr_meta_clean" "$log")"; then
            arc_transcripts="$(cat "$_tr_meta_clean")"
            all_counts="$(_arc_merge "$all_counts" "$_tr_meta_mc")" || _arc_failed=1
        else
            _arc_failed=1
        fi
        rm -f "$_tr_meta_raw" "$_tr_meta_clean"
    fi
    [ "$_arc_failed" -eq 0 ] || return 0

    # manifest.json
    local _archived_at _pf
    _archived_at="$(ts)"
    _pf="$(policy_fingerprint "$repo")"
    if ! jq -n \
        --arg at "$_archived_at" --arg pf "$_pf" --arg ver "$VERSION" \
        --argjson redactions "$all_counts" --argjson files "$files_json" \
        --argjson tc "$arc_transcripts" \
        --slurpfile tf "$arc_dir/task.json" \
        '($tf[0]) | {id,ticket,repo,base,branch,pr_url,status,attempts,cost_usd,runtime,
          runtime_version,model:(.model//null),models:(.models//null),sessions:(.sessions//[]),
          phases:(.phase_log//null),
          aisdlc_version:$ver,policy_fingerprint:$pf,archived_at:$at,
          redactions:$redactions,files:$files,transcripts:$tc}' \
        > "$arc_dir/manifest.json" 2>/dev/null; then
        printf '[%s] archive failed: manifest write failed\n' "$(ts)" >> "$log" 2>/dev/null || true
        return 0
    fi

    # Append to index.jsonl (flock-ed for parallel safety).
    local _idx="${root}/index.jsonl" _entry _index_counts
    jq -cn --slurpfile m "$arc_dir/manifest.json" --arg rs "$repo_slug" --arg path "$arc_dir" \
        '$m[0] | {id,ticket,repo,status,cost_usd,archived_at} + {repo_slug:$rs,path:$path}' \
        > "$arc_dir/.index.raw" || return 0
    _index_counts="$(_arc_redact "$arc_dir/.index.raw" "$arc_dir/.index.entry" "$log")" || return 0
    all_counts="$(_arc_merge "$all_counts" "$_index_counts")" || return 0
    jq --argjson c "$all_counts" '.redactions = $c' "$arc_dir/manifest.json" > "$arc_dir/.manifest" || return 0
    mv "$arc_dir/.manifest" "$arc_dir/manifest.json" || return 0
    _entry="$(cat "$arc_dir/.index.entry")" || return 0
    rm "$arc_dir/.index.raw" "$arc_dir/.index.entry" || return 0
    flock "${root}/index.lock" bash -c 'printf "%s\n" "$1" >> "$2"' _ "$_entry" "$_idx" \
        2>/dev/null || return 0
    _arc_complete=1

    printf '[%s] archived to %s\n' "$(ts)" "$arc_dir" >> "$log" 2>/dev/null || true
    return 0
)


execute_task() {
    local repo="$1" id="$2"
    local ticket base wt branch dir specs_dir is_issue
    dir="$(task_dir "$repo" "$id")"
    ticket="$(task_get "$repo" .ticket "$id")"
    base="$(task_get "$repo" .base "$id")"
    specs_dir="$(task_get "$repo" .specs_dir "$id")"
    is_issue="$(task_get "$repo" .is_issue "$id")"
    [ -n "$specs_dir" ] || specs_dir="$BUILTIN_SPECS_DIR"
    branch="ai/${ticket}-${id##*-}"
    wt="$(dirname "$repo")/.aisdlc-worktrees/$(basename "$repo")-${id}"

    # Issue lifecycle helpers: set once and reused across failure paths.
    local issue_n="" issue_kind=""
    if [ "$is_issue" = "true" ]; then
        issue_n="${ticket#GH-}"
        issue_kind="$(tracker_kind "$repo")"
    fi

    local log="$dir/run.log"
    task_set "$repo" "$id" --arg b "$branch" --arg w "$wt" --arg t "$(ts)" \
        '.branch = $b | .worktree = $w | .started = $t | .attempts = ((.attempts // 0) + 1)'
    set_status "$repo" "$id" running

    printf '[%s] task %s (%s) base=%s branch=%s\n' "$(ts)" "$id" "$ticket" "$base" "$branch" >> "$log"

    if ! git -C "$repo" worktree add -b "$branch" "$wt" "$base" >> "$log" 2>&1; then
        task_set "$repo" "$id" --arg e "worktree creation failed — see run.log" '.error = $e'
        set_status "$repo" "$id" failed
        archive_task "$repo" "$id"
        say "  ✗ $id — could not create worktree"
        if [ -n "$issue_n" ]; then
            tracker_release "$repo" "$issue_n" "$issue_kind" "aisdlc" "aborted: worktree creation failed"
        fi
        return 1
    fi

    # GH-60: for local-tracker repos, symlink the canonical tracker directory into the
    # worktree so that ship's create-pr writes to $repo/.aisdlc/tracker/, not to
    # $wt/.aisdlc/tracker/ (which is deleted with the worktree on clean/retry).
    if [ "$(tracker_kind "$repo")" = "local" ]; then
        if ! { mkdir -p "$repo/.aisdlc/tracker" "$wt/.aisdlc" && ln -sfn "$repo/.aisdlc/tracker" "$wt/.aisdlc/tracker"; }; then
            local _ln_err="local tracker symlink failed: $wt/.aisdlc/tracker → $repo/.aisdlc/tracker"
            printf '[%s] %s\n' "$(ts)" "$_ln_err" >> "$log"
            task_set "$repo" "$id" --arg e "$_ln_err" '.error = $e'
            set_status "$repo" "$id" failed
            archive_task "$repo" "$id"
            say "  ✗ $id — $_ln_err"
            if [ -n "$issue_n" ]; then
                tracker_release "$repo" "$issue_n" "$issue_kind" "aisdlc" "aborted: local tracker symlink failed"
            fi
            return 1
        fi
        printf '[%s] linked %s → %s\n' "$(ts)" "$wt/.aisdlc/tracker" "$repo/.aisdlc/tracker" >> "$log"
    fi


    # For --issue tasks triage writes the spec, so skip seed_spec and the initial gate.
    if [ "$is_issue" != "true" ]; then
        if ! seed_spec "$repo" "$wt" "$ticket" "$log" "$specs_dir"; then
            task_set "$repo" "$id" --arg e "no spec for $ticket in the worktree or the repo" '.error = $e'
            set_status "$repo" "$id" failed
            archive_task "$repo" "$id"
            say "  ✗ $id — spec missing"
            return 1
        fi

        # Re-gate inside the worktree: the committed spec is what the agent will actually read.
        local reason
        if ! reason="$(check_spec "$wt/$specs_dir/$ticket/spec.md" "$repo")"; then
            printf '[%s] refused before invoking the model: %s\n' "$(ts)" "$reason" >> "$log"
            task_set "$repo" "$id" --arg e "$reason" '.error = $e'
            set_status "$repo" "$id" refused
            say "  ⊘ $id — $reason"
            archive_task "$repo" "$id"
            git -C "$repo" worktree remove --force "$wt" >> "$log" 2>&1
            return 1
        fi
    fi

    # Read the phase list up front rather than streaming it into the loop: whatever runs
    # inside must not be able to consume the list it is iterating over.
    local phase failed="" phase_list
    local ship_pr_num="" ship_pr="" ship_pr_paren="" ship_result="" pr_claimed=0 review_ran=0
    phase_list="$(jq -r '.phases[]' "$(task_file "$repo" "$id")")"
    while read -r phase; do
        [ -n "$phase" ] || continue

        # For --issue tasks: gate on spec after root-cause, before implement.
        # (triage wrote the spec; now verify it before spending tokens on implement.)
        if [ "$is_issue" = "true" ] && [ "$phase" = "implement" ]; then
            local reason
            if ! reason="$(check_spec "$wt/$specs_dir/$ticket/spec.md" "$repo")"; then
                printf '[%s] refused after root-cause: %s\n' "$(ts)" "$reason" >> "$log"
                task_set "$repo" "$id" --arg e "$reason" '.error = $e'
                set_status "$repo" "$id" refused
                say "  ⊘ $id — $reason"
                archive_task "$repo" "$id"
                git -C "$repo" worktree remove --force "$wt" >> "$log" 2>&1
                if [ -n "$issue_n" ]; then
                    tracker_release "$repo" "$issue_n" "$issue_kind" "aisdlc" "aborted: $reason"
                fi
                return 1
            fi
        fi

        say "  → $id: $phase"

        # GH-43-f: capture phase_log timing and session provenance.
        local _ph_started _ph_ended _ph_verdict _ph_sid _ph_sc_before
        _ph_started="$(ts)"
        _ph_sid=""

        # Inner helper: append phase_log entry. Non-fatal by design.
        _ph_log() {
            task_set "$repo" "$id" \
                --arg ph "$1" --arg v "$2" --arg sid "$3" \
                --arg s "$4" --arg e "$5" \
                '.phase_log += [{name:$ph,verdict:$v,
                  session_id:(if $sid=="" then null else $sid end),
                  started:$s,ended:$e}]' 2>/dev/null || true
        }
        # Inner helper: detect session_id by comparing sessions count before/after.
        _ph_sid_detect() {
            local _before="$1" _pname="$2" _after _last
            _after="$(jq '.sessions | length' "$(task_file "$repo" "$id")" 2>/dev/null || echo 0)"
            if [ "${_after:-0}" -gt "${_before:-0}" ]; then
                _last="$(jq -r '.sessions[-1].phase // empty' "$(task_file "$repo" "$id")" 2>/dev/null)"
                [ "$_last" = "$_pname" ] && \
                    jq -r '.sessions[-1].session_id // empty' "$(task_file "$repo" "$id")" 2>/dev/null
            fi
        }

        if [ "$phase" = "scope-check" ]; then
            run_scope_check "$repo" "$id" "$wt" "$ticket" "$specs_dir" "$base" \
                || {
                    failed="$phase"
                    _ph_ended="$(ts)"
                    _ph_verdict="$(task_get "$repo" .scope_verdict "$id" 2>/dev/null)"
                    _ph_verdict="${_ph_verdict:-FAIL}"
                    _ph_log "$phase" "$_ph_verdict" "" "$_ph_started" "$_ph_ended"
                    break
                }
            _ph_ended="$(ts)"
            _ph_verdict="$(task_get "$repo" .scope_verdict "$id" 2>/dev/null)"
            _ph_verdict="${_ph_verdict:-PASS}"
        elif [ "$phase" = "verify" ]; then
            if ! run_verify "$repo" "$id" "$wt" "$ticket" "$specs_dir" "$base"; then
                failed="$phase"
                _ph_ended="$(ts)"
                _ph_verdict="$(task_get "$repo" .verify_verdict "$id" 2>/dev/null)"
                _ph_verdict="${_ph_verdict:-FAIL}"
                _ph_log "$phase" "$_ph_verdict" "" "$_ph_started" "$_ph_ended"
                break
            fi
            _ph_ended="$(ts)"
            _ph_verdict="$(task_get "$repo" .verify_verdict "$id" 2>/dev/null)"
            _ph_verdict="${_ph_verdict:-PASS}"
        else
            _ph_sc_before="$(jq '.sessions | length' "$(task_file "$repo" "$id")" 2>/dev/null || echo 0)"
            if ! run_phase "$repo" "$id" "$phase" "$wt" "$ticket"; then
                failed="$phase"
                _ph_ended="$(ts)"
                _ph_sid="$(_ph_sid_detect "$_ph_sc_before" "$phase")"
                _ph_log "$phase" "FAIL" "$_ph_sid" "$_ph_started" "$_ph_ended"
                break
            fi
            _ph_ended="$(ts)"
            _ph_sid="$(_ph_sid_detect "$_ph_sc_before" "$phase")"
            _ph_verdict="PASS"
        fi

        # GH-52: fail immediately if implement exited cleanly but changed no real file.
        if [ "$phase" = "implement" ]; then
            if [ -z "$(_branch_changes "$wt" "$base" "$specs_dir/$ticket")" ]; then
                local _e="phase 'implement' failed — it changed no file; see implement.json for why"
                task_set "$repo" "$id" --arg e "$_e" '.error = $e'
                set_status "$repo" "$id" failed
                _ph_log "$phase" "FAIL" "$_ph_sid" "$_ph_started" "$_ph_ended"
                archive_task "$repo" "$id"
                say "  ✗ $id — implement changed no file · worktree kept at $wt"
                [ -n "$issue_n" ] && tracker_release "$repo" "$issue_n" "$issue_kind" "aisdlc" "aborted: $_e"
                return 1
            fi
        fi

        # Append phase_log entry on PASS (or GAPS for scope-check).
        _ph_log "$phase" "$_ph_verdict" "$_ph_sid" "$_ph_started" "$_ph_ended"



        # After ship: parse PR URL, claim the PR, and release the issue lock.
        if [ "$phase" = "ship" ]; then
            ship_result="$(jq -r '.result // empty' "$dir/ship.json" 2>/dev/null || true)"
            ship_pr_num="$(printf '%s' "$ship_result" | grep -oE 'PR:[[:space:]]*#[0-9]+' | \
                          grep -oE '[0-9]+' | head -1)"
            if [ -n "$ship_pr_num" ]; then
                # Prefer the parenthesised URL; fall back to local#n for a path.
                ship_pr_paren="$(printf '%s' "$ship_result" | \
                    sed -n "s/.*PR:[[:space:]]*#${ship_pr_num}[[:space:]]*(\([^)]*\)).*/\1/p" | head -1)"
                if printf '%s' "$ship_pr_paren" | grep -qE '^https://'; then
                    ship_pr="$ship_pr_paren"
                else
                    ship_pr="local#${ship_pr_num}"
                fi
            else
                ship_pr="$(printf '%s' "$ship_result" | grep -oE 'https://[^ ]*/pull/[0-9]+' | head -1 || true)"
            fi
            [ -n "$ship_pr" ] && task_set "$repo" "$id" --arg u "$ship_pr" '.pr_url = $u'
            # Hand the lock over: the PR must be observably claimed before the issue is released.
            if [ -n "$issue_n" ] && [ -n "$ship_pr_num" ]; then
                if tracker_pr_claim "$repo" "$ship_pr_num" "$issue_kind" "$ticket"; then
                    tracker_release "$repo" "$issue_n" "$issue_kind" "aisdlc" \
                        "handed off to PR #${ship_pr_num}"
                    pr_claimed=1
                else
                    printf '[%s] could not claim PR #%s — issue lock kept\n' "$(ts)" "$ship_pr_num" >> "$log"
                fi
            fi
        fi
        if [ "$phase" = "review" ]; then
            review_ran=1
        fi
    done <<< "$phase_list"

    if [ -n "$failed" ]; then
        local err hint=""
        [ -f "$wt/$specs_dir/$ticket/BLOCKED.md" ] && hint=" (BLOCKED.md written)"
        [ "$failed" = "scope-check" ]              && hint=" (see scope-report.md)"
        [ "$failed" = "verify" ] && hint=" — see verify-report.md: $(task_get "$repo" .verify_failures "$id")"
        if [ "$failed" = "review" ]; then
            err="review blockers remain"
        else
            err="phase '$failed' failed${hint}"
        fi
        task_set "$repo" "$id" --arg e "$err" '.error = $e'
        set_status "$repo" "$id" failed
        archive_task "$repo" "$id"
        say "  ✗ $id — $failed failed${hint} · worktree kept at $wt"
        say "    aisdlc logs $id"
        # Release whichever lock this run holds: the PR after a verified hand-off, else the issue.
        if [ -n "$issue_n" ]; then
            if [ "$pr_claimed" = 1 ]; then
                if [ "$failed" = "review" ]; then
                    tracker_pr_release "$repo" "$ship_pr_num" "$issue_kind" "CHANGES_REQUESTED"
                else
                    tracker_pr_release "$repo" "$ship_pr_num" "$issue_kind" "aborted: $err"
                fi
            else
                tracker_release "$repo" "$issue_n" "$issue_kind" "aisdlc" "aborted: $err"
            fi
        fi
        return 1
    fi

    # Collect the artifacts a human will want, then release the worktree.
    [ -f "$wt/$specs_dir/$ticket/qa-report.md" ]    && cp "$wt/$specs_dir/$ticket/qa-report.md"    "$dir/"
    [ -f "$wt/$specs_dir/$ticket/scope-report.md" ] && cp "$wt/$specs_dir/$ticket/scope-report.md" "$dir/"
    [ -f "$wt/$specs_dir/$ticket/verify-report.md" ] && cp "$wt/$specs_dir/$ticket/verify-report.md" "$dir/"
    [ -f "$wt/$specs_dir/$ticket/pr-body.md" ]      && cp "$wt/$specs_dir/$ticket/pr-body.md"      "$dir/"
    git -C "$wt" diff "$base"...HEAD > "$dir/changes.diff" 2>/dev/null || true

    # Fallback pr_url extraction for github provider (https URL in git log or ship.log).
    local pr_url
    pr_url="$(task_get "$repo" .pr_url "$id")"
    if [ -z "$pr_url" ]; then
        pr_url="$(git -C "$wt" log -1 --pretty=%B 2>/dev/null | grep -oE 'https://[^ ]*/pull/[0-9]+' | head -1 || true)"
        [ -z "$pr_url" ] && pr_url="$(grep -ohE 'https://[^ )]*/pull/[0-9]+' "$dir"/ship.log 2>/dev/null | head -1 || true)"
        [ -n "$pr_url" ] && task_set "$repo" "$id" --arg u "$pr_url" '.pr_url = $u'
    fi

    # Release whichever lock is held. The verdict is recorded only when the review phase ran.
    if [ -n "$issue_n" ]; then
        if [ "$pr_claimed" = 1 ]; then
            if [ "$review_ran" = 1 ]; then
                tracker_pr_release "$repo" "$ship_pr_num" "$issue_kind" "APPROVED"
            else
                tracker_pr_release "$repo" "$ship_pr_num" "$issue_kind" "done (no review phase)"
            fi
        else
            tracker_release "$repo" "$issue_n" "$issue_kind" "aisdlc" "done"
        fi
    fi

    set_status "$repo" "$id" "done"
    local cost; cost="$(task_get "$repo" .cost_usd "$id")"
    archive_task "$repo" "$id"
    say "  ✓ $id — done (\$${cost:-?})${pr_url:+ · $pr_url}"

    if [ "$(task_get "$repo" .no_pr "$id")" = "true" ]; then
        say "    --no-pr: diff and QA report in $dir"
        git -C "$repo" worktree remove --force "$wt" >/dev/null 2>&1 || true
    else
        git -C "$repo" worktree remove --force "$wt" >/dev/null 2>&1 \
            || say "    note: worktree still at $wt (uncommitted changes)"
    fi
    return 0
}

# The distinct runtimes of the tasks still in the queue; a task from before --runtime is claude.
queued_runtimes() {
    local repo="$1" id rt
    while read -r id; do
        [ -n "$id" ] || continue
        rt="$(task_get "$repo" .runtime "$id")"
        printf '%s\n' "${rt:-claude}"
    done < "$(state_dir "$repo")/queue.jsonl" | sort -u
}

# Count open PRs labelled <label> for the run-admission cap.
# Prints the integer count on success. Prints an error detail + returns 1 when the count
# cannot be obtained (provider failure, invalid local state, unsupported tracker).
count_open_prs() {
    local repo="$1" label="$2" kind; kind="$(tracker_kind "$repo")"
    case "$kind" in
        local)
            local f="$repo/.aisdlc/tracker/prs.jsonl"
            [ -f "$f" ] || { printf '0'; return 0; }
            jq -rs --arg l "$label" \
                '[.[] | select(.state=="open" and ((.labels//[]) | index($l) != null))] | length' \
                "$f" 2>/dev/null || { printf 'cannot parse prs.jsonl'; return 1; }
            ;;
        github)
            local slug prs; slug="$(gh_repo_slug "$repo")"
            prs="$(gh api "repos/${slug}/pulls?state=open&per_page=100" --paginate 2>/dev/null)" \
                || { printf 'gh api failed'; return 1; }
            printf '%s' "$prs" | jq -rs --arg l "$label" \
                '[.[] | .[] | select(.labels | map(.name) | index($l) != null)] | length' \
                2>/dev/null || { printf 'cannot parse GitHub pulls'; return 1; }
            ;;
        *) printf 'unsupported tracker: %s' "$kind"; return 1 ;;
    esac
}

cmd_run() {
    local repo="." workers="" once=0 max_open_prs="" max_run_usd=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --repo)         repo="$2"; shift 2 ;;
            --workers)      workers="$2"; shift 2 ;;
            --once)         once=1; workers=1; shift ;;
            --max-open-prs) max_open_prs="$2"; shift 2 ;;
            --max-run-usd)  max_run_usd="$2";  shift 2 ;;
            -*)             die "unknown flag for run: $1" ;;
            *)              die "run takes no positional arguments" ;;
        esac
    done
    repo="$(resolve_repo "$repo")"
    init_state "$repo"
    # Resolve caps: CLI flag > config > env > builtin "" (disabled).
    max_open_prs="$(resolve_default "$repo" max_open_prs "$max_open_prs" "${AISDLC_MAX_OPEN_PRS:-}" "")"
    max_run_usd="$(resolve_default  "$repo" max_run_usd  "$max_run_usd"  "${AISDLC_MAX_RUN_USD:-}"  "")"
    [ "$max_open_prs" = "null" ] && max_open_prs=""
    [ "$max_run_usd"  = "null" ] && max_run_usd=""
    # UC-8: non-numeric cap value → exit non-zero before any task is popped.
    if [ -n "$max_open_prs" ]; then
        case "$max_open_prs" in
            *[!0-9]*) die "--max-open-prs must be a non-negative integer (got '${max_open_prs}')" ;;
        esac
    fi
    if [ -n "$max_run_usd" ]; then
        printf '%s' "$max_run_usd" | grep -qE '^[0-9]+(\.[0-9]+)?$' \
            || die "--max-run-usd must be a number (got '${max_run_usd}')"
    fi
    [ "$once" -eq 1 ] || workers="$(resolve_default "$repo" workers "$workers" "${AISDLC_WORKERS:-}" "$BUILTIN_WORKERS")"

    local pending
    pending="$(wc -l < "$(state_dir "$repo")/queue.jsonl" | tr -d ' ')"
    [ "${pending:-0}" -gt 0 ] || { say "queue is empty"; return 0; }

    # UC-5: all-subscription queues warn and ignore the spend cap.
    if [ -n "$max_run_usd" ]; then
        local _asub=1 _qi _qb
        while read -r _qi; do
            [ -n "$_qi" ] || continue
            _qb="$(task_get "$repo" .billing "$_qi" 2>/dev/null)"
            [ "$_qb" = "subscription" ] || { _asub=0; break; }
        done < "$(state_dir "$repo")/queue.jsonl"
        if [ "$_asub" -eq 1 ]; then
            say "aisdlc: warning: all queued tasks use subscription billing — spend cap cannot be enforced; --max-run-usd ignored"
            max_run_usd=""
        fi
    fi

    # Every runtime the queued tasks were added with must be installed, checked before any
    # task is popped: a missing CLI found mid-queue fails a task that was never attempted.
    local rt
    for rt in $(queued_runtimes "$repo"); do need "$rt"; done

    say "aisdlc $VERSION — $pending queued, $workers worker(s)$([ "$once" -eq 1 ] && echo ', single task')"

    # Shared files: run-wide spend accumulator + stop-reason record + admission lock.
    local _rsp _rsf _lbl _adm_lock
    _rsp="$(state_dir "$repo")/.run-spend.tmp"
    _rsf="$(state_dir "$repo")/last-run.json"
    _adm_lock="$(state_dir "$repo")/admission.lock"
    _lbl="$(resolve_default "$repo" label "" "${AISDLC_LABEL:-}" "$BUILTIN_LABEL")"
    # One run at a time: a second run would reset this run's spend and stop decision.
    local _run_fd _run_lock; _run_lock="$(state_dir "$repo")/run.lock"
    exec {_run_fd}>"$_run_lock"
    flock -n "$_run_fd" || { exec {_run_fd}>&-; die "another aisdlc run is already active for this repo"; }
    printf '0\n' > "$_rsp"; : > "${_rsp}.lock"; : > "$_adm_lock"
    # Clear any stop decision from a prior run so an uncapped run does not inherit it.
    rm -f "$_rsf"

    local -a pids=()
    trap 'say "interrupted — finishing current phases"; kill -TERM "${pids[@]}" 2>/dev/null; wait; exit 130' INT TERM

    for _ in $(seq 1 "$workers"); do
        (
            while :; do
                # Admission lock: serializes stop-check, cap-checks, and pop atomically.
                # Held from the first gate check through pop_task; released BEFORE execute_task
                # so other workers can proceed to their own admissions while this one executes.
                local _fd
                exec {_fd}>"$_adm_lock"
                flock "$_fd"

                # 1. Propagate any stop decision written by another worker this run.
                if [ -f "$_rsf" ] && jq -e '.stop_reason' "$_rsf" >/dev/null 2>&1; then
                    exec {_fd}>&-; break
                fi

                # 2. Cap checks — fail-closed; write stop record then release.
                if [ -n "$max_open_prs" ]; then
                    local _pc
                    if ! _pc="$(count_open_prs "$repo" "$_lbl")"; then
                        say "aisdlc: stopped: PR count unavailable — ${_pc}"
                        jq -cn --arg r "count-unavailable" --arg v "$_pc" \
                            '{stop_reason:$r,stop_value:$v,accumulated_spend:null}' > "$_rsf"
                        exec {_fd}>&-; exit 2
                    fi
                    if [ "$_pc" -ge "$max_open_prs" ]; then
                        say "aisdlc: stopped: ${_pc} open PR(s) — --max-open-prs ${max_open_prs} reached"
                        jq -cn --arg r "max-open-prs" --arg v "$max_open_prs" \
                            '{stop_reason:$r,stop_value:$v,accumulated_spend:null}' > "$_rsf"
                        exec {_fd}>&-; break
                    fi
                fi
                if [ -n "$max_run_usd" ]; then
                    local _acc; _acc="$(cat "$_rsp" 2>/dev/null)"; _acc="${_acc:-0}"
                    if jq -n --argjson a "$_acc" --argjson c "$max_run_usd" '$a >= $c' 2>/dev/null \
                            | grep -q true; then
                        say "aisdlc: stopped: run spend \$${_acc} — --max-run-usd ${max_run_usd} reached"
                        jq -cn --arg r "max-run-usd" --arg v "$max_run_usd" --arg s "$_acc" \
                            '{stop_reason:$r,stop_value:$v,accumulated_spend:$s}' > "$_rsf"
                        exec {_fd}>&-; break
                    fi
                fi

                # 3. Pop the next task (still holding admission lock for atomicity).
                local id _cost_pre
                id="$(pop_task "$repo")"
                exec {_fd}>&-   # release BEFORE execute — do not block sibling admissions
                [ -n "$id" ] || break

                # Snapshot cost before execution; delta = this-run cost only (handles retries).
                if [ -n "$max_run_usd" ]; then
                    _cost_pre="$(task_get "$repo" .cost_usd "$id" 2>/dev/null)"
                    [ "$_cost_pre" = "null" ] && _cost_pre="0"
                    [ -z "$_cost_pre" ]        && _cost_pre="0"
                fi

                execute_task "$repo" "$id" || true

                # Accumulate this run's cost delta; filter as positional arg prevents shell
                # expansion of $a/$b; atomic mv prevents truncation reads across workers.
                if [ -n "$max_run_usd" ]; then
                    local _cost_post; _cost_post="$(task_get "$repo" .cost_usd "$id")"
                    if [ -n "$_cost_post" ] && [ "$_cost_post" != "null" ]; then
                        local _delta
                        _delta="$(jq -n --argjson a "$_cost_post" --argjson b "${_cost_pre:-0}" \
                            '$a - $b' 2>/dev/null || echo 0)"
                        flock "${_rsp}.lock" bash -c '
                            p=$(cat "$1" 2>/dev/null); p=${p:-0}
                            jq -rn --argjson a "$p" --argjson b "$2" "$3" > "${1}.new" \
                                && mv "${1}.new" "$1"
                        ' _ "$_rsp" "$_delta" '$a+$b'
                    fi
                fi
                [ "$once" -eq 1 ] && break
            done
        ) &
        pids+=("$!")
    done
    wait

    say ""
    rm -f "$_rsp" "${_rsp}.lock" "$_adm_lock"
    exec {_run_fd}>&-
    local _stop_rc=0
    if [ -f "$_rsf" ]; then
        [ "$(jq -r '.stop_reason // empty' "$_rsf" 2>/dev/null)" = "count-unavailable" ] && _stop_rc=1
    fi
    cmd_status --repo "$repo"
    return "$_stop_rc"
}

# --------------------------------------------------------------------------- #
# reporting
# --------------------------------------------------------------------------- #

each_task() {
    local repo="$1" f
    for f in "$(state_dir "$repo")"/tasks/*/task.json; do
        [ -f "$f" ] || continue
        printf '%s\n' "$f"
    done
}

cmd_status() {
    local repo="."
    while [ $# -gt 0 ]; do
        case "$1" in --repo) repo="$2"; shift 2 ;; *) shift ;; esac
    done
    repo="$(resolve_repo "$repo")"
    [ -d "$(state_dir "$repo")" ] || { say "no queue in $repo"; return 0; }

    local queue_file
    queue_file="$(state_dir "$repo")/queue.jsonl"
    local queued=0
    [ -f "$queue_file" ] && queued="$(wc -l < "$queue_file" | tr -d ' ')"
    printf '%-34s %-9s %-6s %8s  %-5s  %s\n' TASK STATUS PHASES COST READY NOTE
    local f
    while read -r f; do
        [ -n "$f" ] || continue
        # Phases as initials (i·q·s) so the column stays aligned on a narrow terminal.
        jq -r '[.id, .status, (.phases | map(.[0:1]) | join("·")),
                (if .cost_usd == null then "n/a" else (.cost_usd|tostring) end),
                ((.readiness_score // "-") | tostring),
                (.pr_url // .error // "")] | @tsv' "$f" 2>/dev/null \
        | while IFS=$'\t' read -r id st ph cost ready note; do
            printf '%-34s %-9s %-6s %8s  %-5s  %s\n' "$id" "$st" "$ph" "\$$cost" "$ready" "${note:0:56}"
          done
    done < <(each_task "$repo")

    local total
    total="$(each_task "$repo" | xargs -r jq -rs \
        '[.[] | .cost_usd | select(. != null)] as $api |
         if ($api | length) == 0 then "n/a"
         else (($api | add // 0) * 100 | round / 100 | tostring) end' \
        2>/dev/null || echo 0)"
    printf '\n%s still queued · total spend $%s\n' "${queued:-0}" "$total"
    local _rsf; _rsf="$(state_dir "$repo")/last-run.json"
    if [ -f "$_rsf" ]; then
        local _sr _sv _sp
        _sr="$(jq -r '.stop_reason // empty' "$_rsf" 2>/dev/null)"
        _sv="$(jq -r '.stop_value  // empty' "$_rsf" 2>/dev/null)"
        _sp="$(jq -r '.accumulated_spend // empty' "$_rsf" 2>/dev/null)"
        case "$_sr" in
            max-open-prs)     say "last run stopped: open PRs ≥ --max-open-prs ${_sv}" ;;
            max-run-usd)      say "last run stopped: spend \$${_sp} ≥ --max-run-usd ${_sv}" ;;
            count-unavailable) say "last run stopped: PR count unavailable — ${_sv}" ;;
        esac
    fi
}

cmd_inbox() {
    local repo="."
    while [ $# -gt 0 ]; do
        case "$1" in --repo) repo="$2"; shift 2 ;; *) shift ;; esac
    done
    repo="$(resolve_repo "$repo")"

    local label
    label="$(resolve_default "$repo" label "" "${AISDLC_LABEL:-}" "$BUILTIN_LABEL")"

    say "== Ready for review =="
    printf '%-6s %-40s %-20s %-16s %s\n' '#' 'title' 'Verdict' 'label' 'url'

    local kind; kind="$(tracker_kind "$repo")"
    case "$kind" in
        local)
            local prs_file="$repo/.aisdlc/tracker/prs.jsonl"
            if [ -f "$prs_file" ]; then
                jq -r 'select(.state=="open") | [
                    ("#" + (.number|tostring)),
                    (.title // ""),
                    (.verdict // "—"),
                    ((.labels // []) | map(select(. != "ai-sdlc" and . != "in-progress")) | first // "—"),
                    (.url // "—")
                ] | @tsv' "$prs_file" 2>/dev/null |
                while IFS=$'\t' read -r num title verdict lbl url; do
                    printf '%-6s %-40s %-20s %-16s %s\n' \
                        "$num" "${title:0:40}" "$verdict" "$lbl" "$url"
                done
            else
                say "  (no prs.jsonl yet — run aisdlc add and ship a task first)"
            fi
            ;;
        github)
            if command -v gh >/dev/null 2>&1; then
                gh pr list \
                    --repo "$(gh_repo_slug "$repo")" \
                    --label "$label" --state open \
                    --json number,title,url,labels,body \
                    --jq '.[] | [
                        ("#" + (.number|tostring)),
                        .title,
                        ((.body // "") | split("\n") | map(select(startswith("**QA verdict: "))) | first // "" |
                         if . == "" then "—" else ltrimstr("**QA verdict: ") | split("**") | first end),
                        ((.labels // []) | map(.name) | map(select(. != "ai-sdlc" and . != "in-progress")) | first // "—"),
                        .url
                    ] | @tsv' 2>/dev/null |
                while IFS=$'\t' read -r num title verdict lbl url; do
                    printf '%-6s %-40s %-20s %-16s %s\n' \
                        "$num" "${title:0:40}" "$verdict" "$lbl" "$url"
                done
            else
                say "  (gh not installed — see the per-task artifacts below)"
            fi
            ;;
        *)
            say "  (unknown tracker kind: $kind — check .claude/sdlc.md)"
            ;;
    esac

    say ""
    say "== Needs you =="
    local f found=0
    while read -r f; do
        [ -n "$f" ] || continue
        local st; st="$(jq -r '.status' "$f")"
        case "$st" in
            failed|refused)
                found=1
                jq -r '"  \(.status | ascii_upcase)  \(.id)\n    \(.error // "no reason recorded")\n    logs: aisdlc logs \(.id)"' "$f"
                ;;
        esac
    done < <(each_task "$repo")
    [ "$found" -eq 0 ] && say "  nothing blocked"
}

cmd_logs() {
    local repo="." id=""
    while [ $# -gt 0 ]; do
        case "$1" in --repo) repo="$2"; shift 2 ;; -*) shift ;; *) id="$1"; shift ;; esac
    done
    [ -n "$id" ] || die "usage: aisdlc logs <id>"
    repo="$(resolve_repo "$repo")"
    local dir; dir="$(task_dir "$repo" "$id")"
    [ -d "$dir" ] || die "no such task: $id"

    jq . "$dir/task.json"
    local f
    for f in "$dir"/run.log "$dir"/triage.log "$dir"/root-cause.log "$dir"/implement.log \
              "$dir"/qa.log "$dir"/scope-check.log "$dir"/ship.log "$dir"/review.log; do
        [ -f "$f" ] || continue
        printf '\n===== %s =====\n' "$(basename "$f")"
        cat "$f"
    done
    [ -f "$dir/qa-report.md" ]    && { printf '\n===== qa-report.md =====\n';    cat "$dir/qa-report.md"; }
    [ -f "$dir/scope-report.md" ] && { printf '\n===== scope-report.md =====\n'; cat "$dir/scope-report.md"; }
    return 0
}

cmd_retry() {
    local repo="." id=""
    while [ $# -gt 0 ]; do
        case "$1" in --repo) repo="$2"; shift 2 ;; -*) shift ;; *) id="$1"; shift ;; esac
    done
    [ -n "$id" ] || die "usage: aisdlc retry <id>"
    repo="$(resolve_repo "$repo")"
    local dir; dir="$(task_dir "$repo" "$id")"
    [ -d "$dir" ] || die "no such task: $id"

    # A retry starts from a clean worktree: the old one is evidence that has been read.
    local wt; wt="$(task_get "$repo" .worktree "$id")"
    if [ -n "$wt" ] && [ -d "$wt" ]; then
        git -C "$repo" worktree remove --force "$wt" >/dev/null 2>&1 \
            || die "could not remove $wt — inspect it, then remove it manually"
    fi
    local branch; branch="$(task_get "$repo" .branch "$id")"
    [ -n "$branch" ] && git -C "$repo" branch -D "$branch" >/dev/null 2>&1

    # An --issue task released its lock when it failed; a retry must hold one again before it
    # is queued, or two machines can build the same issue.
    if [ "$(task_get "$repo" .is_issue "$id")" = "true" ]; then
        local ticket issue_n kind claim
        ticket="$(task_get "$repo" .ticket "$id")"; issue_n="${ticket#GH-}"
        kind="$(tracker_kind "$repo")"
        claim="$(tracker_check_claim "$repo" "$issue_n" "$kind")"
        case "$claim" in
            free|stale:*|mine) ;;
            *) die "issue $issue_n is claimed by ${claim#other:} — not re-queued" ;;
        esac
        [ "$claim" = mine ] || tracker_claim "$repo" "$issue_n" "$kind" "aisdlc" \
            || die "could not re-claim issue $issue_n"
    fi

    set_status "$repo" "$id" queued
    task_set "$repo" "$id" '.error = null | .worktree = null | .branch = null'
    flock "$(state_dir "$repo")/queue.lock" \
        bash -c "printf '%s\n' \"$id\" >> \"$(state_dir "$repo")/queue.jsonl\""
    say "re-queued $id"
}

cmd_cancel() {
    local repo="." id=""
    while [ $# -gt 0 ]; do
        case "$1" in --repo) repo="$2"; shift 2 ;; -*) shift ;; *) id="$1"; shift ;; esac
    done
    [ -n "$id" ] || die "usage: aisdlc cancel <id>"
    repo="$(resolve_repo "$repo")"
    local dir; dir="$(state_dir "$repo")"
    [ -d "$(task_dir "$repo" "$id")" ] || die "no such task: $id"

    # A queued --issue task still holds the claim taken by `add`; give it back. A running one
    # releases its own lock when the phase loop exits.
    if [ "$(task_get "$repo" .is_issue "$id")" = "true" ] && [ "$(task_get "$repo" .status "$id")" = "queued" ]; then
        local ticket; ticket="$(task_get "$repo" .ticket "$id")"
        tracker_release "$repo" "${ticket#GH-}" "$(tracker_kind "$repo")" "aisdlc" "cancelled before start"
    fi

    flock "$dir/queue.lock" bash -c '
        grep -vxF "$2" "$1/queue.jsonl" > "$1/queue.jsonl.tmp" || true
        mv "$1/queue.jsonl.tmp" "$1/queue.jsonl"
    ' _ "$dir" "$id"
    set_status "$repo" "$id" cancelled
    archive_task "$repo" "$id"
    say "cancelled $id (a running phase finishes on its own)"
}

cmd_clean() {
    local repo="." all=0
    while [ $# -gt 0 ]; do
        case "$1" in --repo) repo="$2"; shift 2 ;; --all) all=1; shift ;; *) shift ;; esac
    done
    repo="$(resolve_repo "$repo")"

    local removed=0 f
    while read -r f; do
        [ -n "$f" ] || continue
        local st id; st="$(jq -r '.status' "$f")"; id="$(jq -r '.id' "$f")"
        if [ "$st" = "done" ] || [ "$st" = "cancelled" ] || { [ "$all" -eq 1 ] && [ "$st" != "running" ]; }; then
            local wt; wt="$(jq -r '.worktree // empty' "$f")"
            [ -n "$wt" ] && [ -d "$wt" ] && git -C "$repo" worktree remove --force "$wt" >/dev/null 2>&1
            rm -rf "$(dirname "$f")"
            removed=$((removed + 1))
        fi
    done < <(each_task "$repo")

    git -C "$repo" worktree prune
    say "removed $removed task record(s)$([ "$all" -eq 1 ] && echo ' (--all: including failed ones)')"
    say "kept: running tasks$([ "$all" -eq 0 ] && echo ', and failed ones — they are your evidence')"
}

# --------------------------------------------------------------------------- #
# archive — read and maintain the local task archive
# --------------------------------------------------------------------------- #

cmd_archive() {
    local subcmd="${1:-}" root
    root="${AISDLC_ARCHIVE:-${XDG_DATA_HOME:-$HOME/.local/share}/aisdlc/archive}"
    if [ "${AISDLC_ARCHIVE:-}" = "off" ]; then
        printf 'archive disabled\n' >&2; return 0
    fi
    case "$subcmd" in
        ls)   shift; _arc_ls   "$root" "$@" ;;
        show) shift; _arc_show "$root" "$@" ;;
        grep) shift; _arc_grep "$root" "$@" ;;
        prune) shift; _arc_prune "$root" "$@" ;;
        *) printf 'usage: aisdlc archive <ls|show|grep|prune> [flags]\n' >&2; return 1 ;;
    esac
}

_arc_ls() {
    local root="$1"; shift
    local filter_repo="" filter_status="" filter_since=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --repo)   filter_repo="$2";   shift 2 ;;
            --status) filter_status="$2"; shift 2 ;;
            --since)  filter_since="$2";  shift 2 ;;
            *) shift ;;
        esac
    done
    local idx="${root}/index.jsonl"
    [ -f "$idx" ] || { printf 'no archive index at %s\n' "$idx" >&2; return 0; }
    jq -r --arg repo "$filter_repo" --arg st "$filter_status" --arg since "$filter_since" '
        select(
            ($repo   == "" or .repo_slug == $repo) and
            ($st     == "" or .status    == $st)   and
            ($since  == "" or .archived_at >= $since)
        )
        | [.id, .ticket, .repo_slug, .status, (.cost_usd // "n/a" | tostring), .archived_at]
        | @tsv' "$idx"
}

_arc_show() {
    local root="$1" id="${2:-}"
    [ -n "$id" ] || { printf 'usage: aisdlc archive show <id>\n' >&2; return 1; }
    local idx="${root}/index.jsonl"
    [ -f "$idx" ] || { printf 'not found: %s\n' "$id" >&2; return 1; }
    # Match exact id or id.<n> prefix
    local base_id="${id%%.*}"
    local found=0
    while IFS= read -r line; do
        local entry_id entry_path
        entry_id="$(printf '%s' "$line" | jq -r '.id // empty' 2>/dev/null)"
        [ -n "$entry_id" ] || continue
        # Match when queried id equals entry id (first attempt) or the full path arc_name matches
        local entry_arc
        entry_arc="$(printf '%s' "$line" | jq -r '.path // empty' 2>/dev/null | xargs -I{} basename {} 2>/dev/null)"
        # Bare id shows every attempt; <id>.<n> shows exactly that attempt.
        if [ "$entry_id" != "$base_id" ]; then
            continue
        elif [ "$id" != "$base_id" ]; then
            [ "$entry_arc" = "$id" ] || continue
        elif ! printf '%s' "$entry_arc" | grep -qE "^${base_id}(\.[0-9]+)?$"; then
            continue
        fi
        entry_path="$(printf '%s' "$line" | jq -r '.path // empty' 2>/dev/null)"
        if [ -f "${entry_path}/manifest.json" ]; then
            printf '=== %s ===\n' "$entry_arc"
            jq . "${entry_path}/manifest.json"
            found=1
        fi
    done < "$idx"
    if [ "$found" -eq 0 ]; then
        printf 'not found: %s\n' "$id" >&2; return 1
    fi
    return 0
}

_arc_grep() {
    local root="$1" pattern="${2:-}"
    [ -n "$pattern" ] || { printf 'usage: aisdlc archive grep <pattern>\n' >&2; return 1; }
    local idx="${root}/index.jsonl"
    local seen_paths=""
    while IFS= read -r line; do
        local entry_path entry_arc
        entry_path="$(printf '%s' "$line" | jq -r '.path // empty' 2>/dev/null)"
        [ -d "$entry_path" ] || continue
        # Retry attempts share one path; grep each archived directory once.
        case "|${seen_paths}|" in *"|$entry_path|"*) continue ;; esac
        seen_paths="${seen_paths}|$entry_path"
        entry_arc="$(basename "$entry_path")"
        local parent_slug parent_ym
        parent_ym="$(basename "$(dirname "$entry_path")")"
        parent_slug="$(basename "$(dirname "$(dirname "$entry_path")")")"
        local arc_prefix="${parent_slug}/${parent_ym}/${entry_arc}"
        # Search phases/*.log, phases/*.json, sessions/*.jsonl only — never manifest/task/spec
        local f rel
        for f in "$entry_path/phases"/*.log "$entry_path/phases"/*.json \
                 "$entry_path/sessions"/*.jsonl; do
            [ -f "$f" ] || continue
            rel="${arc_prefix}/$(basename "$(dirname "$f")")/$(basename "$f")"
            grep -E "$pattern" "$f" 2>/dev/null | while IFS= read -r match; do
                printf '%s:%s\n' "$rel" "$match"
            done
        done
    done < "$idx"
    return 0
}

_arc_prune() {
    local root="$1"; shift
    local older_than_days=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --older-than) older_than_days="${2%d}"; shift 2 ;;
            *) shift ;;
        esac
    done
    [ -n "$older_than_days" ] || { printf 'usage: aisdlc archive prune --older-than <N>d\n' >&2; return 1; }
    case "$older_than_days" in *[!0-9]*) printf 'aisdlc: --older-than must be <N>d with N a non-negative integer\n' >&2; return 1 ;; esac
    local idx="${root}/index.jsonl"
    [ -f "$idx" ] || return 0

    local canonical_root
    canonical_root="$(realpath -m "$root" 2>/dev/null || printf '%s' "$root")"
    local cutoff_ts now_ts
    now_ts="$(date -u +%s 2>/dev/null || printf '0')"
    cutoff_ts=$((now_ts - older_than_days * 86400))
    local cutoff_iso
    cutoff_iso="$(date -u -d "@${cutoff_ts}" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || \
                  date -u -r "${cutoff_ts}" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || \
                  printf '1970-01-01T00:00:00Z')"

    flock "${root}/index.lock" bash -s "$idx" "$canonical_root" "$cutoff_iso" \
        <<'PRUNE_SCRIPT'
idx="$1"; canonical_root="$2"; cutoff_iso="$3"
[ -f "$idx" ] || exit 0

retained_file="$(mktemp)" || exit 1
tmp_idx="${idx}.prune.$$"
trap 'rm -f "$retained_file" "$tmp_idx"' EXIT
: > "$tmp_idx" || exit 1

# First pass: collect canonical paths of retained entries (younger, out-of-root, or symlink-outside).
while IFS= read -r line; do
    [ -n "$line" ] || continue
    archived_at="$(printf '%s' "$line" | jq -r '.archived_at // empty' 2>/dev/null)"
    path_val="$(printf '%s' "$line" | jq -r '.path // empty' 2>/dev/null)"
    canonical_path="$(realpath -m "$path_val" 2>/dev/null || printf '%s' "$path_val")"
    is_desc=0; case "$canonical_path/" in "${canonical_root}/"*) is_desc=1 ;; esac
    [ "$canonical_path" = "$canonical_root" ] && is_desc=0
    if [ "$is_desc" -eq 0 ]; then
        printf '%s\n' "$canonical_path" >> "$retained_file"
    elif ! [[ "$archived_at" < "$cutoff_iso" ]]; then
        printf '%s\n' "$canonical_path" >> "$retained_file"
    fi
done < "$idx"

# Second pass: prune prunable entries; retain the rest.
while IFS= read -r line; do
    [ -n "$line" ] || continue
    archived_at="$(printf '%s' "$line" | jq -r '.archived_at // empty' 2>/dev/null)"
    path_val="$(printf '%s' "$line" | jq -r '.path // empty' 2>/dev/null)"
    canonical_path="$(realpath -m "$path_val" 2>/dev/null || printf '%s' "$path_val")"
    is_desc=0; case "$canonical_path/" in "${canonical_root}/"*) is_desc=1 ;; esac
    [ "$canonical_path" = "$canonical_root" ] && is_desc=0
    if [ "$is_desc" -eq 0 ]; then
        printf '[prune] skipping %s: path not strict descendant of archive root\n' \
            "$canonical_path" >&2
        printf '%s\n' "$line" >> "$tmp_idx"
    elif [[ "$archived_at" < "$cutoff_iso" ]]; then
        if grep -qxF "$canonical_path" "$retained_file" 2>/dev/null; then
            printf '[prune] skipping %s: shared path with retained entry\n' \
                "$canonical_path" >&2
            printf '%s\n' "$line" >> "$tmp_idx"
        elif ! rm -rf -- "$canonical_path"; then
            printf '[prune] keeping %s: delete failed\n' "$canonical_path" >&2
            printf '%s\n' "$line" >> "$tmp_idx"
        fi
    else
        printf '%s\n' "$line" >> "$tmp_idx"
    fi
done < "$idx"

mv "$tmp_idx" "$idx" || exit 1
trap - EXIT; rm -f "$retained_file"
PRUNE_SCRIPT
}


# The published version, read from the marketplace manifest on this plugin's own upstream.
# Network is optional everywhere in this tool: no curl, no route, a moved manifest or a fork
# that is not on GitHub all mean "unknown" — a version check is never worth failing a run over.
upstream_version() {
    local repo_url slug branch raw v
    repo_url="$(manifest_field repository)"
    case "$repo_url" in
        https://github.com/*) slug="${repo_url#https://github.com/}" ;;
        git@github.com:*)     slug="${repo_url#git@github.com:}" ;;
        *) return 1 ;;
    esac
    slug="${slug%.git}"
    command -v curl >/dev/null 2>&1 || return 1

    for branch in main master; do
        raw="$(curl -fsSL --max-time "${AISDLC_NET_TIMEOUT:-5}" \
            "https://raw.githubusercontent.com/${slug}/${branch}/.claude-plugin/marketplace.json" 2>/dev/null)" \
            || continue
        v="$(printf '%s' "$raw" | jq -r --arg n "$PLUGIN_NAME" \
            'first(.plugins[]? | select(.name == $n) | .version) // empty' 2>/dev/null)"
        [ -n "$v" ] && { printf '%s' "$v"; return 0; }
    done
    return 1
}

cmd_version() {
    local check=0
    while [ $# -gt 0 ]; do case "$1" in --check|--check-upstream) check=1; shift ;; *) shift ;; esac; done
    say "aisdlc $VERSION"
    [ "$check" -eq 1 ] || return 0

    local latest
    latest="$(upstream_version)" || {
        say "upstream: unreachable — offline, no curl, or this fork is not on GitHub"
        return 0
    }
    if [ "$latest" = "$VERSION" ]; then
        say "upstream: $latest — current"
    elif [ "$(printf '%s\n%s\n' "$VERSION" "$latest" | sort -V | tail -1)" = "$VERSION" ]; then
        say "upstream: $latest — this checkout is ahead of the published version"
    else
        say "upstream: $latest — update available"
        say "  Claude Code  /plugin update $PLUGIN_NAME@aisdlc"
        say "  omp          omp plugin upgrade $PLUGIN_NAME@aisdlc"
        say "  Codex        codex plugin marketplace upgrade"
        say "  then, in every repository that ran /$PLUGIN_NAME:init:  /$PLUGIN_NAME:update"
    fi
}

cmd_help() {
    cat <<USAGE
aisdlc $VERSION — fire-and-forget queue for the AI SDLC pipeline

  aisdlc add <TICKET> [flags]   queue an approved spec
      --repo <path>     target repository (default: .)
      --model <name>    haiku | sonnet | opus (default: $BUILTIN_MODEL)
      --budget <usd>    hard spend cap per phase (default: $BUILTIN_BUDGET)
      --runtime <name>  auto | omp | claude (default: $BUILTIN_RUNTIME — omp if installed, else claude)
      --base <ref>      branch off this ref (default: origin/master, then origin/main)
      --phase <list>    subset of phases (default: all; see phases below)
      --issue <n>       queue issue #<n> as GH-<n>; claims it; phases: $ISSUE_PHASES
      --no-pr           stop after qa; strips ship and review; diff and QA report saved
      --plugin-dir      load the plugin from this checkout (repos without it installed)
      --force           queue despite a draft spec, open questions, or unmet depends-on (run-time depends-on gate is never bypassed)

  aisdlc pull [N] [flags]       claim the oldest open issue labelled \`$BUILTIN_PULL_LABEL\` (or N) and queue it
      --label <name>    the approval label to select on (default: $BUILTIN_PULL_LABEL)
      --dry-run         print the candidates, claim nothing
      plus any \`add\` flag; issues already built or claimed by anyone are skipped

  aisdlc loop [flags]           pull + run --once, repeated: the tracker as the work queue
      --interval <s>    seconds between ticks (default: $BUILTIN_LOOP_INTERVAL)
      --once            one tick, then exit — the shape a scheduler calls
      --dry-run         show what each tick would take
      plus any \`pull\` flag

  aisdlc run [flags]            execute the queue
      --workers <n>     concurrent tasks (default: $BUILTIN_WORKERS)
      --once            run a single task, then exit
      --max-open-prs <n> stop popping when open PRs with the run label ≥ N (null = unlimited)
      --max-run-usd <x>  stop popping when run-wide API spend ≥ x USD; all-subscription queues warn and ignore

  aisdlc status                 one line per task, with spend
  aisdlc inbox                  open PRs with #, title, Verdict, pipeline label, url
  aisdlc logs <id>              task state, phase logs, QA and scope reports
  aisdlc scope-check <id>       re-run the scope check for a task with an existing worktree
  aisdlc retry <id>             discard the worktree and re-queue
  aisdlc cancel <id>            drop a queued task
  aisdlc clean [--all]          remove finished task records and stale worktrees
  aisdlc archive ls|show|grep|prune  read and maintain the local archive (see Archive section)
  aisdlc version [--check]      installed version; --check asks GitHub for the published one

Phases: $ALL_PHASES (spec tickets); $ISSUE_PHASES (--issue tickets).
--no-pr removes ship and review from either list. scope-check always runs when present.

How it works: one git worktree per task, branched off <base>, then headless
\`claude -p\` calls (/$PLUGIN_NAME:implement → :qa → :ship → :review) with a fresh context each.
Review uses the PR number from ship's output (\`PR: #<n>\`). A CHANGES_REQUESTED verdict
keeps the worktree for inspection; APPROVED marks the task done.
Success leaves a draft PR labelled \`$BUILTIN_LABEL\`. Failure keeps the worktree so you
can read what happened.

The spec gate is not negotiable: status must be \`approved\` with no open questions.
Bugfix specs (kind: bugfix, approved-by: issue #<n>) are re-checked at run time — the
referenced issue must still carry the \`bug\` label, or the gate refuses.
For --issue tasks the gate runs after root-cause (triage writes the spec in-worktree).

Defaults resolve as: CLI flag > .aisdlc/config.json > environment > built-in. Write the
config with /$PLUGIN_NAME:init, or by hand:

  .aisdlc/config.json   {"model":"haiku","budget":3,"base":"origin/main",
                         "workers":4,"label":"$BUILTIN_LABEL","specs_dir":"$BUILTIN_SPECS_DIR"}

Optional: add archive_transcripts to suppress session file copies:

  "archive_transcripts": "off"


Optional: add model_roles to route cheap phases to a smaller model:

  "model_roles": {"smol":"haiku","default":"sonnet","slow":"opus"}

  Role        Phases
  smol        scope-check, ship
  default     implement, qa, triage
  slow        review, root-cause

  Resolved once at add time and snapshotted into task.json (.models). Absent model_roles →
  today's single-model behaviour, byte for byte. Values are opaque strings passed directly
  to claude --model; any name the host understands is valid.

Optional: add readiness_min to score spec quality before queuing:

  "readiness_min": 70

  Config key only — no CLI flag or environment variable. Absent or null disables scoring.
  When set, \`aisdlc add\` invokes the smol model with the spec and a rubric, expects JSON
  {"score":<0-100>,"gaps":[…≤5]}, and refuses if score < readiness_min. --force bypasses
  the check with a warning. On pass, task.json records readiness_score; \`aisdlc status\`
  shows it in the READY column.

Environment overrides: AISDLC_MODEL, AISDLC_BUDGET, AISDLC_BASE, AISDLC_WORKERS,
AISDLC_LABEL, AISDLC_SPECS_DIR, AISDLC_PULL_LABEL, AISDLC_LOOP_INTERVAL (config keys
pull_label and loop_interval), AISDLC_MAX_OPEN_PRS, AISDLC_MAX_RUN_USD (config keys
max_open_prs and max_run_usd; absent or null = disabled); AISDLC_ARCHIVE,
AISDLC_ARCHIVE_TRANSCRIPTS (archive opt-outs).

.aisdlc/settings.json is the permission set each headless phase runs under: editing files
and using git are allowed because that is the job, force pushes and secrets are denied,
and .claude/** is denied because a queued task has no business rewriting your agent
configuration. Written once, then yours. If a phase stalls asking to run this project's
test command, add it — e.g. "Bash(make:*)".
USAGE
}

# --------------------------------------------------------------------------- #

# Sourcing the script exposes the functions without running a command; the test suite does
# that to exercise the budget arithmetic directly.
if [ "${BASH_SOURCE[0]}" != "${0}" ]; then
    return 0
fi

need git; need jq; need flock

case "${1:-help}" in
    add)            shift; cmd_add "$@" ;;
    pull)           shift; cmd_pull "$@" ;;
    loop)           shift; cmd_loop "$@" ;;
    run)            shift; cmd_run "$@" ;;
    status|ls)      shift; cmd_status "$@" ;;
    inbox)          shift; cmd_inbox "$@" ;;
    logs|log)       shift; cmd_logs "$@" ;;
    scope-check)    shift; cmd_scope_check "$@" ;;
    retry)          shift; cmd_retry "$@" ;;
    cancel)         shift; cmd_cancel "$@" ;;
    archive)        shift; cmd_archive "$@" ;;
    clean)          shift; cmd_clean "$@" ;;
    version|--version) shift; cmd_version "$@" ;;
    help|--help|-h) cmd_help ;;
    *)              die "unknown command '$1' — try: aisdlc help" ;;
esac
